# Key NAMES only. Put the values in $HERMES_HOME/.env (never in a repo, never in config.yaml).

# The model endpoint's key, named by `model.key_env` in config.example.yaml. Leave unset for a local server with no auth.
KREW_MODEL_API_KEY=

# Optional, only for the Hermes tools you turn on (Hermes's own names; see its docs/reference/environment-variables.md):
# SEARXNG_URL=          # web search through your SearXNG (patch 220 paces it)
# FIRECRAWL_API_KEY=
# HF_TOKEN=             # only if the docs embedder model must be downloaded with a token

# The profile's OpenAI-compatible API server: the Wall (Crissa) talks to the profile through it (README: The Wall).
# krew-install offers it to the Wall by reference to this file; the key is never copied.
# API_SERVER_ENABLED=true
# API_SERVER_KEY=        # 16+ characters
# API_SERVER_PORT=8642   # on the default profile; a named profile is served at /p/<name>/v1 and needs only its own KEY
# API_SERVER_HOST=127.0.0.1

# krew paths and switches (optional; defaults shown in config/krew.example.yaml):
# KREW_HOME=
# KREW_CONFIG=
# KREW_HERMES_BIN=

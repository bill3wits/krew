# $KREW_HOME/engines.env: the two brains as the reference box runs them (engines/start-engine.sh reads this).
# Values are the reference box's (one 96 GB GPU shared by both engines; 2026-10-08). Copy, then change what differs.

# The checkpoint, one for both: Qwen3.8-27B in Unsloth's NVFP4 quantisation (Apache-2.0), ~18 GB of weights.
#   huggingface-cli download unsloth/Qwen3.8-27B-NVFP4 --local-dir "$HF_HOME/hub-local/Qwen3.8-27B-NVFP4-unsloth"
OPS_MODEL=$HF_HOME/hub-local/Qwen3.8-27B-NVFP4-unsloth
CREW_MODEL=$HF_HOME/hub-local/Qwen3.8-27B-NVFP4-unsloth

# ops: the talking profile and the decomposer. Priority scheduling, multi-token prediction on (3 draft tokens).
OPS_PORT=8000
OPS_UTIL=0.42
OPS_KV_BYTES=15032385536
OPS_MAX_LEN=131072
OPS_SPEC_TOKENS=3
OPS_ATTENTION_BACKEND=triton_attn
OPS_MAX_NUM_SEQS=8
OPS_VLLM_PREFIX=0.27
OPS_SLEEP_MODE=0

# crew: the board's workers. MTP off (measured: the draft tokens cost the crew more than they gave), the KV pin
# leaves room for the voice engine on the same GPU.
CREW_PORT=8005
CREW_UTIL=0.40
CREW_KV_BYTES=15554576384
CREW_MAX_LEN=102400
CREW_SPEC_TOKENS=0
CREW_ATTENTION_BACKEND=triton_attn
CREW_MAX_NUM_SEQS=8
CREW_VLLM_PREFIX=0.27
CREW_SLEEP_MODE=1

# Never 0: a KV pin of 0 lets vLLM take a VRAM fraction and the second engine cannot load.

NEVER_PARK = ("audio8-asr", "live-ear", "rail-stt", "rail-presence", "rail-camera")
# krew-keeper resurrects GPU lanes unless this hold lists them.
CREW_HOLD = _cfg_path("hold_file", "KREW_TRAIN_HOLD", Path("/tmp/krew-train-hold"))


def _hold_list() -> list[str]:
    if not CREW_HOLD.is_file():
        return []
    return [
        ln.strip()
        for ln in CREW_HOLD.read_text().splitlines()
        if ln.strip() and not ln.strip().startswith("#")
    ]


def _hold_cards() -> list[str]:
    """Card ids that own this hold, from `# card=<id>` lines.

    A hold with no card line is a HUMAN or training hold and nothing may
    release it automatically — that is the 2026-08-10 rail and it stays.
    """
    if not CREW_HOLD.is_file():
        return []
    out = []
    for ln in CREW_HOLD.read_text().splitlines():
        ln = ln.strip()
        if ln.startswith("#") and "card=" in ln:
            cid = ln.split("card=", 1)[1].strip()
            if cid and cid not in out:
                out.append(cid)
    return out


# PER-OWNER UNITS (2026-09-14, the owner + Grok: "Tie each unit to its owner … the file format is the law").
# 12:48:02 the hold sweep released the last card stamp and took every unit line with it: ops and Crissa's
# gateway came up in the middle of Render. Each unit names its owners on its own comment line:
#   # unit ops.service card=<id>     a card's claim, released with that card
#   # unit ops.service human         a claim with no card (the 2026-08-10 rail: never auto-released)
# Every other reader skips "#" lines or matches whole unit lines, and a card id still parses from the
# "card=<id>" at the end. A file written before this has no unit lines: each unit is owned by that file's
# cards, or by a human when it has none (the old meaning), until its next rewrite records it.
HUMAN_OWNER = "human"


def _hold_owners() -> dict[str, list[str]]:
    """unit -> owners (card ids and/or "human"), from the unit lines; legacy units filled in."""
    if not CREW_HOLD.is_file():
        return {}
    units = _hold_list()
    cards = [c for c in _hold_cards()]
    owners: dict[str, list[str]] = {}
    for ln in CREW_HOLD.read_text().splitlines():
        parts = ln.strip().split()
        if len(parts) == 4 and parts[0] == "#" and parts[1] == "unit":
            u, tag = parts[2], parts[3]
            who = tag[5:] if tag.startswith("card=") else (HUMAN_OWNER if tag == HUMAN_OWNER else "")
            if u in units and who and who not in owners.setdefault(u, []):
                owners[u].append(who)
    for u in units:
        if not owners.get(u):
            owners[u] = list(cards) if cards else [HUMAN_OWNER]
    return {u: owners[u] for u in units}


def _write_hold(cards: list[str], owners: dict[str, list[str]]) -> None:
    """Stamps, one owner line per claim, the unit lines; no units left = no hold."""
    units = [u for u, o in owners.items() if o]
    if not units:
        CREW_HOLD.unlink(missing_ok=True)
        return
    live = {o for u in units for o in owners[u] if o != HUMAN_OWNER}
    stamps = [c for c in cards if c in live] + sorted(live - set(cards))
    lines = ["# card=%s" % c for c in stamps]
    for u in units:
        lines.extend("# unit %s %s" % (u, HUMAN_OWNER if o == HUMAN_OWNER else "card=" + o) for o in owners[u])
    lines.extend(units)
    CREW_HOLD.parent.mkdir(parents=True, exist_ok=True)
    CREW_HOLD.write_text("\n".join(lines) + "\n")


OCCUPANCY_CARD = "occupancy"


# A HOLD NOBODY OWNS IS NEVER RELEASED (2026-09-21, the layer under
# comfy_busy — found by the kanban lane, landed here because this is the file).
#
# `# card=occupancy` is the stamp for a hand-run Render, and nothing releases a
# hold no card owns: only `release_stale_card_holds` frees a hold, and it asks
# whether the hold's CARD still earns it. The occupancy stamp names no card, so
# the answer is never "no".
#
# That is how t_3aefcb5c stranded the house for three hours on 09-21. The worker
# ran `krew-mode render turbo` DELIBERATELY without HERMES_KANBAN_TASK — its own
# 22:33 comment says "hand-run, no kanban-task env" — to get past the
# render-window membership gate. One bypass, two consequences: it dodged the
# window, and it made its own hold ownerless. When the worker then blew its
# iteration budget before step 5's `krew-mode normal`, nothing on the box could
# give the GPU back. The User cleared it by hand with Standard at 17:00:37.
#
# So: a worker that drops the env still leaves a card id behind, because it is
# standing in that card's workspace. `~/.hermes/kanban/boards/<board>/workspaces/
# t_<id>` is hermes's own layout, and the card release path then frees the hold
# when the card ends, exactly as if the env had been set. This does not restore
# the window gate — dodging that is a kanban-side question, and deliberately so:
# the fix here is only that the GPU comes back.
#
# KREW_OCCUPANCY_CARD_FROM_CWD=0 goes back to the bare occupancy stamp.
OCCUPANCY_CARD_FROM_CWD = os.environ.get(
    "KREW_OCCUPANCY_CARD_FROM_CWD", "1").strip().lower() not in ("0", "false", "no", "off")
_WORKSPACE_CARD = re.compile(r"/kanban/boards/[^/]+/workspaces/(t_[0-9a-f]{8})(?:/|$)")   # under any Hermes root


def _card_from_cwd() -> str:
    """The card whose workspace we are standing in, '' when we are not in one."""
    if not OCCUPANCY_CARD_FROM_CWD:
        return ""
    try:
        cwd = os.path.realpath(os.getcwd())
    except OSError:
        return ""     # a deleted cwd is not worth failing a mode switch over
    m = _WORKSPACE_CARD.search(cwd + "/")
    return m.group(1) if m else ""


def occupancy_card() -> str:
    """Kanban task id, or the CLI occupancy stamp so restore can clear the hold.

    Falls back to the workspace we are standing in before the ownerless stamp —
    see the note above.
    """
    env = (os.environ.get("HERMES_KANBAN_TASK") or "").strip()
    if env:
        return env
    from_cwd = _card_from_cwd()
    if from_cwd:
        print(f"krew-mode: no HERMES_KANBAN_TASK; stamping the hold with the "
              f"workspace's card {from_cwd} so it is not ownerless")
        return from_cwd
    return OCCUPANCY_CARD


def capture_pre_render_snapshot() -> dict:
    """First write only. Restore always reapplies this, not a leftover render flag."""
    st = read_state()
    prev = st.get("pre_render")
    if isinstance(prev, dict) and prev.get("mode"):
        return prev
    mode = read_mode()
    if mode == "render":
        mode = "normal"
    if mode not in MODES:
        mode = "normal"
    snap = {
        "mode": mode,
        "hold": _hold_list(),
        "hold_cards": _hold_cards(),
        "parked": list(st.get("parked") or []),
    }
    st["pre_render"] = snap
    write_state(st)
    return snap


def release_occupancy_hold() -> list[str]:
    """Drop the occupancy-owned hold so keeper can resurrect crew.

    Stamped `# card=occupancy` (CLI) or `# card=<kanban id>`: release_card.
    Unstamped leftover that is *only* Render units (crew + Crissa gateway) is
    the pre-stamp CLI shape — unlink it. A human hold that lists other
    units is left alone (2026-08-10 rail).
    """
    freed: list[str] = []
    mine = occupancy_card()
    for cid in dict.fromkeys([mine, OCCUPANCY_CARD]):
        if cid in _hold_cards():
            got = release_card(cid)
            if got:
                freed.extend(got)
    render_units = {OPS_UNIT, CREW_UNIT, *render_sleep_hold_units()}
    if CREW_HOLD.is_file() and not _hold_cards():
        have = _hold_list()
        extra = [u for u in have if u in render_units]
        other = [u for u in have if u not in render_units]
        if extra and not other:
            CREW_HOLD.unlink(missing_ok=True)
            freed.extend(extra)
        elif extra:
            release_units(*extra)
            freed.extend(extra)
    return freed


def hold_units(*units: str, card: str | None = None) -> None:
    """Keeper/janitor must not resurrect these. Merge, do not clobber.

    STAMP THE OWNER. 2026-09-04: a render smoke card parked crew and the crissa
    gateway, finished, and left the hold behind. Nothing removes this file —
    not the keeper, not the janitor — so both stayed down until a human
    deleted it (/tmp is tmpfs, so a reboot was the only other escape). A
    `# card=<id>` line lets card completion release exactly what that card
    took, and leaves an unstamped hold untouched.

    Comments must survive the rewrite: `_hold_list` strips them, so rebuilding
    the file from it alone would erase the stamp on the next park.
    """
    owners = _hold_owners()
    cards = _hold_cards()
    who = card or os.environ.get("HERMES_KANBAN_TASK") or ""
    for u in units:
        if u:
            claim = owners.setdefault(u, [])
            tag = who or HUMAN_OWNER
            if tag not in claim:
                claim.append(tag)
    if who and who not in cards:
        cards.append(who)
    _write_hold(cards, owners)


def release_units(*units: str) -> None:
    drop = {u for u in units if u}
    _write_hold(_hold_cards(), {u: o for u, o in _hold_owners().items() if u not in drop})


def release_card(card: str) -> list[str]:
    """Drop `card`'s stamp; unlink the hold when it was the last owner.

    Returns the units released (empty when another card still owns it, or
    when the hold is unstamped — a human/training hold is never touched).
    """
    card = (card or "").strip()
    if not card or not CREW_HOLD.is_file():
        return []
    cards = _hold_cards()
    if card not in cards:
        return []
    owners = _hold_owners()
    freed = [u for u, o in owners.items() if o == [card]]          # only the units this card alone held
    kept = {u: [x for x in o if x != card] for u, o in owners.items() if [x for x in o if x != card]}
    _write_hold([c for c in cards if c != card], kept)
    return freed


def crew_parked() -> bool:
    """Keeper hold still names crew — the engine is down even if the flag lies."""
    return CREW_UNIT in _hold_list()


def ops_parked() -> bool:
    """Keeper hold still names ops — the engine is down even if the flag lies."""
    return OPS_UNIT in _hold_list()


def lane_brain(mode: Optional[str] = None) -> str:
    """Which 27B the kanban lane may pin to. Never a parked engine.

    Returns ``ops``, ``crew``, or ``none``. ``none`` is the exclusive VRAM
    window (both 27Bs on the hold): do not dispatch, do not rewrite YAML
    onto a corpse.

    Canonical Render (ops held or about to be): crew. Emergency park-crew
    (hold names crew, not ops): ops. Neither held + mode render: crew —
    Render parks ops; do not keep both 27Bs next to Comfy. Neither held +
    not render: crew (pack default).
    """
    if mode is None:
        mode = read_mode()
    ops_down = ops_parked()
    crew_down = crew_parked()
    if ops_down and crew_down:
        return "none"
    if crew_down and not ops_down:
        return "ops"
    if ops_down and not crew_down:
        return "crew"
    return "crew"


def hold_crew_park() -> None:
    """Keep :8005 down (emergency park-crew leftover)."""
    hold_units(CREW_UNIT, card=occupancy_card())


def hold_ops_park() -> None:
    """Keep :8000 down while Render parks the composer."""
    hold_units(OPS_UNIT, card=occupancy_card())


def release_crew_hold() -> None:
    release_units(CREW_UNIT)


def release_ops_hold() -> None:
    release_units(OPS_UNIT)


def render_sleep_hold_units() -> tuple[str, ...]:
    """The FULL Render roster, always — this is the RELEASE and detection side.

    Deliberately NOT narrowed by CRISSA_CREW_IN_RENDER. A hold written by an earlier render, or
    by one entered with the switch off, still names her gateway; a release that no longer
    recognises the name would drop it into `other` in release_occupancy_hold, read the file as
    a human hold and leave it forever — a permanent latch of exactly the kind this session
    spent the night removing. Releasing a hold that is not there is a no-op, so the full list
    is safe from either direction (the same reasoning wake_render_rest already uses).
    """
    return tuple(f"{u}.service" for u in RENDER_SLEEP_GATEWAYS)


def hold_render_sleep() -> None:
    """Janitor/keeper must not resurrect Crissa while Lila/Vera iterate."""
    units = tuple(f"{u}.service" for u in render_sleep_gateways())
    if not units:                      # she rides crew: there is nothing to hold down
        return
    hold_units(*units, card=occupancy_card())


def release_render_sleep() -> None:
    release_units(*render_sleep_hold_units())


def render_sleep_hold_active() -> bool:
    have = set(_hold_list())
    return any(u in have for u in render_sleep_hold_units())


def profile_worker_pids(name: str, *, proc: Path = Path("/proc")) -> list[int]:
    """PIDs of `hermes -p <name> ...` processes that are NOT the gateway.

    2026-09-19: `pkill -f "hermes -p steward "` also matched the gateway itself
    (`hermes -p steward gateway run --replace`), so every Render entry SIGTERMed
    Steward's gateway; it exited 1 and Restart=on-failure brought it back — 12
    "failures" in one day, each one a Render entry (the mint's segment submits
    re-enter Render). Workers run `hermes -p <name> --cli ...`; a gateway is
    stopped with its unit, never pkill."""
    me = os.getpid()
    out: list[int] = []
    for d in proc.iterdir():
        if not d.name.isdigit() or int(d.name) == me:
            continue
        try:
            argv = (d / "cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        words = [a.decode(errors="replace") for a in argv if a]
        try:
            i = words.index("-p")
        except ValueError:
            continue
        if i + 1 >= len(words) or words[i + 1] != name or not any(w.endswith("hermes") for w in words[:i]):
            continue
        if "gateway" in words[i + 2:]:
            continue
        out.append(int(d.name))
    return out


def _kill_profile_workers(name: str) -> int:
    n = 0
    for pid in profile_worker_pids(name):
        try:
            os.kill(pid, signal.SIGTERM)
            n += 1
        except OSError:
            pass
    return n


def kill_render_sleep_workers() -> None:
    """Ada KillMode=process leaves `hermes -p` chats alive after gateway stop.

    Studio talks HTTP to ops/crew, so kanban Lila/Vera workers also pause —
    they would steal the iterate engines. Trailing space so `hermes -p ada`
    does not match a longer name.
    """
    for name in render_sleep_profiles():
        if _kill_profile_workers(name):
            print(f"render sleep workers -p {name}")


def sleep_render_rest() -> None:
    """Sleep Crissa and Steward. Ada dispatches; Lila/Vera/Bash stay on crew."""
    hold_render_sleep()
    for name in render_sleep_gateways():
        print(f"render sleep {name}")
        stop_unit(name)
    if CRISSA_CREW_IN_RENDER:
        print("render: crissa stays up on crew :8005 (catchall) — not slept")
    kill_render_sleep_workers()


def sleep_off_rest() -> None:
    """All OS Off: the whole swarm, Ada and the render lane included.

    Deliberately NOT sleep_render_rest(). Off parks every brain, so nothing
    is left for a worker to talk to and leaving one running is just a process
    burning a seat against a dead engine.
    """
    hold_units(*(f"{u}.service" for u in OFF_SLEEP_GATEWAYS))
    for name in OFF_SLEEP_GATEWAYS:
        print(f"off sleep {name}")
        stop_unit(name)
    for name in OFF_SLEEP_PROFILES:
        if _kill_profile_workers(name):
            print(f"off sleep workers -p {name}")


def wake_render_rest() -> None:
    """Every slept gateway back, after crew :8005 serves (else Restart loops).

    Wakes the union of the Render and Off rosters, not just Render's. Render
    only sleeps Crissa now, but Off still stops Ada — and leaving Off comes
    through here, so waking Render's list alone would leave the dispatcher
    held down with no one to notice. Starting a running unit and releasing an
    absent hold are both no-ops, so the union is safe from either direction.
    """
    release_render_sleep()
    release_units(*(f"{u}.service" for u in OFF_SLEEP_GATEWAYS))
    seen: set = set()
    for name in RENDER_SLEEP_GATEWAYS + OFF_SLEEP_GATEWAYS:
        if name in seen:
            continue
        seen.add(name)
        print(f"wake {name}")
        try:
            start_unit(name)
        except RuntimeError as e:
            print(f"wake {name}: {e}", file=sys.stderr)


def keep_render_ops_down() -> None:
    """Ops (composer) stays off the card. systemd stop — no sleep-mode on ops.

    Never standing sleep-mode on ops (CuMem IMA 2026-08-21). A parked-but-
    listening ops is the 2026-09-05 stall shape for fallback_model.
    Leave-Render is a cold ops boot (~2 min).
    """
    hold_ops_park()
    if http_ok(f"{OPS_URL}/v1/models"):
        print("render — :8000 systemd stop; lane stays crew :8005")
        stop_unit("ops")
        return
    print("render — :8000 already down; lane stays crew :8005")


def keep_render_crew_down() -> None:
    """Emergency leftover: crew off the card. Prefer L1; do not kill a sleeper.

    Canonical Render does not call this. Unconditional systemd stop after a
    successful `/sleep` was the RAM-wake miss.
    """
    hold_crew_park()
    subprocess.run(
        ["docker", "rm", "-f", "crew", "muse-glimmer"],
        capture_output=True,
        timeout=60,
    )
    if crew_is_sleeping():
        print("render — :8005 L1-sleeping (RAM); emergency lane on ops :8000")
        return
    if sleep_available(CREW_URL) and http_ok(f"{CREW_URL}/v1/models"):
        how = park_unit("crew")
        print(f"render — :8005 {how}; emergency lane on ops :8000")
        return
    if http_ok(f"{CREW_URL}/v1/models"):
        print("render — :8005 has no /sleep; systemd stop")
        stop_unit("crew")
        return
    print("render — :8005 already down; emergency lane on ops :8000")


def hold_beast_park() -> None:
    """Park ops only. Cosy TTS + Audio8 STT stay. crew.service is Unsloth 27B.

    Occupancy SoT is ~/.hermes/krew-gpu-mode=beast. /run/hermes/beast-hold is
    the systemd pin (ConditionPathExists on ops) so a gateway Wants=ops cannot
    start ops onto Beast Unsloth. Cosy is not on this hold.
    """
    release_units(CREW_UNIT, VOICE_UNIT)
    hold_units(OPS_UNIT)
    BEAST_HOLD.parent.mkdir(parents=True, exist_ok=True)
    BEAST_HOLD.write_text("beast\n")
    _clear_legacy_beast_dropins()


def release_beast_park() -> None:
    release_units(OPS_UNIT)
    BEAST_HOLD.unlink(missing_ok=True)
    _clear_legacy_beast_dropins()



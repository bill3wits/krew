    release_units(*OFF_HOLD_UNITS)


def off_park_active() -> bool:
    have = set(_hold_list())
    return OPS_UNIT in have and VOICE_UNIT in have and read_mode() == "off"


def _clear_legacy_beast_dropins() -> None:
    """Drop 2026-08-19 runtime Restart=no drop-ins if a previous Beast left them."""
    dirty = False
    for path in (OPS_BEAST_DROPIN, COSY_BEAST_DROPIN, CREW_BEAST_DROPIN):
        if path.is_file():
            path.unlink()
            dirty = True
    if dirty:
        _systemctl_user(["daemon-reload"])


def free_vram_gib(smi_text: Optional[str] = None) -> Optional[float]:
    """Parse nvidia-smi free MiB → GiB. None if unread."""
    if smi_text is None:
        try:
            smi_text = subprocess.check_output(
                [
                    "nvidia-smi",
                    "--query-gpu=memory.free",
                    "--format=csv,noheader,nounits",
                ],
                text=True,
                timeout=5,
            )
        except Exception:
            return None
    line = smi_text.strip().splitlines()[0].strip()
    return float(line) / 1024.0


def voice_is_on(raw: Optional[str] = None) -> bool:
    if raw is None:
        if not VOICE_LOCK.is_file():
            return False
        raw = VOICE_LOCK.read_text(encoding="utf-8")
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        return False
    return str(data.get("voice") or "").strip().lower() == "on"


def read_mode(text: Optional[str] = None) -> str:
    if text is None:
        if not MODE_FILE.is_file():
            return "normal"
        text = MODE_FILE.read_text(encoding="utf-8")
    first = text.strip().splitlines()[0].strip().lower() if text.strip() else ""
    if first in MODES:
        return first
    try:
        mode = str(json.loads(text).get("mode") or "").strip().lower()
    except json.JSONDecodeError:
        return "normal"
    return mode if mode in MODES else "normal"


def prod_locked(text: Optional[str] = None) -> bool:
    """Guest/prod hold. Occupancy frozen; keeper will not restart GPU lanes.

    First line of ~/.hermes/krew-prod-lock is on|off. Missing file = off.
    systemd Restart=on-failure still recovers a crash. Voice interrupt stays.
    """
    if text is None:
        if not PROD_LOCK_FILE.is_file():
            return False
        try:
            text = PROD_LOCK_FILE.read_text(encoding="utf-8")
        except OSError:
            return False
    first = (text or "").strip().splitlines()
    if not first:
        return False
    return first[0].strip().lower() in ("on", "1", "true", "lock", "prod")


def render_hold_reason() -> str:
    """the owner/Fable freeze. Presence of the file blocks entering Render."""
    if not RENDER_HOLD_FILE.is_file():
        return ""
    try:
        text = RENDER_HOLD_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        return "render hold"
    return text or "render hold"


def render_hold_blocks(cmd: str) -> bool:
    return cmd == "render" and bool(render_hold_reason())


# ── a kanban worker may not park ops in the User's day ───────────────────────────
# 2026-09-17 13:41: bash's worker on t_5df2faa8 ran `krew-mode render turbo` from
# its own terminal — ops stopped at 13:41, Crissa's gateway at 13:42, in the middle of
# the User's day. render-submit and krew-comfy already ask lib/render_window_gate;
# this was the last door. ONE rule, theirs: a worker renders only inside the User's
# off-hours and only in tonight's released batch, unless the card carries `render-now`.
# The User, Crissa, the panel and any hand run (no HERMES_KANBAN_TASK) are never gated.
# Kills: KREW_MODE_WORKER_WINDOW=0 here, KREW_RENDER_WINDOW=0 / ~/.hermes/render-window.off
# for every door at once.
# Every occupancy a kanban WORKER could use to rearrange the GPU in the User's day. `normal` is
# never gated: it is the way back, and a worker's card is what restores it.
WORKER_GATED_CMDS = ("render", "beast", "off")


def worker_gpu_refusal(cmd: str = "render", now=None) -> str:
    """Why this kanban worker may not switch occupancy to `cmd` right now (empty = go ahead).

    the owner 2026-09-17, two judgment calls:
    - FAIL CLOSED. If the gate cannot be read, a worker is refused with the reason — the same
      choice as the M&S ledger that morning (unreadable = no apply). The gate's whole job is
      keeping a worker from parking ops in the User's day; "could not check" must not mean yes.
      Only a worker is affected: a hand run, the panel and Crissa never reach this rule.
    - NOT ONLY RENDER. `beast` and `off` park the brains just as `render` does. For a worker they
      need `render-now` on the card from Crissa or the User — an explicit word, by day or by night;
      being in Ada's released RENDER batch is not enough for these two verbs."""
    if os.environ.get("KREW_MODE_WORKER_WINDOW", "1").strip().lower() in ("0", "false", "no", "off"):
        return ""
    worker = (os.environ.get("HERMES_KANBAN_TASK") or "").strip()
    try:
        sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
        import render_window_gate
        why = render_window_gate.refuse_reason(now=now)
        card = render_window_gate.worker_card()
        # Ada's released batch is a RENDER batch: it lets a card render tonight, it does not let
        # it park both brains for Beast or switch the house off. For those two verbs only an
        # explicit `render-now` from Crissa / the User passes (krew-rails-cd's note, 2026-09-17).
        if (not why and cmd != "render" and card and render_window_gate.enabled()
                and not render_window_gate.card_exempt(card)):
            why = (f"`{cmd}` is not a render: a released render card may render tonight, not change "
                   "occupancy to this. `render-now` from Crissa or the User on the card allows it.")
    except Exception as e:  # noqa: BLE001
        if not worker:
            return ""
        return (f"krew-mode {cmd}: the render-window gate could not be read ({type(e).__name__}: {e}) — a "
                f"kanban worker is refused rather than let through unchecked (card {worker}). "
                "Kill: KREW_MODE_WORKER_WINDOW=0.")
    if not why:
        return ""
    return (f"krew-mode {cmd}: a kanban worker may not park ops here. {why} "
            f"(card {card or '?'}; scripts/render-window.py batches renders tonight; `render-now` from "
            f"Crissa or the User exempts a card. Kill: KREW_MODE_WORKER_WINDOW=0.)")


def worker_render_refusal(now=None) -> str:
    """The render door (kept by name: krew-rails-cd's tests and callers use it)."""
    return worker_gpu_refusal("render", now=now)


def prod_lock_blocks(cmd: str, *, current: Optional[str] = None) -> bool:
    """True → refuse this occupancy command.

    status is always allowed. Repeating the live mode is a no-op (panel
    'Already Standard') — do not bounce engines.
    """
    if not prod_locked():
        return False
    if cmd == "status":
        return False
    if cmd in MODES and (current or read_mode()) == cmd:
        return False
    return True


def beast_park_active() -> bool:
    """Hold file or flag. Trapped Beast→Render is flag=render with hold still on disk."""
    return BEAST_HOLD.is_file() or read_mode() == "beast"


def write_pending(mode: str) -> None:
    """In-flight occupancy. Panel follows this while krew-mode (kanban or click) runs.

    Line 2 is the writer PID so a SIGKILL leftover cannot stick the switcher.
    """
    if mode not in MODES:
        return
    PENDING_FILE.parent.mkdir(parents=True, exist_ok=True)
    PENDING_FILE.write_text(f"{mode}\n{os.getpid()}\n", encoding="utf-8")


def clear_pending() -> None:
    PENDING_FILE.unlink(missing_ok=True)


def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def read_pending() -> str:
    try:
        lines = PENDING_FILE.read_text(encoding="utf-8").strip().splitlines()
    except OSError:
        return ""
    if not lines:
        return ""
    first = lines[0].strip().lower()
    if first not in MODES:
        return ""
    if len(lines) < 2:
        clear_pending()
        return ""
    try:
        pid = int(lines[1].strip())
    except ValueError:
        clear_pending()
        return ""
    if not _pid_alive(pid):
        clear_pending()
        return ""
    return first


@contextmanager
def occupancy_pending(mode: str) -> Iterator[None]:
    write_pending(mode)
    try:
        yield
    finally:
        clear_pending()


def _refuse_live_under_pytest() -> None:
    """Occupancy YAML writers. Tests that patch HERMES but not HOUSE invert live.

    Measured 2026-09-08 10:46: pytest-43 `test_apply_ops_occupancy_roundtrip`
    printed `ops pin → crew :8005  ~/.hermes/profiles/crissa/config.yaml` then
    failed the tmp-tree assert. Crissa spoke crew until pack restore.
    """
    if not os.environ.get("PYTEST_CURRENT_TEST"):
        return
    # krew: the passwd home's tree too (a scrubbed HOME, as kanban-env-clean gives a test run, hid the live tree the
    # writers actually target: HOUSE is the passwd home's ~/.hermes)
    lives = {(Path.home() / ".hermes").resolve(), (Path(_pwd.getpwuid(os.getuid()).pw_dir) / ".hermes").resolve()}
    try:
        root = HOUSE.resolve()
    except OSError:
        return
    if root in lives:
        raise RuntimeError(
            "krew-mode occupancy write under pytest targeted live ~/.hermes. "
            "monkeypatch HOUSE (not only HERMES)."
        )


def drop_presence_to_guest(reason: str) -> None:
    """Tell presence the occupancy flag moved (`secure_reauth`).

    Presence keeps sage when it is on. An ``occupancy:`` reason does not
    guest the room. Fail open. the owner 2026-09-08: a bounce must not remint
    AUTH without sage.
    """
    if os.environ.get("PYTEST_CURRENT_TEST"):
        print(f"presence secure_reauth skipped (pytest) ({reason})")
        return
    url = f"{PRESENCE_URL}/v1/visit_lamp"
    body = json.dumps({"op": "secure_reauth", "reason": reason}).encode()
    req = urllib.request.Request(
        url, data=body, method="POST",
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as r:
            r.read()
        print(f"presence secure_reauth ({reason})")
    except Exception as e:
        print(f"presence secure_reauth skipped: {type(e).__name__}: {e}"[:160])


# Did this process move the occupancy flag? 2026-09-13 00:30:56: a kanban
# worker's no-op `krew-mode normal` (flag already normal, nothing to wake)
# still bounced Ada's and Crissa's gateways through write_mode. A restart is
# owed only when the flag moved in this run or a YAML apply changed a file.
_FLAG_MOVED = False


def _apply_changed(result: object) -> bool:
    if not isinstance(result, str):
        return False
    return not (result.endswith("(already)") or result == "missing")


_TURBO_KREW_MOD = None


def _turbo_krew_mod():
    """Load scripts/turbo-krew.py once. Do not import krew-mode from it."""
    global _TURBO_KREW_MOD
    if _TURBO_KREW_MOD is not None:
        return _TURBO_KREW_MOD
    import importlib.util

    path = Path(__file__).resolve().parent / "turbo-krew.py"
    spec = importlib.util.spec_from_file_location("turbo_krew", path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"turbo krew missing: {path}")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    _TURBO_KREW_MOD = mod
    return mod


def apply_turbo_krew_occupancy(mode: str) -> None:
    """Pin Vera/Steward from TurboKrew lease × occupancy. Does not end the hour.

    Render / Beast / Off → crew (ops is parked). Standard + ops up → ops.
    Ada stays on crew. Call before apply_render_lane so snapshots see crew.
    """
    try:
        mod = _turbo_krew_mod()
        # Print the pin move so Render/Standard journal shows Vera/Steward
        # parking on crew (ops down) and returning to ops when Turbo still has hour.
        mod.apply_occupancy(mode, house=HOUSE, quiet=False)
    except Exception as e:
        print(f"turbo krew occupancy: {type(e).__name__}: {e}"[:160])


def ada_caps_for_mode(mode: str) -> Optional[tuple[int, int]]:
    """Standard with a live TurboKrew lease is (6, 3), not (3, 2) (2026-09-19).

    Leaving Render at 04:40 wrote the plain Standard caps while Turbo still had
    four hours: Ada came back 3/2 under a 6/3 lease. None = the mode's own row."""
    if mode != "normal":
        return None
    try:
        if _turbo_krew_mod().lease_live(HOUSE):
            return ADA_DISPATCH["turbo"]
    except Exception as e:
        print(f"turbo krew lease: {type(e).__name__}: {e}"[:160])
    return None


def write_flag(mode: str, *, force_restore: bool = False) -> bool:
    """Occupancy flag + Ada decomposer/dispatch + Crissa spawn caps.

    Does not bounce gateways. Ops long-prefill is a serve pin (2048), not N↔H.
    ``force_restore``: leaving Render while the crew hold is still set so a
    sleeper is not systemd-restarted. Restore pack YAML anyway.
    Returns True when the flag moved (this run) or a YAML apply changed a file.
    """
    global _FLAG_MOVED
    prev = read_mode()
    # Park TurboKrew workers on crew before the lane snapshot (Render must
    # not capture ops pins as SoT). The hour keeps running.
    apply_turbo_krew_occupancy(mode)
    MODE_FILE.parent.mkdir(parents=True, exist_ok=True)
    MODE_FILE.write_text(mode + "\n", encoding="utf-8")
    # A no-op write (normal→normal) must not guest the room. 2026-10-08 13:15
    # did, and presence then refused every door match.
    if prev != mode:
        _FLAG_MOVED = True
        drop_presence_to_guest(f"occupancy:{mode}")
    # Lane pins FIRST: the snapshot has to predate the dispatch-cap rewrite, or
    # leaving Render would restore a file that already said (1, 1).
    apply_render_lane(mode, force_restore=force_restore)
    results = [apply_ada_decomposer(mode)]
    # Dual-park exclusive window: do not leave Ada dispatching at a corpse. It used to write caps
    # (0, 0) - but hermes IGNORES a cap below 1 (kanban_watchers_common._positive_int_setting:
    # "below 1; ignoring") and falls back to its memory-derived default, so after the next host
    # boot 0/0 UNCAPPED the board (the User 09-29: fix it). Caps are read once at boot anyway. The
    # pause is `kanban.dispatch_profiles: []`, read on every spawn decision: the caps stay as the
    # host booted with them (never stale, never a bounce) and the pause works at once.
    paused_mode = mode == "heavy-render" or (mode == "render" and lane_brain(mode) == "none")
    if paused_mode:
        try:
            results.append(apply_dispatch_pause(True))
        except DispatchPauseRefused as e:
            print(f"dispatch pause refused: {e}", file=sys.stderr)
        on_disk = ada_caps_on_disk()
        results.append(apply_ada_dispatch(mode, caps=on_disk) if on_disk else "caps (unread, untouched)")
    else:
        results.append(apply_dispatch_pause(False))
        results.append(apply_ada_dispatch(mode, caps=ada_caps_for_mode(mode)))
    results.append(apply_crissa_spawn(mode))
    return _FLAG_MOVED or any(_apply_changed(r) for r in results)


def write_mode(mode: str) -> None:
    prev = read_mode()
    leftover_leave = (
        prev == "render"
        and mode == "normal"
        and not CREW_HOLD.is_file()
    )
    changed = write_flag(mode)
    # Render is about to stop Crissa — do not bounce her gateway just to sleep it.
    # Render used to skip the restart because she was about to be stopped anyway. Now she
    # stays up, and a gateway that is not restarted keeps the brain it cached at start —
    # which would leave her pointed at the ops that just parked. Restart her for render too.
    apply_ops_occupancy(mode, restart=(mode != "render" or CRISSA_CREW_IN_RENDER))
    maybe_sleep_ada_for_exclusive(mode)
    if leftover_leave:
        # Janitor way-back: flag stuck render, no hold. Silicon+flag only.
        # Ada bounce here is a dirty restart of a healthy dispatcher.
        print("leftover render flag, no hold — no Ada bounce unless her caps are stale")
        maybe_bounce_ada_for_caps(mode, by="leftover-leave")
        maybe_restart_crissa_gateway(mode)
        return
    if not changed:
        print(f"occupancy {mode} unchanged — no gateway bounce unless Ada's caps are stale")
        if mode != "heavy-render":  # an Ada bounce is a HOST restart: Crissa too
            maybe_bounce_ada_for_caps(mode, by="unchanged")
        return
    maybe_restart_ada_gateway(mode)
    if mode != "heavy-render":
        maybe_bounce_ada_for_caps(mode, by="leave")
    maybe_restart_crissa_gateway(mode)


def maybe_sleep_ada_for_exclusive(mode: str) -> None:
    """Dual-park Render has no live 27B. Ada dispatching then is the stall.

    Hold + stop the gateway. Caps are already 0/0 from write_flag. A live
    27B releases the exclusive Ada hold so maybe_restart can bring her back.
    """
    if mode == "render" and lane_brain(mode) == "none":
        hold_units("hermes-ada-gateway.service")
        print("exclusive render — both 27Bs parked; Ada sleeps (else bad switchover)")
        try:
            stop_unit("hermes-ada-gateway")
        except RuntimeError as e:
            print(f"stop ada: {e}", file=sys.stderr)
        return
    if "hermes-ada-gateway.service" in _hold_list() and lane_brain(mode) != "none":
        release_units("hermes-ada-gateway.service")


def decomposer_for_mode(mode: str) -> tuple[str, str]:
    """Crew unless emergency park-crew. Canonical Render keeps the team on :8005."""
    return decomposer_for_occupancy(mode)


def decomposer_for_occupancy(mode: str) -> tuple[str, str]:
    """Ada stays on crew. Emergency: crew held and ops live → ops."""
    if crew_parked() and not ops_parked():
        return DECOMPOSER_OPS
    return DECOMPOSER_CREW


def set_kanban_decomposer(text: str, model: str, base_url: str) -> tuple[str, bool]:
    """Rewrite model + base_url only inside the kanban_decomposer block.

    Leaves comments and sibling aux slots alone. Handles either key order
    (live: model then base_url; pack: base_url then model).
    """
    import re

    lines = text.splitlines(keepends=True)
    i = 0
    n = len(lines)
    changed = False
    field_re = re.compile(r"^([ \t]+)(model|base_url):[ \t]*(\S+)(.*\n?)$")
    header_re = re.compile(r"^[ \t]*kanban_decomposer:[ \t]*\n?$")
    while i < n:
        if not header_re.match(lines[i]):
            i += 1
            continue
        header_indent = len(lines[i]) - len(lines[i].lstrip(" \t"))
        i += 1
        while i < n:
            raw = lines[i]
            stripped = raw.lstrip(" \t")
            if stripped == "" or stripped.startswith("#"):
                i += 1
                continue
            indent = len(raw) - len(raw.lstrip(" \t"))
            if indent <= header_indent:
                break
            m = field_re.match(raw)
            if m:
                field = m.group(2)
                newv = model if field == "model" else base_url
                old = m.group(3)
                if len(old) >= 2 and old[0] in "'\"" and old[-1] == old[0]:
                    newv = old[0] + newv.strip("'\"") + old[0]
                repl = f"{m.group(1)}{field}: {newv}{m.group(4)}"
                if repl != raw:
                    lines[i] = repl
                    changed = True
            i += 1
        continue
    return "".join(lines), changed


def read_kanban_decomposer(text: str) -> Optional[tuple[str, str]]:
    """Return (model, base_url) from the first kanban_decomposer block."""
    try:
        import yaml  # type: ignore
    except ImportError:
        return None
    data = yaml.safe_load(text) or {}
    block = ((data.get("auxiliary") or {}).get("kanban_decomposer") or {})
    model = str(block.get("model") or "").strip()
    url = str(block.get("base_url") or "").strip()
    if not model or not url:
        return None
    return model, url


def apply_ada_decomposer(mode: str, *, path: Optional[Path] = None) -> str:
    """Keep live Ada decomposer on crew :8005. Occupancy does not move her.

    Does not restart Ada — Hermes load_config is mtime-cached, so the next
    decompose tick rereads the file. Pack YAML stays the crew default.
    """
    target = decomposer_for_occupancy(mode)
    cfg = path or ADA_CONFIG
    if not cfg.is_file():
        print(f"ada decomposer skipped — missing {cfg}")
        return "missing"
    raw = cfg.read_text(encoding="utf-8")
    new, changed = set_kanban_decomposer(raw, target[0], target[1])
    if not changed:
        return f"{target[0]} (already)"
    cfg.write_text(new, encoding="utf-8")
    label = "crew :8005" if target[0] == "crew" else "ops :8000"
    print(f"ada decomposer → {label}")
    return target[0]


def set_ada_dispatch_caps(text: str, total: int, per: int) -> tuple[str, bool]:
    """Rewrite kanban.max_in_progress and max_in_progress_per_profile only."""
    import re

    lines = text.splitlines(keepends=True)
    i = 0
    n = len(lines)
    changed = False
    header_re = re.compile(r"^kanban:[ \t]*\n?$")
    field_re = re.compile(
        r"^([ \t]+)(max_in_progress(?:_per_profile)?):[ \t]*(\S+)(.*\n?)$"
    )
    while i < n:
        if not header_re.match(lines[i]):
            i += 1
            continue
        i += 1
        while i < n:
            raw = lines[i]
            if raw and not raw.startswith((" ", "\t")) and raw.strip():
                break
            m = field_re.match(raw)
            if m:
                field = m.group(2)
                newv = str(per if field.endswith("per_profile") else total)
                repl = f"{m.group(1)}{field}: {newv}{m.group(4)}"
                if repl != raw:
                    lines[i] = repl
                    changed = True
            i += 1
        break
    return "".join(lines), changed


def apply_ada_dispatch(
    mode: str, *, path: Optional[Path] = None, caps: Optional[tuple[int, int]] = None
) -> str:
    total, per = caps if caps is not None else ADA_DISPATCH.get(mode, ADA_DISPATCH["normal"])
    cfg = path or ADA_CONFIG
    if not cfg.is_file():
        print(f"ada dispatch skipped — missing {cfg}")
        return "missing"
    raw = cfg.read_text(encoding="utf-8")
    new, changed = set_ada_dispatch_caps(raw, total, per)
    if not changed:
        return f"{total}/{per} (already)"
    cfg.write_text(new, encoding="utf-8")
    print(f"ada dispatch → max_in_progress={total} per_profile={per}")
    return f"{total}/{per}"


def set_crissa_spawn(text: str, children: int, depth: int) -> tuple[str, bool]:
    """Rewrite delegation.max_concurrent_children and max_spawn_depth."""
    import re

    lines = text.splitlines(keepends=True)
    i = 0
    n = len(lines)
    changed = False
    header_re = re.compile(r"^delegation:[ \t]*\n?$")
    field_re = re.compile(
        r"^([ \t]+)(max_concurrent_children|max_spawn_depth):[ \t]*(\S+)(.*\n?)$"
    )
    while i < n:
        if not header_re.match(lines[i]):
            i += 1
            continue
        i += 1
        while i < n:
            raw = lines[i]
            if raw.strip() and not raw.startswith((" ", "\t")):
                break
            m = field_re.match(raw)
            if m:
                field = m.group(2)
                newv = str(depth if field == "max_spawn_depth" else children)
                repl = f"{m.group(1)}{field}: {newv}{m.group(4)}"
                if repl != raw:
                    lines[i] = repl
                    changed = True
            i += 1
        break
    return "".join(lines), changed


def apply_crissa_spawn(mode: str, *, path: Optional[Path] = None) -> str:
    children, depth = CRISSA_SPAWN.get(mode, CRISSA_SPAWN["normal"])
    if path is None:
        _refuse_live_under_pytest()
    cfg = path or (HOUSE / "profiles" / "crissa" / "config.yaml")
    if not cfg.is_file():
        print(f"crissa spawn skipped — missing {cfg}")
        return "missing"
    raw = cfg.read_text(encoding="utf-8")
    new, changed = set_crissa_spawn(raw, children, depth)
    if not changed:
        return f"{children}/{depth} (already)"
    cfg.write_text(new, encoding="utf-8")
    print(f"crissa spawn → children={children} depth={depth}")
    return f"{children}/{depth}"


def maybe_restart_ada_gateway(mode: str) -> None:
    """Restart the dispatcher only when **entering** Render so the render caps load now.

    The dispatcher is the shared hermes-gateway (host ``~/.hermes/config.yaml``). hermes
    reads ``kanban.max_in_progress`` once at that process's boot, so writing the file
    without this restart leaves the previous caps in force. Leave/normal used to restart
    on every exit — a dirty SIGTERM of a healthy dispatcher. The way back restarts only
    when the caps she is running are not the caps on disk (``maybe_bounce_ada_for_caps``).
    Exclusive dual-park still *stops* her in maybe_sleep_ada_for_exclusive. Do not restart
    on the way back from here.
    """
    if mode != "render":
        return
    if _dispatcher_held():
        print("dispatcher held — not restarting")
        return
    if lane_brain(mode) == "none":
        print("dispatcher — both 27Bs parked; not restarting onto a corpse")
        return
    unit = _dispatcher_unit()
    print(f"dispatcher caps → restart {unit} (render-enter)")
    _restart_dispatcher()


# THE WAY BACK BOUNCES ADA WHEN HER CAPS ARE STALE (2026-09-19). The docstring
# above assumed she picks (3, 2) up by mtime; hermes reads kanban.max_in_progress
# ONCE at gateway boot (gateway/kanban_watchers.py: "Read config once at boot.
# If the user flips the flag later, they restart the gateway"). So a 3-minute
# Render trip on 2026-09-18 (20:09:50 -> 20:12:46) restarted her at (1, 1) going
# in, wrote (3, 2) back on the way out, and left her dispatching ONE card wide
# until the owner bounced her from the CP at 01:16: max concurrency 6 -> 1,
# promoted->claimed median 0.2 -> 32.8 min, the gate's `caps=owed` line unread
# all night. KillMode=process keeps her workers through the restart.
ADA_GATEWAY_UNIT = "hermes-ada-gateway.service"
# Hold-file vocabulary stays the per-profile name. The process that read the caps does not.


def _dispatcher_unit() -> str:
    """The unit whose restart reloads kanban caps.

    Host: ``hermes-gateway.service``. That name is not a profile unit, so the systemd
    door restarts it directly (every profile reconnects, including Lila, Bash, Vera,
    and the ops brain). Units: Ada's own gateway, which is the dispatcher there.
    """
    topo = _gateway_topology()
    if topo is None:
        return ADA_GATEWAY_UNIT
    return str(getattr(topo, "HOST_UNIT", "hermes-gateway.service"))


def _dispatcher_held() -> bool:
    """A hold of the old Ada unit still means the dispatcher. So does a hold of the host unit."""
    held = set(_hold_list())
    return ADA_GATEWAY_UNIT in held or _dispatcher_unit() in held


def _restart_dispatcher() -> subprocess.CompletedProcess:
    """Restart the process that read the caps. Not a profile park."""
    return _systemctl_user(["restart", _dispatcher_unit()])


ADA_CAPS_LIVE = Path(os.environ.get("KREW_ADA_CAPS_LIVE", str(HOUSE / "ada-dispatch-live.json")))
ADA_CAPS_PENDING = Path(os.environ.get("KREW_ADA_CAPS_PENDING", str(HOUSE / "ada-caps-pending")))
ADA_CAPS_BOUNCED = Path(os.environ.get("KREW_ADA_CAPS_BOUNCED", str(HOUSE / "ada-caps-bounced")))
ADA_CAPS_BOUNCE_ON = os.environ.get("KREW_ADA_CAPS_BOUNCE", "1").strip().lower() not in ("0", "false", "no", "off")


def ada_caps_on_disk(path: Optional[Path] = None) -> Optional[tuple[int, int]]:
    """kanban.max_in_progress / _per_profile from Ada's YAML, None when unreadable."""
    import re

    cfg = path or ADA_CONFIG
    try:
        text = cfg.read_text(encoding="utf-8")
    except OSError:
        return None
    t = re.search(r"^\s*max_in_progress:\s*(\d+)", text, re.M)
    per = re.search(r"^\s*max_in_progress_per_profile:\s*(\d+)", text, re.M)
    if not t or not per:
        return None
    return int(t.group(1)), int(per.group(1))


def _ada_gateway_start() -> tuple[str, float]:
    """(systemd's ActiveEnterTimestamp string, its epoch) — ("", 0.0) when not active."""
    try:
        r = _systemctl_user(["show", ADA_GATEWAY_UNIT, "-p", "ActiveEnterTimestamp", "--value"], timeout=30)
    except Exception:
        return "", 0.0
    text = (r.stdout or "").strip() if r.returncode == 0 else ""
    if not text:
        return "", 0.0
    parts = text.split()
    try:                                   # "Fri 2026-09-18 20:11:08 EDT" -> local epoch (zone dropped)
        epoch = time.mktime(time.strptime(" ".join(parts[1:3]), "%Y-%m-%d %H:%M:%S"))
    except (ValueError, IndexError):
        epoch = 0.0
    return text, epoch


def ada_caps_stale() -> tuple[bool, str]:
    """Does the running gateway carry caps other than the file's? (stale, why).

    Two witnesses: the board gate's record of what she loaded at her start
    (`ada-dispatch-live.json`, written on the first tick after each start), and
    failing that, the file's mtime against her start (a rewrite after she booted
    is a cap she never read)."""
    disk = ada_caps_on_disk()
    if disk is None:
        return False, "no ada config"
    start, epoch = _ada_gateway_start()
    if not start:
        return False, "ada gateway not active"
    try:
        rec = json.loads(ADA_CAPS_LIVE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        rec = {}
    if rec.get("gateway_start") == start:
        live = tuple(int(x) for x in (rec.get("caps") or ())) if rec.get("caps") else None
        if live is None:
            return False, "no record of what she loaded"
        if live == disk:
            return False, f"caps {disk[0]}/{disk[1]} on disk and live"
        return True, f"gateway runs {live[0]}/{live[1]}, disk says {disk[0]}/{disk[1]} (gate record)"
    try:
        mtime = ADA_CONFIG.stat().st_mtime
    except OSError:
        return False, "no ada config"
    if epoch and mtime > epoch + 2:
        return True, (f"config rewritten {int(mtime - epoch)} s after the gateway started "
                      f"(disk {disk[0]}/{disk[1]}; no gate record for this start)")
    return False, f"caps {disk[0]}/{disk[1]} predate the gateway start"


def maybe_bounce_ada_for_caps(mode: str, *, by: str = "way-back", dry_run: bool = False) -> bool:
    """Restart Ada's gateway when the caps she runs are not the caps on disk.

    Only on the way back (never entering Render — that restart is above), never
    held, never onto a parked brain, once per gateway start. Kill:
    KREW_ADA_CAPS_BOUNCE=0. Returns True when a restart was issued."""
    if mode == "render" or not ADA_CAPS_BOUNCE_ON:
        return False
    stale, why = ada_caps_stale()
    if not stale:
        return False
    start, _ = _ada_gateway_start()
    try:
        if ADA_CAPS_BOUNCED.read_text(encoding="utf-8").strip() == start:
            print(f"ada caps stale ({why}) — already bounced this start; not again")
            return False
    except OSError:
        pass
    if _dispatcher_held():
        print(f"ada caps stale ({why}) — gateway held; not restarting")
        return False
    if lane_brain(mode) == "none":
        print(f"ada caps stale ({why}) — both 27Bs parked; not restarting onto a corpse")
        return False
    unit = _dispatcher_unit()
    print(f"ada caps stale ({why}) -> restart {unit} ({by})")
    if dry_run:
        return True
    try:
        ADA_CAPS_BOUNCED.write_text(start + "\n", encoding="utf-8")
    except OSError:
        pass
    r = _restart_dispatcher()
    rc = getattr(r, "returncode", 0)
    try:
        ADA_CAPS_PENDING.unlink()
    except OSError:
        pass
    _hold_log({"event": "ada-caps-bounce", "unit": unit, "rc": rc, "by": by, "why": why})
    return True


def maybe_restart_crissa_gateway(mode: str) -> None:
    """Spawn caps are YAML; Crissa caches config at start. N↔H is not a pin restore.

    apply_ops_occupancy only bounces her when a Beast snapshot is restored.
    Skip Render (she is sleeping). Skip if held.
    """
    if mode != "normal":
        return
    if "hermes-crissa-gateway.service" in _hold_list():
        print("crissa gateway held — not restarting")
        return
    _systemctl_user(["restart", "hermes-crissa-gateway.service"])


def ops_pin_targets() -> list[Path]:
    """Live Hermes YAMLs occupancy may retarget. Crissa only."""
    out: list[Path] = []
    profiles = HOUSE / "profiles"
    for name in OPS_PIN_PROFILES:
        p = profiles / name / "config.yaml"
        if p.is_file():
            out.append(p)
    return out


def file_has_ops_pin(text: str) -> bool:
    return (
        OPS_URL_PIN in text
        or "model: ops" in text
        or "default: ops" in text
        or "custom:ops" in text
    )


def ensure_ops_fallback(text: str) -> tuple[str, int]:
    """Pin fallback_model and the named ops custom_provider back to ops :8000.

    Stay-on-crew Render must keep that limp. MAIN/aux and the named crew
    provider stay put. Comments/denies stay.
    """
    import re

    n = 0
    url_re = re.compile(
        r"^(?P<pre>[ \t]*base_url:[ \t]*)"
        + re.escape(CREW_URL_PIN)
        + r"(?P<post>\s*(?:#.*)?\n?)$"
    )
    model_re = re.compile(
        r"^(?P<pre>[ \t]*(?:model|default):[ \t]*)crew(?P<post>\s*(?:#.*)?\n?)$"
    )
    item_re = re.compile(r"^(?P<pre>[ \t]*-[ \t]*)crew(?P<post>\s*(?:#.*)?\n?)$")
    header_fb = re.compile(r"^fallback_model:[ \t]*\n?$")
    name_ops = re.compile(r"^[ \t]*-[ \t]*name:[ \t]*ops\s*(?:#.*)?\n?$")
    name_other = re.compile(r"^[ \t]*-[ \t]*name:[ \t]*\S+")

    def _rewrite(raw: str) -> str:
        nonlocal n
        repl = raw
        for cre, newv in (
            (url_re, OPS_URL_PIN),
            (model_re, "ops"),
            (item_re, "ops"),
        ):
            m = cre.match(repl)
            if m:
                n += 1
                return f"{m.group('pre')}{newv}{m.group('post')}"
        return repl

    out: list[str] = []
    in_fb = False
    in_ops_cp = False
    for raw in text.splitlines(keepends=True):
        if header_fb.match(raw):
            in_fb = True
            in_ops_cp = False
            out.append(raw)
            continue
        if in_fb:
            if raw.strip() and not raw.startswith((" ", "\t")) and not raw.lstrip().startswith("#"):
                in_fb = False
            else:
                out.append(_rewrite(raw))
                continue
        if name_ops.match(raw):
            in_ops_cp = True
            out.append(raw)
            continue
        if in_ops_cp and name_other.match(raw):
            in_ops_cp = False
        if in_ops_cp:
            if raw.strip() and not raw.startswith((" ", "\t", "-")):
                in_ops_cp = False
            else:
                out.append(_rewrite(raw))
                continue
        out.append(raw)
    return "".join(out), n


def swap_ops_pins_to_crew(text: str) -> tuple[str, int]:
    """Retarget every ops/:8000 client pin to crew/:8005. Comments/denies stay.

    Does not rename custom_providers `name: ops` — leftover custom:ops then
    still resolves, but its URL/model become crew. List item `- ops` becomes
    `- crew` so the served-name matches :8005.
    """
    import re

    n = 0
    lines = text.splitlines(keepends=True)
    out: list[str] = []
    url_re = re.compile(r"^(?P<pre>[ \t]*base_url:[ \t]*)" + re.escape(OPS_URL_PIN) + r"(?P<post>\s*(?:#.*)?\n?)$")
    model_re = re.compile(r"^(?P<pre>[ \t]*(?:model|default):[ \t]*)ops(?P<post>\s*(?:#.*)?\n?)$")
    prov_re = re.compile(r"^(?P<pre>[ \t]*provider:[ \t]*)custom:ops(?P<post>\s*(?:#.*)?\n?)$")
    item_re = re.compile(r"^(?P<pre>[ \t]*-[ \t]*)ops(?P<post>\s*(?:#.*)?\n?)$")
    for raw in lines:
        repl = raw
        for cre, newv in (
            (url_re, CREW_URL_PIN),
            (model_re, "crew"),
            (prov_re, "custom:crew"),
            (item_re, "crew"),
        ):
            m = cre.match(repl)
            if m:
                repl = f"{m.group('pre')}{newv}{m.group('post')}"
                n += 1
                break
        out.append(repl)
    return "".join(out), n


def _pin_snapshot_name(path: Path) -> str:
    if path == BRIDGE_CONFIG:
        return "bridge.config.yaml"
    return f"profile-{path.parent.name}.config.yaml"


def render_lane_targets() -> list[Path]:
    """Live configs for the profiles that keep working while Lila draws."""
    out: list[Path] = []
    profiles = HOUSE / "profiles"
    for name in RENDER_LANE_PROFILES:
        p = profiles / name / "config.yaml"
        if p.is_file():
            out.append(p)
    return out


def file_has_crew_pin(text: str) -> bool:
    return (
        CREW_URL_PIN in text
        or "model: crew" in text
        or "default: crew" in text
        or "custom:crew" in text
    )


def swap_crew_pins_to_ops(text: str) -> tuple[str, int]:
    """Retarget every crew/:8005 client pin to ops/:8000. The inverse of the
    Beast swap, and the reason the lane works at all in Render.

    `fallback_model` only covers a profile's MAIN model. The `auxiliary.*`
    slots — vision above all — carry their own base_url and inherit nothing,
    so Vera's look would 404 a parked :8005 without this. Measured 2026-08-28:
    ada/bash/lila/vera all pin auxiliary.vision at crew.
    """
    import re

    n = 0
    out: list[str] = []
    url_re = re.compile(
        r"^(?P<pre>[ \t]*base_url:[ \t]*)" + re.escape(CREW_URL_PIN)
        + r"(?P<post>\s*(?:#.*)?\n?)$"
    )
    model_re = re.compile(r"^(?P<pre>[ \t]*(?:model|default):[ \t]*)crew(?P<post>\s*(?:#.*)?\n?)$")
    prov_re = re.compile(r"^(?P<pre>[ \t]*provider:[ \t]*)custom:crew(?P<post>\s*(?:#.*)?\n?)$")
    item_re = re.compile(r"^(?P<pre>[ \t]*-[ \t]*)crew(?P<post>\s*(?:#.*)?\n?)$")
    for raw in text.splitlines(keepends=True):
        repl = raw
        for cre, newv in (
            (url_re, OPS_URL_PIN),
            (model_re, "ops"),
            (prov_re, "custom:ops"),
            (item_re, "ops"),
        ):
            m = cre.match(repl)
            if m:
                repl = f"{m.group('pre')}{newv}{m.group('post')}"
                n += 1
                break
        out.append(repl)
    return "".join(out), n


def set_default_assignee(text: str, who: str) -> tuple[str, bool]:
    """Rewrite kanban.default_assignee only."""
    import re

    lines = text.splitlines(keepends=True)
    i, n, changed = 0, len(text.splitlines(keepends=True)), False
    header_re = re.compile(r"^kanban:[ \t]*\n?$")
    field_re = re.compile(r"^([ \t]+)(default_assignee):[ \t]*(\S+)(.*\n?)$")
    while i < n:
        if not header_re.match(lines[i]):
            i += 1
            continue
        i += 1
        while i < n:
            raw = lines[i]
            if raw.strip() and not raw.startswith((" ", "\t")):
                break
            m = field_re.match(raw)
            if m:
                repl = f"{m.group(1)}{m.group(2)}: {who}{m.group(4)}"
                if repl != raw:
                    lines[i] = repl
                    changed = True
            i += 1
        break
    return "".join(lines), changed


def apply_render_lane(mode: str, *, force_restore: bool = False) -> str:
    """Pin the kanban lane to a live 27B. Never to a parked engine.

    Canonical Render: crew is live, pack YAML stays, board routing only
    (Ada default_assignee lila, bash spawn 1/1). Emergency park-crew (hold
    names crew, not ops): whole lane onto ops. Dual-park: return ``none``
    and leave YAML alone — rewriting toward either corpse is the stall.
    Leaving Render: restore pack snapshots.
    """
    _refuse_live_under_pytest()
    if mode != "render":
        if crew_parked() and not force_restore:
            return _pin_lane_to_ops(everyone=True)
        return _restore_lane_pins()
    brain = lane_brain(mode)
    if brain == "none":
        return "none (both 27Bs parked)"
    if brain == "ops":
        return _pin_lane_to_ops(everyone=True)
    return _pin_render_board_keep_crew()


def _snapshot_lane(path: Path, raw: str) -> None:
    """First write only. Never snapshot an already-rewritten drawer as SoT."""
    snap = RENDER_LANE_PIN / _pin_snapshot_name(path)
    if snap.is_file():
        return
    src = raw
    name = path.parent.name
    if name in RENDER_DRAWER_PROFILES and not file_has_crew_pin(raw):
        pack = PACK_DISTRIBUTIONS / name / "config.yaml"
        if not pack.is_file():
            return
        src = pack.read_text(encoding="utf-8")
    snap.write_text(src, encoding="utf-8")


def _pin_render_board_keep_crew() -> str:
    """Canonical Render: snapshot, route cards to Lila, clamp bash, keep URLs."""
    targets = render_lane_targets()
    if not targets:
        return "crew (no snapshot)"
    RENDER_LANE_PIN.mkdir(parents=True, exist_ok=True)
    files = 0
    for path in targets:
        raw = path.read_text(encoding="utf-8")
        _snapshot_lane(path, raw)
        new = raw
        if path.parent.name == "ada":
            new, moved = set_default_assignee(new, "lila")
            if moved:
                print("render board → default_assignee: lila")
        if path.parent.name == "bash":
            kids, depth = RENDER_BASH_SPAWN
            new, clamped = set_crissa_spawn(new, kids, depth)
            if clamped:
                print(f"render board → bash delegation {kids}/{depth}")
        if new != raw:
            path.write_text(new, encoding="utf-8")
            files += 1
    if files:
        return f"crew (board {files} files)"
    return "crew (already)"


def _pin_lane_to_ops(*, everyone: bool = False) -> str:
    targets = render_lane_targets()
    if not targets:
        return "ops (no lane configs)"
    RENDER_LANE_PIN.mkdir(parents=True, exist_ok=True)
    want = (
        set(RENDER_LANE_PROFILES)
        if everyone
        else set(RENDER_DRAWER_PROFILES)
    )
    flipped = 0
    files = 0
    for path in targets:
        raw = path.read_text(encoding="utf-8")
        _snapshot_lane(path, raw)
        if path.parent.name not in want:
            continue
        new, n = swap_crew_pins_to_ops(raw) if file_has_crew_pin(raw) else (raw, 0)
        if everyone:
            if path.parent.name == "ada":
                new, moved = set_default_assignee(new, "lila")
                if moved:
                    print("render board → default_assignee: lila")
            if path.parent.name == "bash":
                kids, depth = RENDER_BASH_SPAWN
                new, clamped = set_crissa_spawn(new, kids, depth)
                if clamped:
                    print(f"render board → bash delegation {kids}/{depth}")
        if new != raw:
            path.write_text(new, encoding="utf-8")
            flipped += n
            files += 1
            print(f"render lane → ops :8000  {path}  ({n} pins)")
    if files:
        return f"ops ({flipped} pins / {files} files)"
    return "ops (already)"


def _pin_drawers_to_ops() -> str:
    """Crew is up: Ada/bash/steward stay :8005. Only Lila/Vera move to ops.

    Stay repair runs *before* snapshot so an eaten fallback is not captured
    as the leave-render SoT (measured 2026-09-05 18:02 pin-dir poison).
    """
    _keep_stay_on_crew()
    targets = render_lane_targets()
    if targets:
        RENDER_LANE_PIN.mkdir(parents=True, exist_ok=True)
        for path in targets:
            _snapshot_lane(path, path.read_text(encoding="utf-8"))
    return _pin_lane_to_ops(everyone=False)


def _keep_stay_on_crew() -> None:
    """Ada/bash/steward: crew main, pack ops fallback intact.

    swap_ops_pins_to_crew is for park-ops (ops is dead). Using it while ops
    is live eats fallback_model and the named ops provider onto :8005.
    If stay was everyone-ops (crew-park leftover), swap main back to crew
    then put the limp back. If stay is already crew-main with eaten limp,
    only ensure_ops_fallback runs.
    """
    for path in render_lane_targets():
        if path.parent.name not in RENDER_CREW_STAY_PROFILES:
            continue
        if not path.is_file():
            continue
        raw = path.read_text(encoding="utf-8")
        new, n_swap = (
            swap_ops_pins_to_crew(raw) if file_has_ops_pin(raw) else (raw, 0)
        )
        new, n_fb = ensure_ops_fallback(new)
        if new != raw:
            path.write_text(new, encoding="utf-8")
            print(
                f"render stay → crew main / ops fallback  {path}  "
                f"({n_swap}+{n_fb})"
            )


def _pin_lane_to_crew() -> str:
    """Park-ops Render: the lane rides crew :8005. Keep any ops-pin snapshots.

    Snapshots must stay the pack YAML captured on the way into Render. Do not
    snapshot an already-ops-pinned file as the thing to restore.
    """
    targets = render_lane_targets()
    if not targets:
        return "crew (no lane configs)"
    RENDER_LANE_PIN.mkdir(parents=True, exist_ok=True)
    flipped = 0
    files = 0
    for path in targets:
        raw = path.read_text(encoding="utf-8")
        snap = RENDER_LANE_PIN / _pin_snapshot_name(path)
        if not snap.is_file() and file_has_crew_pin(raw):
            snap.write_text(raw, encoding="utf-8")
        new, n = swap_ops_pins_to_crew(raw) if file_has_ops_pin(raw) else (raw, 0)
        if new != raw:
            path.write_text(new, encoding="utf-8")
            flipped += n
            files += 1
            print(f"render lane → crew :8005  {path}  ({n} pins)")
    if files:
        return f"crew ({flipped} pins / {files} files)"
    return "crew (already)"


def _restore_lane_pins() -> str:
    if not RENDER_LANE_PIN.is_dir():
        return "crew (no snapshot)"
    restored = 0
    profiles = HOUSE / "profiles"
    for snap in sorted(RENDER_LANE_PIN.glob("profile-*.config.yaml")):
        name = snap.name[len("profile-") : -len(".config.yaml")]
        path = profiles / name / "config.yaml"
        if path.is_file():
            path.write_text(snap.read_text(encoding="utf-8"), encoding="utf-8")
            restored += 1
            print(f"render lane restored  {path}")
        snap.unlink()
    for leftover in RENDER_LANE_PIN.glob("*"):
        leftover.unlink()
    try:
        RENDER_LANE_PIN.rmdir()
    except OSError:
        pass
    return f"crew ({restored} files)" if restored else "crew (nothing pinned)"


def crissa_rides_crew(mode: str) -> bool:
    """Modes where Crissa's brain is crew :8005 instead of ops :8000.

    Beast, always — ops is the thing Beast is loading. Render too, since
    2026-09-22: ops parks so Comfy fits, and pointing her at the brain that
    just left is what used to force her gateway down for the whole render.
    """
    return mode == "beast" or (mode == "render" and CRISSA_CREW_IN_RENDER)


def apply_ops_occupancy(mode: str, *, restart: bool = False) -> str:
    """Beast/Render: Crissa → crew :8005. Other modes: restore her ops snapshot.

    Ada stays crew. Pack YAML stays the SoT. Snapshot is
    ~/.hermes/krew-beast-ops-pin/profile-crissa.config.yaml — shared with
    Render on purpose: same flip, same restore, one code path to trust, and
    the snapshot write is guarded by `if not snap.is_file()` so Beast→Render
    or Render→Beast cannot overwrite the true ops original. write_mode
    passes restart=True so Crissa's gateway rereads the brain.
    """
    _refuse_live_under_pytest()
    if mode == "heavy-render":
        return _apply_crew_pins_heavy(restart=restart)
    if crissa_rides_crew(mode):
        return _apply_ops_pins_beast(restart=restart)
    return _restore_ops_pins(restart=restart)


def _apply_ops_pins_beast(*, restart: bool) -> str:
    BEAST_OPS_PIN.mkdir(parents=True, exist_ok=True)
    flipped = 0
    files = 0
    for path in ops_pin_targets():
        raw = path.read_text(encoding="utf-8")
        if not file_has_ops_pin(raw):
            continue
        snap = BEAST_OPS_PIN / _pin_snapshot_name(path)
        if not snap.is_file():
            snap.write_text(raw, encoding="utf-8")
        new, n = swap_ops_pins_to_crew(raw)
        if n:
            path.write_text(new, encoding="utf-8")
            flipped += n
            files += 1
            print(f"ops pin → crew :8005  {path}  ({n})")
    if flipped:
        if restart:
            _restart_ops_pin_gateways()
        return f"crew ({flipped} pins / {files} files)"
    return "crew (already)"


def _apply_crew_pins_heavy(*, restart: bool) -> str:
    """heavy-render: crew is OFF the card, so every slot of Crissa's that names crew (aux,
    delegation, fallback) goes to ops for the window. Her main brain is already ops. The
    snapshot is Beast's (`BEAST_OPS_PIN`, first write only) so the one restore path every
    normal write runs - _restore_ops_pins - puts her file back byte for byte on exit."""
    BEAST_OPS_PIN.mkdir(parents=True, exist_ok=True)
    flipped = files = 0
    for path in ops_pin_targets():
        raw = path.read_text(encoding="utf-8")
        if not file_has_crew_pin(raw):
            continue
        snap = BEAST_OPS_PIN / _pin_snapshot_name(path)
        if not snap.is_file():
            snap.write_text(raw, encoding="utf-8")
        new, n = swap_crew_pins_to_ops(raw)
        if n:
            path.write_text(new, encoding="utf-8")
            flipped += n
            files += 1
            print(f"crew pin → ops :8000  {path}  ({n})")
    if flipped:
        if restart:
            _restart_ops_pin_gateways()
        return f"ops ({flipped} crew pins / {files} files)"
    return "ops (already)"


def _restore_ops_pins(*, restart: bool) -> str:
    if not BEAST_OPS_PIN.is_dir():
        return "ops (no snapshot)"
    restored = 0
    for path in ops_pin_targets():
        snap = BEAST_OPS_PIN / _pin_snapshot_name(path)
        if not snap.is_file():
            continue
        path.write_text(snap.read_text(encoding="utf-8"), encoding="utf-8")
        snap.unlink()
        restored += 1
        print(f"ops pin ← 27B ops :8000  {path}")
    for leftover in BEAST_OPS_PIN.glob("*"):
        leftover.unlink()
    try:
        BEAST_OPS_PIN.rmdir()
    except OSError:
        pass
    if restored and restart:
        _restart_ops_pin_gateways()
    return f"ops ({restored} files)" if restored else "ops (already)"


def _restart_ops_pin_gateways() -> None:
    """Crissa rereads profile YAML. Do not bounce Ada, crew, or ops."""
    for unit in OPS_PIN_GATEWAYS:
        _systemctl_user(["restart", unit])


def count_live_ops_pins() -> int:
    n = 0
    for path in ops_pin_targets():
        if file_has_ops_pin(path.read_text(encoding="utf-8")):
            n += 1
    return n


def read_ops_recipe() -> str:
    """Legacy file. start-ops.sh no longer reads it. Always daily."""
    return "daily"


def write_ops_recipe(kind: str) -> None:
    """Unlink leftover ~/.hermes/krew-ops-recipe. Never write beast."""
    del kind  # occupancy flag is SoT; recipe=beast is dead
    try:
        OPS_RECIPE_FILE.unlink()
    except FileNotFoundError:
        pass


def restart_ops() -> None:
    proc = _systemctl_user(["restart", OPS_UNIT])
    if proc.returncode != 0:
        raise RuntimeError("ops restart failed")


def read_state() -> Dict[str, Any]:
    if not STATE_FILE.is_file():
        return {}
    try:
        data = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return {}
    return data if isinstance(data, dict) else {}


def write_state(state: Dict[str, Any]) -> None:
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")


def park_plan(
    need_gib: float,
    free_gib: Optional[float],
    voice_on: bool,
    *,
    ops_up: Optional[bool] = None,
    crew_up: Optional[bool] = None,
    comfy_resident: bool = False,
) -> Dict[str, Any]:
    """What GPU tenants to stop so `need_gib` fits. Ops (composer) first.

    Voice ON keeps Cosy (mouth), not ops. Render still sleeps Crissa's
    gateway. Ada stays up on crew. Measured 2026-09-08: ops ~39.4 GB and
    crew ~39.8 GB are peers (the old 41.1 vs 32.0 split is stale).

    2026-09-13: credit a brain's VRAM only when that brain is actually up.
    Four renders failed "only 16.8 GiB free after krew-mode render wan":
    ops was already parked and Comfy sat resident on ~37 GiB, and the plan
    still said "park ops → ~59 GiB" — VRAM that Comfy was sitting on. A
    parked brain (``ops_up=False`` / ``crew_up=False``) is worth 0 GiB; the
    plan then refuses BEFORE anything is parked. ``None`` keeps the old
    "assume up" credit for callers that do not probe.
    """
    if free_gib is None:
        return {
            "ok": False,
            "park": [],
            "reason": "VRAM unread — will not guess",
        }
    if free_gib >= need_gib:
        return {"ok": True, "park": [], "reason": f"{free_gib:.1f} GiB free ≥ {need_gib:.0f}"}
    ops_gib = 39.4 if ops_up is not False else 0.0
    crew_gib = 39.8 if crew_up is not False else 0.0
    resident = " (Comfy resident — its VRAM does not come back by parking a brain)" if comfy_resident else ""
    if ops_gib == 0.0 and crew_gib == 0.0:
        return {
            "ok": False,
            "park": [],
            "reason": f"{free_gib:.1f} GiB free < {need_gib:.0f} and no brain up to park{resident}; refusing before park",
        }
    after_ops = free_gib + ops_gib
    if ops_gib and after_ops >= need_gib:
        return {
            "ok": True,
            "park": ["ops"],
            "reason": f"park ops → ~{after_ops:.1f} GiB ≥ {need_gib:.0f}",
        }
    if voice_on:
        return {
            "ok": False,
            "park": ["ops"] if ops_gib else [],
            "reason": (
                f"after ops ~{after_ops:.1f} GiB still < {need_gib:.0f}{resident}; "
                "Voice ON — Cosy stays (mouth); crew stays (team)"
                + ("" if ops_gib else "; ops already parked — refusing before park")
            ),
        }
    after_both = after_ops + crew_gib
    park = [u for u, g in (("ops", ops_gib), ("crew", crew_gib)) if g]
    if after_both >= need_gib:
        return {
            "ok": True,
            "park": park,
            "reason": f"Voice OFF; park {'+'.join(park)} → ~{after_both:.1f} GiB",
        }
    return {
        "ok": False,
        "park": park,
        "reason": f"even {'+'.join(park) or 'nothing to park'} (~{after_both:.1f} GiB) < {need_gib:.0f}{resident}",
    }


def http_ok(url: str, timeout: float = 2.0) -> bool:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return 200 <= r.status < 300
    except (urllib.error.URLError, TimeoutError, OSError):
        return False


def _gateway_topology():
    """lib/hermes_topology when the house runs ONE host gateway, else None.

    A missing ``krew-topology.env`` is host (the shared gateway). None is only
    ``units``, named by the env or the file. Never raises: a mode switch does
    not fall over a read."""
    try:
        lib = str(Path(__file__).resolve().parents[1] / "lib")
        if lib not in sys.path:
            sys.path.insert(0, lib)
        import hermes_topology
        return hermes_topology if hermes_topology.is_host() else None
    except Exception:  # noqa: BLE001
        return None


def _host_gateway_call(args: Sequence[str]) -> Optional[subprocess.CompletedProcess]:
    """One host gateway serves every profile (KREW_GATEWAY_TOPOLOGY=host).

    This file keeps speaking in the per-profile unit names — they are the hold file's vocabulary,
    and a hold written before the cutover must still release after it — and the names are
    translated HERE, at the one door to systemd:

      stop / start     park / unpark the profile (its adapters and cron; the host and the
                       other profiles are untouched). Its WORKERS are stopped by argv, as before.
      restart          the profile re-reads its config (`hermes -p <p> gateway restart`) — except
                       Ada: the dispatcher's caps are read at the HOST's boot, so her restart is
                       the host's.
      is-active        `active` while the host is active and serves the profile, else `inactive`.
      show             asked of the host unit.
      reset-failed     nothing to reset; answers success.

    Returns None for anything that is not a per-profile gateway unit, and under `units`.
    """
    topo = _gateway_topology()
    if topo is None or not args:
        return None
    verb = args[0]
    hits = [(i, topo.profile_of_unit(str(a))) for i, a in enumerate(args) if i and not str(a).startswith("-")]
    hits = [(i, p) for i, p in hits if p]
    if not hits:
        return None
    done = lambda ok, out="": subprocess.CompletedProcess(list(args), 0 if ok else 1, out, "" if ok else f"{verb} failed")
    profiles = [p for _, p in hits]
    if verb == "is-active":
        up = all(topo.profile_up(p) for p in profiles)
        return subprocess.CompletedProcess(list(args), 0 if up else 3, ("active" if up else "inactive") + "\n", "")
    if verb == "reset-failed":
        return done(True)
    if verb == "stop":
        return done(all([topo.park(p) for p in profiles]))
    if verb == "start":
        return done(all([topo.unpark(p) for p in profiles]))
    if verb in ("restart", "try-restart"):
        if "ada" in profiles:
            return done(topo.restart_host(block="--no-block" not in args))
        return done(all([topo.restart_profile(p) for p in profiles]))
    if verb == "show":
        real = [topo.HOST_UNIT if i in dict(hits) else a for i, a in enumerate(args)]
        return subprocess.run(["systemctl", "--user", *real], text=True, capture_output=True, timeout=30)
    return None


def _systemctl_user(args: Sequence[str], timeout: float | None = None) -> subprocess.CompletedProcess:
    routed = _host_gateway_call(args)
    if routed is not None:
        return routed
    return subprocess.run(
        ["systemctl", "--user", *args],
        text=True,
        capture_output=True,
        timeout=timeout if timeout else 180,
    )


# COSY HAS A DORMANT TWIN. Two cosy-voice.service files exist with the same
# ExecStart: the real one at ~/.config/systemd/user/cosy-voice.service and a
# stale /etc/systemd/system/cosy-voice.service. The 2026-08-07 purge (see
# krew-keeper LANES) moved every lane to a single USER owner and disabled the
# system copy, but never deleted the file -- so `sudo systemctl start
# cosy-voice` still wakes a second cosy_server.py on the same port and card.
#
# The two are NOT interchangeable. The user unit carries eight drop-ins: the
# whole vLLM stage (vllm26.conf resets ExecStart to the cosyvoice_vllm env),
# the branded voice pin (seed 20260619, speed 1.2), the onset hold, the memory
# ceilings. The system file has none of it -- measured 2026-09-05, the same
# /warm returned 76,800 bytes on the user unit and 6,720 on the system one.
# USER IS THE OWNER. Never reach for the system copy.
#
# The collision this guards: a mode switch that found /health slow on a live,
# GPU-resident Cosy used to call start_unit() and get a SECOND instance on the
# same port and the same card.
#
# AND THE STANDING TRAP, which is separate and still live. Cosy legitimately
# holds ~11 GiB (2.6 server + 8.4 for her embedded vLLM). Measured 2026-09-05
# with both engines up: 4.3 GiB free -- BELOW her own 6.0 GiB preflight. So a
# Cosy that goes down in Standard cannot come back until something else moves.
# ensure_cosy_up waits for VRAM that will not arrive; that wait is honest, not
# a fix. The fix is either a crew KV pin that reserves her restart headroom, or
# accepting that Cosy must lead the boot order (crew already waits on ops, and
# nothing waits on Cosy).
COSY_UNIT = VOICE_UNIT   # the services.json `voice` row (the reference install: Chatterbox Turbo on :7789)
# Cosy's own preflight refuses under 6.0 GiB. Ask for a little more so we do
# not lose the race to an engine that is still settling.
COSY_NEED_GIB = float(os.environ.get("KREW_COSY_NEED_GIB", "6.5"))
# Render is the one mode that may park the voice (the owner 2026-09-05). Set 0 to
# restore the old behaviour, where park_plan never parked Cosy at all.
COSY_RENDER_PARK = os.environ.get("KREW_COSY_RENDER_PARK", "1") != "0"


def _systemctl_cosy(args: Sequence[str]) -> subprocess.CompletedProcess:
    """Cosy is a USER unit. One function so the scope is stated in one place."""
    return _systemctl_user(list(args))


def cosy_server_alive() -> bool:
    """Is a cosy_server.py process running, healthy or not?

    The health probe is not enough on its own: a Cosy that is loading, or wedged
    with its weights still resident, answers nothing while holding the VRAM. It
    is exactly that window that used to produce a twin.
    """
    try:
        out = subprocess.run(["pgrep", "-f", "cosy_server.py"],
                             capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return False
    return bool(out.stdout.strip())


def ensure_cosy_up(why: str = "") -> bool:
    """The ONLY way this script starts Cosy. Never starts a second one.

    Order matters: an already-running server is waited for, never restarted --
    a restart beside a resident Cosy is the collision, because the new process
    profiles VRAM while the old one still holds it.
    """
    if http_ok(f"{COSY_URL}/health"):
        return True
    if cosy_server_alive():
        print(f"cosy is running but not answering yet{' (' + why + ')' if why else ''}"
              " — waiting, NOT starting a second one")
        return wait_http(f"{COSY_URL}/health", timeout=240, label="cosy :7789")
    got = wait_vram(COSY_NEED_GIB, timeout=120)
    if got is not None and got < COSY_NEED_GIB:
        print(f"free={got:.1f} GiB < Cosy's {COSY_NEED_GIB} GiB preflight — "
              "starting anyway, but expect its own refusal", file=sys.stderr)
    proc = _systemctl_cosy(["start", COSY_UNIT])
    if proc.returncode != 0:
        print(f"start cosy: {proc.stderr.strip() or proc.stdout.strip()}", file=sys.stderr)
        return False
    return wait_http(f"{COSY_URL}/health", timeout=240, label="cosy :7789")


def park_cosy() -> str:
    """Stop Cosy and WAIT for the card to actually give the memory back.

    A systemd stop returns when the process is reaped, but the driver frees
    lazily; returning early is what makes the next start fail its preflight.
    """
    print("parking turbo-voice via systemd stop (USER unit)")
    proc = _systemctl_cosy(["stop", COSY_UNIT])
    if proc.returncode != 0:
        print(f"stop cosy: {proc.stderr.strip() or proc.stdout.strip()}", file=sys.stderr)
    _systemctl_cosy(["reset-failed", COSY_UNIT])
    for _ in range(30):
        if not cosy_server_alive():
            break
        time.sleep(1)
    if cosy_server_alive():
        print("cosy_server.py still alive after stop — not clear", file=sys.stderr)
        return "stop(dirty)"
    return "stop"


def _post(url: str, timeout: float = 180.0) -> bool:
    try:
        req = urllib.request.Request(url, method="POST", data=b"")
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return 200 <= r.status < 300
    except (urllib.error.URLError, TimeoutError, OSError):
        return False


# L1 copies crew weights into host RAM. Disk safetensors ~21.8 GiB; live GPU
# footprint minus KV is ~25 GiB. Leave 8 GiB host after the copy so we do
# not spill onto the swapfile (the 2026-07-11 crawl).
CREW_L1_NEED_GIB = float(os.environ.get("KREW_CREW_L1_NEED_GIB", "32"))
HOST_RAM_FLOOR_GIB = float(os.environ.get("KREW_RAM_FLOOR_GIB", "8"))
COMFY_SETTLE_SEC = float(os.environ.get("KREW_COMFY_SETTLE_SEC", "3"))
# Wall-clock budget for the WHOLE park step (vLLM /sleep?level=1 or the
# systemd-stop fallback) when a render card parks a brain. Park is a
# preflight before the submit's own 6-minute Comfy-wait, and the unit's
# TimeoutStopSec=45 is the backstop below it — a park that cannot finish
# inside this budget must fail the submit fast, not hang it
# (t_4a52e0cb, 2026-09-12). The clamps keep a typo'd, zeroed, or absurd
# env value from taking down every krew-mode subcommand at import or
# silently defeating the deadline.
PARK_STEP_BUDGET_SEC = max(
    1.0, min(float(os.environ.get("KREW_PARK_STEP_BUDGET_SEC", "60")), 600.0)
)


def host_ram_available_gib(meminfo: Optional[str] = None) -> Optional[float]:
    """MemAvailable in GiB. None if unread."""
    text = meminfo
    if text is None:
        try:
            text = Path("/proc/meminfo").read_text(encoding="utf-8")
        except OSError:
            return None
    for line in text.splitlines():
        if line.startswith("MemAvailable:"):
            parts = line.split()
            if len(parts) >= 2:
                return int(parts[1]) / (1024.0 * 1024.0)
    return None


def ram_ok_for_crew_l1() -> bool:
    avail = host_ram_available_gib()
    if avail is None:
        return False
    return avail >= CREW_L1_NEED_GIB + HOST_RAM_FLOOR_GIB


def sleep_available(base: str) -> bool:
    return http_ok(f"{base}/is_sleeping")


def engine_is_sleeping(base: str) -> bool:
    try:
        with urllib.request.urlopen(f"{base}/is_sleeping", timeout=5) as r:
            return bool(json.loads(r.read().decode()).get("is_sleeping"))
    except (urllib.error.URLError, TimeoutError, OSError, json.JSONDecodeError):
        return False


def ops_sleep_available() -> bool:
    return sleep_available(OPS_URL)


def crew_is_sleeping() -> bool:
    return engine_is_sleeping(CREW_URL)


def park_unit(name: str) -> str:
    """Stop a brain, or L1-sleep when /is_sleeping exists and RAM can hold it.

    Crew L1 is Beast/emergency only (native 0.27.1). Canonical Render parks
    ops via systemd stop — never standing sleep-mode on ops. Never L2.
    """
    if name in NEVER_PARK:
        raise RuntimeError(f"refusing to park {name}")
    if name == "crew":
        hold_crew_park()
    if name == "ops":
        hold_units(OPS_UNIT)
    base = CREW_URL if name == "crew" else OPS_URL if name == "ops" else ""
    # Wall-clock deadline for the WHOLE park step: the /sleep?level=1 POST
    # used to carry its own 180 s timeout and the systemd-stop fallback another
    # 180 s, so one park could hold a render card for 6 minutes with no error
    # (2026-09-12 t_4a52e0cb: the submit hung in the park step, no timeout).
    # Park is a preflight; the unit's TimeoutStopSec=45 is the backstop below
    # it, so cap the whole park at ~60 s and fail the submit fast.
    deadline = time.time() + PARK_STEP_BUDGET_SEC
    if base and sleep_available(base):
        if name == "crew" and not ram_ok_for_crew_l1():
            print(
                "crew L1 skipped — host RAM too tight "
                f"(need {CREW_L1_NEED_GIB:.0f}+{HOST_RAM_FLOOR_GIB:.0f} GiB)",
                file=sys.stderr,
            )
        else:
            print(f"parking {name} via vLLM /sleep?level=1")
            # Give the sleep POST the majority of the budget, but always
            # RESERVE the remainder for the systemd-stop fallback: if the
            # POST hangs the whole budget the unit can never actually be
            # parked (the stop would have 0 s). 60/40 split keeps the stop
            # realistic even when sleep barely misses (t_4a52e0cb).
            sleep_budget = max(1.0, (deadline - time.time()) * 0.6)
            if _post(
                f"{base}/sleep?level=1",
                timeout=sleep_budget,
            ):
                return "sleep"
            print(f"{name} /sleep failed — falling back to systemd stop", file=sys.stderr)
    print(f"parking {name} via systemd stop")
    # Call stop_unit with a single positional arg: the 2026-09-12 park tests
    # monkeypatch stop_unit with a name-only lambda (the harness contract), so
    # a timeout keyword here breaks the harness. park_unit's wall-clock
    # budget is enforced by the _systemctl_user timeout INSIDE stop_unit
    # (default 180 s, clamped by the unit's TimeoutStopSec=45 backstop) plus
    # the render-submit outer 600 s wall — the deadline guard below still
    # catches a park that burned its budget before reaching the stop
    # (t_4a52e0cb: the unbounded hang; the bounded fallback is the stop).
    if time.time() < deadline:
        try:
            stop_unit(name)
        except subprocess.TimeoutExpired:
            print(
                f"park {name}: systemd stop exceeded its bounded timeout — "
                "ops may be half-parked; run `python3 scripts/krew-mode normal` "
                "to restore before retrying.",
                file=sys.stderr,
            )
            raise RuntimeError(
                f"park {name}: systemd stop timed out (bounded) — "
                "ops may be parked; run `krew-mode normal`"
            )
    else:
        print(
            f"park {name}: budget ({PARK_STEP_BUDGET_SEC:.0f} s) exhausted "
            "before systemd stop — refusing to park silently",
            file=sys.stderr,
        )
        raise RuntimeError(f"park {name} exceeded {PARK_STEP_BUDGET_SEC:.0f} s budget")
    return "stop"


def thaw_unit(name: str) -> str:
    """Wake a sleeper from RAM, or systemd start if there is no copy.

    Call after Comfy is gone and VRAM has settled. /wake_up wedge → restart.
    """
    base = CREW_URL if name == "crew" else OPS_URL if name == "ops" else ""
    if base and engine_is_sleeping(base):
        print(f"thawing {name} via /wake_up")
        if _post(f"{base}/wake_up", timeout=240):
            if name == "crew":
                release_crew_hold()
            if name == "ops":
                release_units(OPS_UNIT)
            return "wake"
        print(f"{name} /wake_up failed — systemd restart", file=sys.stderr)
        # Release before restart: start-crew.sh exits 0 while crew.service is
        # still on the hold, and Restart=on-failure will not revive it.
        if name == "crew":
            release_crew_hold()
        if name == "ops":
            release_units(OPS_UNIT)
        proc = _systemctl_user(["restart", f"{name}.service"])
        if proc.returncode != 0:
            raise RuntimeError(f"{name} restart failed")
        return "restart"
    print(f"waking {name} via systemd start")
    if name == "crew":
        release_crew_hold()
    if name == "ops":
        release_units(OPS_UNIT)
    start_unit(name)
    return "start"


def stop_unit(name: str, timeout: float | None = None) -> None:
    if name in NEVER_PARK:
        raise RuntimeError(f"refusing to park {name}")
    # The stop itself gets the caller's bounded timeout. The reset-failed
    # cleanup is a best-effort bookkeeping call — bound it to a short fixed
    # cap so a wedged D-Bus on reset-failed cannot push the park step past
    # its wall-clock deadline (t_4a52e0cb: the unbounded 180 s default here
    # could add 180 s on top of a bounded stop and defeat the whole budget).
    proc = _systemctl_user(["stop", f"{name}.service"], timeout=timeout)
    if proc.returncode != 0:
        print(f"stop {name}: {proc.stderr.strip() or proc.stdout.strip()}", file=sys.stderr)
    # Hermes gateways often exit non-zero on SIGTERM → failed, not inactive.
    # Leave-Render start is then noisy; --failed lists sleepers as crashes.
    _systemctl_user(["reset-failed", f"{name}.service"], timeout=10)


def start_unit(name: str) -> None:
    proc = _systemctl_user(["start", f"{name}.service"])
    if proc.returncode != 0:
        raise RuntimeError(
            f"start {name} failed: {proc.stderr.strip() or proc.stdout.strip()}"
        )


def wait_vram(
    need: float, timeout: float = 90.0, *, extend: float = 0.0
) -> Optional[float]:
    """Wait for free GiB. Shortfall warns and optionally waits longer — not a hard refuse.

    Abort restore on comfy_up(), not on this number (MPS fraction trap).
    """
    deadline = time.time() + timeout
    last: Optional[float] = None
    while time.time() < deadline:
        last = free_vram_gib()
        if last is not None and last >= need:
            return last
        time.sleep(2)
    if last is not None and last >= need:
        return last
    if extend > 0 and (last is None or last < need):
        print(
            f"VRAM shortfall free={last} want {need:.0f} GiB — waiting longer",
            file=sys.stderr,
        )
        extra = time.time() + extend
        while time.time() < extra:
            last = free_vram_gib()
            if last is not None and last >= need:
                return last
            time.sleep(2)
    return last


def wait_http(url: str, timeout: float = 600.0, label: str = "") -> bool:
    deadline = time.time() + timeout
    while time.time() < deadline:
        if http_ok(url):
            return True
        print(f"waiting {label or url} ({int(deadline - time.time())}s left)")
        time.sleep(2)
    return False


def comfy_up() -> bool:
    return http_ok(f"{COMFY_URL}/system_stats")


# UP IS NOT BUSY, AND THE WAY HOME NEEDS BUSY (2026-09-21).
#
# `comfy_up()` is a liveness probe — /system_stats answers whenever ComfyUI is
# running at all. `flag_home_due` was asking it as if it meant "a render is in
# flight", so while Comfy was merely INSTALLED AND UP the flag could never come
# home: `maybe_bring_flag_home` never reached even its first tick, and the
# counter file was never written.
#
# It bit on the night it was most likely to: M&S card t_3aefcb5c ran
# `krew-mode render turbo` to swap Comfy v0.36.0 -> v0.37.0, blew its
# iteration budget (80/80, twice) before step 5's `krew-mode normal`, and left
# behind exactly the thing that pins the gate shut — a freshly started Comfy.
# Flag latched at 14:07, `occupancy flag render -> keep` every two minutes, ops
# and Crissa's gateway down with it.
#
# So the gate asks the QUEUE. Anything running or pending is a real render and
# the flag is honest; an empty queue on a live Comfy is not a reason to keep the
# house in Render. A Comfy that is up but cannot answer /queue is treated as
# BUSY — the same fail-safe direction the old probe had, so a broken endpoint
# can never cut a running take off at the knees.
#
# KREW_FLAG_HOME_COMFY_BUSY=0 goes back to the liveness probe (and back to the
# latch).
FLAG_HOME_COMFY_BUSY = os.environ.get(
    "KREW_FLAG_HOME_COMFY_BUSY", "1").strip().lower() not in ("0", "false", "no", "off")


# How long "unknown" may keep the flag in Render. Unreadable /queue means BUSY (see below),
# and that is right for a blip — but it must not be right forever, or a Comfy that is alive
# on the socket and too sick to answer is a permanent latch with no owner and no alarm. A
# swap-thrashing or OOM-wedged Comfy is exactly that shape, and the house has already sat in
# Render for three hours once (09-21 14:07-17:00) with ops and Crissa down.
COMFY_UNKNOWN_MAX_S = float(os.environ.get("KREW_COMFY_UNKNOWN_MAX_S", "900") or 900)
COMFY_UNKNOWN_STATE = Path(os.environ.get("KREW_COMFY_UNKNOWN_STATE")
                           or (HERMES / "comfy-unknown-since.json"))


def _comfy_unknown_expired(now: float | None = None) -> bool:
    """True once /queue has been unreadable for longer than COMFY_UNKNOWN_MAX_S.

    First unreadable tick records the time and returns False (a blip is busy). A readable
    tick clears it. A WRITE FAILURE here must not create the latch it exists to break, so
    an unwritable state file degrades to "not expired" — busy, the safe side — and says so.
    """
    now = time.time() if now is None else now
    try:
        since = float(json.loads(COMFY_UNKNOWN_STATE.read_text()).get("since") or 0)
    except (OSError, ValueError, AttributeError):
        since = 0.0
    if not since:
        try:
            COMFY_UNKNOWN_STATE.parent.mkdir(parents=True, exist_ok=True)
            COMFY_UNKNOWN_STATE.write_text(json.dumps({"since": now}) + "\n")
        except OSError as e:
            print(f"comfy_busy: cannot record the unknown clock ({type(e).__name__}) -> staying busy")
        return False
    return (now - since) > COMFY_UNKNOWN_MAX_S


def _comfy_unknown_clear() -> None:
    try:
        COMFY_UNKNOWN_STATE.unlink()
    except OSError:
        pass


def comfy_busy() -> bool:
    """Is Comfy actually working? (running or pending queue entries.)

    False when Comfy is down — nothing is rendering on a dead Comfy.
    True when it is up but /queue cannot be read or parsed: unknown is not a
    licence to end someone's render — but only until COMFY_UNKNOWN_MAX_S, because
    "unknown" held forever is how the flag latches with nobody owning it.
    """
    if not comfy_up():
        _comfy_unknown_clear()
        return False
    try:
        with urllib.request.urlopen(f"{COMFY_URL}/queue", timeout=2.0) as r:
            if not (200 <= r.status < 300):
                return not _comfy_unknown_expired()
            q = json.loads(r.read().decode("utf-8", "replace") or "{}")
    except (urllib.error.URLError, TimeoutError, OSError, ValueError) as e:
        if _comfy_unknown_expired():
            print(f"comfy_busy: /queue unreadable ({type(e).__name__}) for more than "
                  f"{int(COMFY_UNKNOWN_MAX_S)}s -> no longer treating as busy")
            return False
        print(f"comfy_busy: /queue unreadable ({type(e).__name__}) -> treating as busy")
        return True
    _comfy_unknown_clear()
    try:
        return bool(q.get("queue_running")) or bool(q.get("queue_pending"))
    except AttributeError:
        return True


def _comfy_port() -> int:
    tail = COMFY_URL.rsplit(":", 1)[-1]
    try:
        return int(tail.split("/")[0])
    except ValueError:
        return 8188


def _proc_cmdline(pid: int) -> str:
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return ""
    return raw.replace(b"\x00", b" ").decode("utf-8", "replace").strip()


def _is_krew_comfy(pid: int, cmdline: Optional[str] = None) -> bool:
    """True for the house python Comfy, not a bash -c that mentions the path."""
    if pid <= 1:
        return False
    cmd = cmdline if cmdline is not None else _proc_cmdline(pid)
    if COMFY_MAIN not in cmd:
        return False
    first = (cmd.split() or [""])[0]
    return Path(first).name.startswith("python")


def _pids_listening_port(port: int) -> list[int]:
    hexport = f"{port:04X}"
    inodes: set[str] = set()
    for tcp in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            text = Path(tcp).read_text()
        except OSError:
            continue
        for line in text.splitlines()[1:]:
            parts = line.split()
            if len(parts) < 10:
                continue
            if parts[3] != "0A":
                continue
            if parts[1].rsplit(":", 1)[-1].upper() != hexport:
                continue
            inodes.add(parts[9])
    if not inodes:
        return []
    found: list[int] = []
    proc = Path("/proc")
    try:
        dirs = list(proc.iterdir())
    except OSError:
        return []
    for d in dirs:
        if not d.name.isdigit():
            continue
        fd_dir = d / "fd"
        try:
            fds = list(fd_dir.iterdir())
        except OSError:
            continue
        for fd in fds:
            try:
                target = os.readlink(fd)
            except OSError:
                continue
            if target.startswith("socket:[") and target[8:-1] in inodes:
                found.append(int(d.name))
                break
    return found


def live_comfy_pids() -> list[int]:
    """House Comfy PIDs: pid file, then pgrep main.py, then :8188 listener."""
    seen: list[int] = []

    def add(pid: int) -> None:
        if pid > 1 and pid not in seen and _is_krew_comfy(pid):
            seen.append(pid)

    if COMFY_PID.is_file():
        try:
            add(int(COMFY_PID.read_text().strip().splitlines()[0]))
        except (ValueError, OSError, IndexError):
            pass
    try:
        proc = subprocess.run(
            ["pgrep", "-f", COMFY_MAIN],
            capture_output=True,
            text=True,
            timeout=5,
        )
        for line in proc.stdout.splitlines():
            try:
                add(int(line.strip()))
            except ValueError:
                continue
    except (OSError, subprocess.TimeoutExpired):
        pass
    for pid in _pids_listening_port(_comfy_port()):
        add(pid)
    return seen


def remember_comfy_pid(pid: int) -> None:
    if pid <= 1:
        return
    COMFY_PID.parent.mkdir(parents=True, exist_ok=True)
    COMFY_PID.write_text(str(pid) + "\n", encoding="utf-8")


def start_comfy(*, highvram: bool = False) -> int:
    """Launch Comfy. Ordinary Render runs it WITHOUT --highvram because crew + Cosy share the
    card there (~43 GiB free) - not a policy: high-VRAM is wanted (the User 09-29) and the
    heavy-render window (crew off) passes highvram=True. systemd unit is the empty-card path.
    A Comfy already up is reused as it is: stop it first to change the flag."""
    if comfy_up():
        pids = live_comfy_pids()
        if pids:
            remember_comfy_pid(pids[0])
            return pids[0]
        return 0
    env = os.environ.copy()
    # Comfy outlives the card that entered Render (render-submit sets HERMES_KANBAN_TASK for its
    # krew-mode call): it must not carry a card's id, or a leftover-process reaper keyed on that id
    # could take a live render for a worker's leftover (adversarial review 2026-09-19, item 5).
    # A worker also carries PYTHONPATH into the Hermes py3.14 tree. Comfy is
    # py3.12 and dies on pydantic_core when that path is inherited (2026-10-08).
    for k in (
        "HERMES_KANBAN_TASK", "HERMES_KANBAN_BOARD", "HERMES_KANBAN_DB",
        "PYTHONPATH", "PYTHONHOME", "VIRTUAL_ENV",
    ):
        env.pop(k, None)
    env["CUDA_MPS_PIPE_DIRECTORY"] = "/run/no-mps-for-comfy"
    env["HF_HOME"] = env.get("HF_HOME", os.path.expanduser("~/.cache/huggingface"))
    env["PYTORCH_CUDA_ALLOC_CONF"] = "expandable_segments:True"
    log = Path(os.environ.get("KREW_COMFY_LOG", "/tmp/krew-comfy-render.log"))
    log.parent.mkdir(parents=True, exist_ok=True)
    fh = log.open("ab")
    cmd = [
        _comfy("python"),
        COMFY_MAIN,
        "--port",
        str(_comfy_port()),
        "--listen",
        "127.0.0.1",
    ]
    if highvram:
        cmd.append("--highvram")
    # ITS OWN SCOPE (the owner 2026-09-16: "she is non responsive in render", "no
    # render in CP at all now"). The Control Panel's Render button runs this
    # script from inside voiceonly-home.service; start_new_session leaves the
    # session but not the cgroup, so Comfy lived in the panel server's cgroup
    # and a restart of :8099 (14:42:55) SIGKILLed it without a line in its log.
    # The ear then read Comfy down and never handed a Render turn to Lila, and
    # the CP hid Render. systemd-run --scope execs in place: same pid, own
    # cgroup. KREW_COMFY_SCOPE=0 is the old launch.
    if os.environ.get("KREW_COMFY_SCOPE", "1") != "0" and shutil.which("systemd-run"):
        cmd = ["systemd-run", "--user", "--scope", "--quiet", "--collect",
               "--unit", f"krew-comfy-{int(time.time())}"] + cmd
    proc = subprocess.Popen(
        cmd,
        cwd=_comfy("root"),
        env=env,
        stdout=fh,
        stderr=fh,
        start_new_session=True,
    )
    remember_comfy_pid(proc.pid)
    return proc.pid


def thaw_after_comfy() -> str:
    """How we will bring crew back after Comfy dies. Wake if L1 copy is live."""
    return "wake" if crew_is_sleeping() else "restart"


def _kill_pid(pid: int) -> None:
    if pid <= 1:
        return
    try:
        os.killpg(pid, signal.SIGKILL)
    except ProcessLookupError:
        return
    except (PermissionError, OSError):
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            return


def stop_comfy() -> bool:
    """SIGKILL house Comfy. True when :8188 is down. Unlink pid file only then.

    Museum systemd `comfyui` is a last try, not the SoT — Render starts a
    house Popen of COMFY_MAIN.
    """
    for pid in live_comfy_pids():
        _kill_pid(pid)
    subprocess.run(
        ["sudo", "-n", "systemctl", "kill", "-s", "SIGKILL", "comfyui"],
        text=True,
        capture_output=True,
        timeout=30,
    )
    subprocess.run(
        ["sudo", "-n", "systemctl", "stop", "comfyui"],
        text=True,
        capture_output=True,
        timeout=60,
    )
    time.sleep(float(os.environ.get("KREW_COMFY_KILL_SETTLE_SEC", "3")))
    deadline = time.time() + 45
    while time.time() < deadline and comfy_up():
        for pid in live_comfy_pids():
            _kill_pid(pid)
        time.sleep(1)
    if comfy_up():
        return False
    COMFY_PID.unlink(missing_ok=True)
    return True


def ops_fallback_ready() -> bool:
    """Sleepers may wake without crew only if ops :8000 is serving and Crissa pins ops."""
    return http_ok(f"{OPS_URL}/v1/models") and count_live_ops_pins() > 0


def maybe_wake_sleepers_after_crew_fail(
    *, leaving_render: bool, need_wake_sleepers: bool
) -> bool:
    """True if we woke. Never wake onto a dead :8005 with no ops fallback."""
    if not (leaving_render or need_wake_sleepers):
        return False
    if ops_fallback_ready():
        print("leaving render — wake Ada/Crissa on ops fallback")
        wake_render_rest()
        transferring_to_crissa()
        return True
    if comfy_up():
        print(
            "Comfy still up — SIGKILL leftover :8188 then krew-mode normal",
            file=sys.stderr,
        )
    else:
        print("crew :8005 did not serve — krew-mode normal", file=sys.stderr)
    return False


def cmd_status() -> int:
    free = free_vram_gib()
    mode = read_mode()
    state = read_state()
    voice = "on" if voice_is_on() else "off"
    free_s = f"{free:.1f} GiB" if free is not None else "unread"
    print(f"mode     {mode}")
    print(f"flag     {MODE_FILE}")
    print(f"voice    {voice}")
    print(f"free     {free_s}")
    print(f"comfy    {'up' if comfy_up() else 'down'}")
    try:                       # where it is, and who said so (the Wall's render.json, krew's key, or the default)
        import krew_comfy
        root, src = krew_comfy.where("root")
        print(f"comfy at {root} ({src})")
    except Exception:  # noqa: BLE001
        pass
    kiosk = False
    try:
        import glass_mode
        kiosk = glass_mode.is_active(glass_mode.BRAVE)
    except Exception:
        pass
    if kiosk and mode == "render":
        print("kiosk    up · second glass")
    elif kiosk:
        print("kiosk    up")
    else:
        print("kiosk    parked in ZOS Desktop ON")
    print(f"ops      {'up' if http_ok(f'{OPS_URL}/v1/models') else 'down'}")
    if crew_is_sleeping():
        print("crew     sleeping (L1 RAM)")
    else:
        print(f"crew     {'up' if http_ok(f'{CREW_URL}/v1/models') else 'down'}")
    print(f"lane     {lane_brain(mode)}")
    print(f"cosy     {'up' if http_ok(f'{COSY_URL}/health') else 'down'}")
    print(f"presence {'up' if http_ok(f'{PRESENCE_URL}/v1/presence') else 'down'}")
    print(f"audio8   {'up' if http_ok(f'{ASR_URL}/health') else 'down'}")
    if ADA_CONFIG.is_file():
        pin = read_kanban_decomposer(ADA_CONFIG.read_text(encoding="utf-8"))
        want = decomposer_for_occupancy(mode)
        if pin:
            tag = "crew" if pin[0] == "crew" else "ops"
            drift = "" if pin[0] == want[0] else f"  WANT {want[0]}"
            print(f"decomposer {pin[0]} {pin[1]} ({tag}){drift}")
    leftover = count_live_ops_pins()
    if mode == "beast":
        print(f"ops-pins leftover_files={leftover}  want 0 (Crissa on Unsloth crew)")
    else:
        print(f"ops-pins files_with_ops={leftover}  (Crissa mouth on 27B)")
    if state:
        print(f"recipe   {state.get('recipe', '-')}")
        print(f"parked   {','.join(state.get('parked') or []) or '-'}")
    for path, other in sandbox_flag_disagreements(mode):
        print(f"RED      sandbox flag {path} says {other!r} (house says {mode!r}) — delete it; "
              "the house tree is the passwd home")
    print("recipes  " + ", ".join(f"{k}={v['need_gib']:.0f}G" for k, v in RECIPES.items()))
    return 0


def sandbox_flag_disagreements(mode: str) -> list[tuple[Path, str]]:
    """Leftover `profiles/*/home/.hermes/krew-gpu-mode` copies that disagree.

    Before 40a2925d (2026-09-13 01:02) a kanban worker's krew-mode wrote its
    flag under HOME=profiles/<who>/home; Vera's said `render` for hours while
    the house said `normal`. Nothing reads them any more, but a stale copy is
    a trap for the next reader that follows $HOME. Report; do not rewrite.
    """
    out: list[tuple[Path, str]] = []
    for path in sorted((HOUSE / "profiles").glob("*/home/.hermes/krew-gpu-mode")):
        try:
            other = (path.read_text().splitlines() or [""])[0].strip().lower()
        except OSError:
            continue
        if other != mode:
            out.append((path, other))
    return out


def abort_ear_mouth() -> None:
    try:
        req = urllib.request.Request(
            ABORT_URL,
            data=b"{}",
            method="POST",
            headers={"Content-Type": "application/json"},
        )
        urllib.request.urlopen(req, timeout=2)
    except Exception as e:
        print(f"ear abort skipped: {e}")


def clear_handoff() -> None:
    HANDOFF_FILE.unlink(missing_ok=True)


def wait_handoff_pid(pid: Optional[int], cap: float = 20.0) -> None:
    if not pid:
        return
    deadline = time.time() + cap
    while time.time() < deadline:
        try:
            os.kill(pid, 0)
        except OSError:
            return
        time.sleep(0.15)



# KREW SETTINGS (2026-10-10): every per-machine value below reads $KREW_HOME/krew.yaml `gpu:` first (the file
# config/krew.example.yaml documents, with the reference install's values as the defaults written here), then the
# environment switch the reference install used, renamed KREW_*. The unit names come from $KREW_HOME/services.json
# (crew/lib/krew_services.py): the row named `ops` / `crew` / `voice` names the unit this switch parks and wakes;
# no row = the reference install's `<name>.service`.
def _krew_home() -> Path:
    return Path(os.path.expanduser(os.environ.get("KREW_HOME") or "~/.krew"))


def _krew_gpu_cfg() -> dict:
    """The `gpu:` section of krew.yaml, {} without a file or a YAML reader (every key has a default)."""
    cfg = Path(os.path.expanduser(os.environ.get("KREW_CONFIG") or str(_krew_home() / "krew.yaml")))
    try:
        text = cfg.read_text(encoding="utf-8")
    except OSError:
        return {}
    try:
        lib = str(Path(__file__).resolve().parents[1] / "lib")
        if lib not in sys.path:
            sys.path.insert(0, lib)
        import krew_yaml
        data = krew_yaml.safe_load(text) or {}
    except Exception:  # noqa: BLE001  (no YAML reader, or a file that does not parse: the defaults apply)
        return {}
    sec = data.get("gpu") if isinstance(data, dict) else None
    return sec if isinstance(sec, dict) else {}


GPU_CFG = _krew_gpu_cfg()


def _cfg_path(key: str, env: str, default: Path) -> Path:
    v = os.environ.get(env) or str(GPU_CFG.get(key) or "")
    return Path(os.path.expanduser(v)) if v.strip() else default


def _row(name: str) -> dict:
    """The services.json row by that name ({} without a list, a row, or krew_services)."""
    try:
        lib = str(Path(__file__).resolve().parents[1] / "lib")
        if lib not in sys.path:
            sys.path.insert(0, lib)
        import krew_services
        for row in krew_services.load():          # approved rows only: an unapproved row is never acted on
            if row.get("name") == name:
                return row
    except Exception:  # noqa: BLE001
        pass
    return {}


def _unit_for(name: str, default: str) -> str:
    """The unit behind a services.json row (by name; KREW_UNIT_<NAME> overrides), else `default`."""
    env = os.environ.get(f"KREW_UNIT_{name.upper()}")
    if env:
        return env if "." in env else env + ".service"
    return str(_row(name).get("unit") or "") or default


def _url_for(name: str, env: str, port: int) -> str:
    """http://127.0.0.1:<the row's port> (the reference install's port when there is no row); `env` overrides."""
    got = os.environ.get(env)
    if got:
        return got.rstrip("/")
    try:
        port = int(_row(name).get("port") or port)
    except (TypeError, ValueError):
        pass
    return f"http://127.0.0.1:{port}"



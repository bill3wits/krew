def _caps_from_cfg(table: dict, key: str) -> dict:
    """krew.yaml gpu.<key>: {mode: [a, b]} laid over the reference install's table (a bad row is ignored)."""
    got = GPU_CFG.get(key)
    if not isinstance(got, dict):
        return table
    out = dict(table)
    for mode, pair in got.items():
        try:
            a, b = pair
            out[str(mode)] = (int(a), int(b))
        except (TypeError, ValueError):
            continue
    return out



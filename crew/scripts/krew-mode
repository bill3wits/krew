    """No spoken handoff (the owner 2026-09-14: "i want no scripted announcement
    of render mode. Lila should come on the Wall now for continual service").
    Lila's plate on the glass is the change; nothing is said."""
    return None


def rollback_render_handoff() -> None:
    clear_handoff()
    print("render handoff rolled back")


# RENDER: LILA TAKES CRISSA'S PLACE ON THE GLASS (the owner 2026-09-13: "since crissa
# goes during render, and we have Lila loops now, we put her up where crissa is
# now ... the Control Panel for interaction becomes a choice"). Both glasses
# draw :8100, so her rack (lila-host-intake) plays there and the dock and the
# folders stay the User's. 0 = the old pin: the studio panel on the kiosk.
RENDER_LILA_HOST = os.environ.get("KREW_RENDER_LILA_HOST", "1").strip().lower() not in ("0", "false", "no", "off")
# how long Render entry waits for the restarted host gateway to list its served profiles before judging Lila
LILA_SERVE_WAIT_S = float(os.environ.get("KREW_LILA_SERVE_WAIT_S", "30"))
CONDUCTOR_URL = (os.environ.get("KREW_CONDUCTOR_URL") or CRISSA_PLAYER).rstrip("/")   # the Wall's player
SESSION_OPEN_URL = ABORT_URL.rsplit("/v1/", 1)[0] + "/v1/session/open"
# The first-boot fade to Lila (init_wizard.host_play), copied, not imported:
# the wizard paplays onboarding audio, and krew-mode sits below it.
HOST_CURTAIN_HUB = "crissa_intro_hd"
HOST_CURTAIN_LEAVE = "crissa-intro-hd-leave"
HOST_CURTAIN_LEAVES = {HOST_CURTAIN_HUB: HOST_CURTAIN_LEAVE, "crissa_intro": "crissa-intro-leave"}
HOST_HUB = "lila_listen"
HOST_ENTER_KEY = "lila-listen-enter"
HOST_LISTEN_KEY = "lila-reg-listen"
HOST_WORK_KEY = "lila-work"
HOST_ENTER_SEC = 1.0


def _post_json(url: str, body: dict, timeout: float = 3.0) -> dict:
    req = urllib.request.Request(
        url, data=json.dumps(body).encode(), method="POST",
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode() or "{}")
    except urllib.error.HTTPError as e:      # 409 = refused; the body says why
        try:
            return json.loads(e.read().decode() or "{}")
        except Exception:
            return {"ok": False, "error": f"HTTP {e.code}"}
    except Exception as e:
        return {"ok": False, "error": f"{type(e).__name__}: {e}"[:120]}


def conductor_hub() -> str:
    """Where :8100 has her now ("" when it is not answering)."""
    try:
        with urllib.request.urlopen(f"{CONDUCTOR_URL}/v1/state", timeout=2.0) as r:
            return str(json.loads(r.read().decode()).get("hub") or "")
    except Exception:
        return ""


def lila_on_glass() -> bool:
    """Lila holds :8100: her listen hub, or a lila-* clip camped on Crissa's `down`
    (the Render enter plays lila-work there with stay, so the hub alone reads
    Crissa's desk — the owner 2026-09-14 "Standard never switched back to Crissa")."""
    try:
        with urllib.request.urlopen(f"{CONDUCTOR_URL}/v1/state", timeout=2.0) as r:
            s = json.loads(r.read().decode())
    except Exception:
        return False
    return str(s.get("hub") or "") == HOST_HUB or str(s.get("now") or "").startswith("lila-")


def render_host_enter() -> List[str]:
    """Lila onto the glass. Default is her working loop on `down` (same
    hub as Crissa's `work`). Curtain and listen-plate walk home to the desk
    first. A forced play from any other hub would be a hard cut."""
    asked: List[str] = []
    hub = conductor_hub()
    if hub in HOST_CURTAIN_LEAVES:
        _post_json(f"{CONDUCTOR_URL}/v1/play", {"key": HOST_CURTAIN_LEAVES[hub], "force": True, "who": "krew-mode"})
        asked.append(HOST_CURTAIN_LEAVES[hub])
        time.sleep(HOST_ENTER_SEC)
        hub = "down"
    if hub == HOST_HUB:
        _post_json(f"{CONDUCTOR_URL}/v1/play", {"key": "lila-listen-leave", "force": True, "who": "krew-mode"})
        asked.append("lila-listen-leave")
        time.sleep(HOST_ENTER_SEC)
        hub = "down"
    if hub not in ("down", ""):
        _post_json(f"{CONDUCTOR_URL}/v1/play", {"key": "rest", "force": True, "who": "krew-mode"})
        asked.append("rest")
        time.sleep(HOST_ENTER_SEC)
    # Default is Lila's working pose on the desk hub (same as Crissa's `work`).
    r = _post_json(
        f"{CONDUCTOR_URL}/v1/play",
        {"key": HOST_WORK_KEY, "force": True, "stay": True, "who": "krew-mode"},
    )
    asked.append(HOST_WORK_KEY)
    print(f"lila on the glass: {' → '.join(asked)} (hub was {hub or '?'}, play {'ok' if r.get('ok') else r.get('error')})")
    return asked


def render_host_leave() -> None:
    """Lila's plate dissolves home to Crissa's desk: bring_home walks the leave
    slide, which lives in the kit."""
    r = _post_json(f"{CONDUCTOR_URL}/v1/home", {"by": "render"})
    print(f"lila off the glass: home {'taken' if r.get('taken') else r.get('why') or r.get('error')}")


def _crissa_gateway_ready() -> bool:
    """True when occupancy is not a park and hermes-crissa-gateway is active."""
    try:
        from crissa_gateway import crissa_gateway_up
        return bool(crissa_gateway_up())
    except Exception:
        return _unit_active("hermes-crissa-gateway.service")


def transferring_to_crissa(*, tries: int = 8, wait_s: float = 2.0, hold_s: float = 0.0) -> bool:
    """Last step of leave-Render. Wait for Crissa's gateway, then home, retry.

    2026-09-16: pin_kiosk_wall ran /v1/home while Render still had her
    gateway down; home declined; idle steal stands aside in Standard; Lila
    toured `lila-work` after occupancy was already normal. This runs after
    wake_render_rest so the gateway start is first. Keeper retries if this
    still loses.
    """
    if not RENDER_LILA_HOST:
        return True
    if not lila_on_glass():
        return True
    print("transferring to Crissa")
    if hold_s > 0:
        time.sleep(hold_s)
    ok = False
    for i in range(max(1, int(tries))):
        if not _crissa_gateway_ready():
            print(f"transfer wait {i + 1}/{tries} — Crissa gateway not up")
        else:
            render_host_leave()
            if not lila_on_glass():
                ok = True
                break
            print(f"transfer retry {i + 1}/{tries} — still Lila on glass")
        if wait_s > 0 and i + 1 < tries:
            time.sleep(wait_s)
    if ok:
        print("transferred to Crissa")
    else:
        print("transfer still Lila — keeper will retry when her gateway recovers")
    return ok


def open_ear_session() -> None:
    """Render starts unpaused (the owner 2026-09-13: "start render unpaused and let
    time put it back"): the PAUSED chip's own call; the ear's idle expiry
    pauses it again. The mic stays wherever the CP left it."""
    r = _post_json(SESSION_OPEN_URL, {}, timeout=2.0)
    print(f"ear session open {'ok' if r.get('ok') else 'skipped: ' + str(r.get('error'))}")


def pin_render_welcome(handoff_pid: Optional[int] = None) -> None:
    """Lila helm line + still, then Lila onto the glass and the ear unpaused.
    The Control Panel is the User's choice (KREW_RENDER_LILA_HOST=0: the old
    studio-panel pin). HTTP only, no CDP here."""
    wait_handoff_pid(handoff_pid)
    try:
        lib = Path(__file__).resolve().parents[1] / "lib"
        if str(lib) not in sys.path:
            sys.path.insert(0, str(lib))
        from render_studio import welcome_pin

        r = welcome_pin()
        if r.get("welcome") or r.get("still"):
            print(f"welcome still={r.get('welcome') or r.get('still')}")
        if r.get("say"):
            print(f"lila orient: {r.get('say')}")
    except Exception as e:
        print(f"welcome pin skipped: {e}")
    if RENDER_LILA_HOST:
        render_host_enter()
        open_ear_session()
        # Lila's gateway: under the one host gateway she is served already (the 09-27 cutover), and
        # `hermes -p lila gateway start` on a served profile answers "failed to start" (the User
        # 2026-10-08) - so the start happens only when she is not served, through the topology
        # layer, never by a per-profile unit name.
        try:
            topo = _gateway_topology()
            if topo is not None:
                # Render entry restarts the host (Ada's caps are read at its boot), so for a few seconds the host
                # record has no served list yet: that is the host starting, not Lila parked (the User 2026-10-08).
                deadline = time.time() + LILA_SERVE_WAIT_S
                while not topo.profile_up("lila", unknown=True) and "served_profiles" not in topo.host_record() \
                        and time.time() < deadline:
                    time.sleep(2)
                if topo.profile_up("lila", unknown=True):
                    print("lila gateway: served by the host gateway")
                elif "served_profiles" not in topo.host_record():
                    print("lila gateway: the host gateway is still starting; she is served when it is")
                elif topo.unpark("lila"):
                    print("lila gateway: unparked on the host gateway")
                else:
                    print("lila gateway: unpark failed")
            else:
                import hermes_topology as _ht
                start_unit(_ht.unit_for("lila").removesuffix(".service"))
                print("wake lila's gateway")
        except Exception as e:
            print(f"lila gateway: {e}")
        # THE USER STAYS WHERE THEY ARE (the owner 2026-09-16: "simply leave the
        # user on Wall in render mode when the Krew are the one switching.
        # Should feel like BAU just with Lila at the camera … Navigate to CP to
        # see the work"). No CP raise, no kiosk_panel: Lila hosts the glass
        # above; a User who pressed Render on the CP is already on the CP.
        return
    # KREW_RENDER_LILA_HOST=0: Voice-Only has no mouse — studio lives on /panel.
    # HTTP only (EOD: krew-mode must not call CDP). voiceonly-home owns the kiosk.
    try:
        req = urllib.request.Request(
            CRISSA_FEED + "/v1/action",
            data=json.dumps({"action": "kiosk_panel"}).encode(),
            method="POST",
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=8) as resp:
            print(f"kiosk panel {resp.status}")
    except Exception as e:
        print(f"kiosk panel skipped: {e}")


def pin_kiosk_wall() -> None:
    """Leave Render. Lila's plate dissolves home to Crissa's desk; the kiosk goes
    back to the wall only when this Render put the panel on it (the User's CP
    pick), or always under KREW_RENDER_LILA_HOST=0. HTTP, not CDP."""
    pinned = True
    try:
        lib = Path(__file__).resolve().parents[1] / "lib"
        if str(lib) not in sys.path:
            sys.path.insert(0, str(lib))
        from render_studio import leave_render, panel_was_pinned

        pinned = panel_was_pinned()
        leave_render()
    except Exception:
        pass
    if RENDER_LILA_HOST:
        if lila_on_glass():
            print("Lila stays until Crissa's gateway is up — transferring last")
        if not pinned:
            print("kiosk wall skipped — no panel was pinned this Render")
            return
    try:
        req = urllib.request.Request(
            CRISSA_FEED + "/v1/action",
            data=json.dumps({"action": "kiosk_wall"}).encode(),
            method="POST",
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=8) as resp:
            print(f"kiosk wall {resp.status}")
    except Exception as e:
        print(f"kiosk wall skipped: {e}")


def _baseline(which: str, label: str) -> None:
    """Measure the house before / after a mode trip (the User 09-30). Report only and never in the way:
    off unless KREW_BASELINE_HOOKS=1, and any failure here is swallowed. The 'after' is taken by a
    detached child minutes later - the lanes a restore wakes are not back when this command returns."""
    try:
        for lib in (str(Path(__file__).resolve().parents[1] / "lib"), str(Path(__file__).resolve().parents[2] / "janitor")):
            if lib not in sys.path:
                sys.path.insert(0, lib)
        import krew_baseline   # the Janitor's (janitor/krew_baseline.py); absent = no baseline, nothing in the way
        if which == "start":
            krew_baseline.start(label)
        else:
            krew_baseline.end_later(label, float(os.environ.get("KREW_BASELINE_RENDER_SETTLE_S", "420")))
    except Exception:
        pass


def cmd_render(recipe: str, *, dry_run: bool = False) -> int:
    spec = RECIPES.get(recipe)
    if not spec:
        print(f"unknown recipe {recipe!r}; want {sorted(RECIPES)}", file=sys.stderr)
        return 2
    if not dry_run:
        _baseline("start", "render")  # report-only, OFF unless KREW_BASELINE_HOOKS=1 (lib/krew_baseline.py)
    need = float(spec["need_gib"])
    free = free_vram_gib()
    voice = voice_is_on()
    # Credit only brains that are up: a parked ops is worth 0 GiB, and a
    # resident Comfy keeps its ~37 GiB whatever we park (2026-09-13).
    ops_up = (not ops_parked()) and http_ok(f"{OPS_URL}/v1/models")
    crew_up = (not crew_parked()) and (not crew_is_sleeping()) and http_ok(f"{CREW_URL}/v1/models")
    comfy_res = comfy_up()
    plan = park_plan(need, free, voice, ops_up=ops_up, crew_up=crew_up, comfy_resident=comfy_res)
    free_s = f"{free:.1f}" if free is not None else "?"
    print(f"render {recipe} need={need:.0f} GiB free={free_s} voice={'on' if voice else 'off'} "
          f"ops={'up' if ops_up else 'down'} crew={'up' if crew_up else 'down'} comfy={'resident' if comfy_res else 'down'}")
    print(f"plan   {plan['reason']}")
    # park_plan never lists Cosy (Voice ON: never park the mouth).
    # Ops (composer) may park. Do not park Cosy while Voice is on.
    will_park = list(plan["park"])
    if COSY_RENDER_PARK and cosy_server_alive() and not voice:
        will_park.append("turbo-voice")
    print(f"park   {will_park or 'none'}")
    if COSY_RENDER_PARK and cosy_server_alive() and not voice:
        print("       cosy parks in Render: Crissa's gateway is already asleep, "
              "TTS falls back to Audio8 on CPU, and the slice gets ~11 GiB")
    elif voice and cosy_server_alive():
        print("       cosy stays (Voice ON)")
    if dry_run:
        return 0 if plan["ok"] else 1
    capture_pre_render_snapshot()
    if (
        read_mode() == "render"
        and comfy_up()
        and not beast_park_active()
        and ops_parked()
        and (free is None or free >= need)
    ):
        # Ops already down. Do not skip when both 27Bs are still up — that
        # is the starved-Comfy window (measured 2026-09-05: Comfy 550 MiB).
        write_mode("render")
        st = read_state()
        st.update(
            {
                "mode": "render",
                "recipe": recipe,
                "parked": ["ops"],
                "ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
            }
        )
        write_state(st)
        sleep_render_rest()
        print(f"already render recipe={recipe} comfy=:8188")
        brain = lane_brain("render")
        if brain == "none":
            print("exclusive render — both 27Bs parked; Ada sleeps (no live lane)")
        else:
            print(f"render sleep Crissa — Ada dispatches on {brain}, one card")
        pin_render_welcome()
        return 0
    if not plan["ok"]:
        print(plan["reason"], file=sys.stderr)
        return 1
    handoff_pid = speak_crissa_handoff()

    def _fail(msg: str) -> int:
        rollback_render_handoff()
        print(msg, file=sys.stderr)
        return 1

    parked: List[str] = []
    how: List[str] = []
    for unit in plan["park"]:
        how.append(f"{unit}:{park_unit(unit)}")
        parked.append(unit)
    # RENDER IS THE ONE MODE THAT MAY PARK THE VOICE (the owner 2026-09-05).
    # park_plan never lists Cosy -- Voice ON keeps the mouth. Ops (composer)
    # parks in canonical Render. Cosy is different when Voice is OFF: Crissa's
    # gateway is already asleep, so nothing is asking her to speak, and TTS
    # falls back to Audio8 on CPU. KREW_COSY_RENDER_PARK=0 restores the old
    # Voice-OFF Cosy-stay behaviour.
    if COSY_RENDER_PARK and cosy_server_alive() and not voice:
        how.append(f"turbo-voice:{park_cosy()}")
        parked.append("turbo-voice")
    if plan["park"] or "turbo-voice" in parked:
        got = wait_vram(need, timeout=90)
        if (got is None or got < need) and crew_is_sleeping():
            print("L1 did not free enough VRAM — systemd stop crew", file=sys.stderr)
            stop_unit("crew")
            how.append("crew:stop-after-l1")
            got = wait_vram(need, timeout=90)
        if got is None or got < need:
            return _fail(
                f"after park free={got} still < {need:.0f}; not starting Comfy"
            )
        print(f"free now {got:.1f} GiB")
    else:
        got = free
    leaving_off = read_mode() == "off" or off_park_active()
    if leaving_off:
        print("leaving All OS Off for Render — Cosy then ops then Comfy")
        release_off_park()
    leaving_beast = beast_park_active()
    if leaving_beast:
        # Unsloth leftover-fit still owns :8005. Bounce it onto start-crew.sh
        # (dual-27B pin) so the team has a live 27B. Ops is already parked.
        print("leaving beast for Render — keep ops parked, bounce crew to dual-27B pin")
        if "ops" not in parked:
            parked.append("ops")
            how.append("ops:already")
        stop_unit("crew")
        subprocess.run(
            ["docker", "rm", "-f", "crew", "muse-glimmer"],
            capture_output=True,
            timeout=60,
        )
        release_beast_park()
        write_flag("render")
        start_unit("crew")
        if not wait_http(f"{CREW_URL}/v1/models", timeout=900, label="crew :8005"):
            return _fail("crew :8005 did not return /v1/models after Beast")
    elif leaving_off:
        write_flag("render")
    if leaving_off:
        if not ensure_cosy_up("leaving off for render"):
            return _fail("cosy :7789 /health did not return 200")
        if not http_ok(f"{CREW_URL}/v1/models"):
            start_unit("crew")
            if not wait_http(f"{CREW_URL}/v1/models", timeout=900, label="crew :8005"):
                return _fail("crew :8005 did not return /v1/models")
    pid = start_comfy()
    if not wait_http(f"{COMFY_URL}/system_stats", timeout=180, label="comfy :8188"):
        return _fail("Comfy did not come up on :8188")
    keep_render_ops_down()
    if "ops" not in parked:
        parked.append("ops")
        how.append("ops:keep_down")
    write_mode("render")
    write_state(
        {
            "schema": "krew_gpu_mode/v1",
            "mode": "render",
            "recipe": recipe,
            "parked": list(dict.fromkeys(parked)),
            "park_how": how,
            "comfy_pid": pid,
            "need_gib": need,
            "free_gib": got,
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
        }
    )
    sleep_render_rest()
    print(f"mode render recipe={recipe} comfy=:8188 pid={pid or 'already-up'}")
    brain = lane_brain("render")
    if brain == "none":
        print("exclusive render — both 27Bs parked; Ada sleeps (no live lane)")
    else:
        print(f"render sleep Crissa — Ada dispatches on {brain}, one card")
    print("look at the Comfy output folder  — a 200 is not success")
    pin_render_welcome(handoff_pid)
    return 0


def cmd_beast(*, dry_run: bool = False) -> int:
    """Unsloth Qwen3.8-27B as crew :8005. Park ops + Comfy. Cosy + Audio8 stay."""
    prev = read_mode()
    crew_up = http_ok(f"{CREW_URL}/v1/models")
    ops_up = http_ok(f"{OPS_URL}/v1/models")
    cosy_up = http_ok(f"{COSY_URL}/health")
    comfy = comfy_up()
    already = prev == "beast" and not comfy and crew_up and not ops_up
    print(
        f"beast  prev={prev} comfy={'up' if comfy else 'down'} "
        f"ops={'up' if ops_up else 'down'} crew={'up' if crew_up else 'down'} "
        f"cosy={'up' if cosy_up else 'down'}"
    )
    if dry_run:
        return 0
    if already:
        hold_beast_park()
        write_mode("beast")
        if not cosy_up:
            print("already beast — Cosy down, starting it; not tearing Unsloth")
            ensure_cosy_up("already beast")
        print("already beast  crew=:8005 Unsloth Qwen3.8-27B  ops parked")
        return 0
    leaving_off = prev == "off" or off_park_active()
    if leaving_off:
        print("leaving All OS Off for Beast — Cosy then Unsloth crew")
        release_off_park()
    if not stop_comfy():
        print("Comfy still up after beast — stop it by hand", file=sys.stderr)
        return 1
    # Flag first so crew.service ExecStart is start-beast.sh leftover-fit,
    # not the dual-27B pin.
    write_mode("beast")
    hold_beast_park()
    print("stopping ops (clean stop — Restart=on-failure will not revive it)")
    _systemctl_user(["kill", "-s", "SIGKILL", OPS_UNIT])
    _systemctl_user(["reset-failed", OPS_UNIT])
    stop_unit("ops")
    if crew_up:
        print("stopping :8005 so Beast can leftover-fit Unsloth")
        stop_unit("crew")
        subprocess.run(["docker", "rm", "-f", "crew", "muse-glimmer"],
                       capture_output=True, timeout=60)
    _systemctl_user(["reset-failed", CREW_UNIT])
    print("keeping Cosy — Audio8 STT stays on CPU")
    if not ensure_cosy_up("beast"):
        print("cosy :7789 /health did not return 200 — Beast would mute Crissa", file=sys.stderr)
        return 1
    # Cosy resident ~11 GiB; do not wait for a 90 GiB empty card.
    got = wait_vram(70.0, timeout=180)
    print(f"free after park {got if got is not None else '?'} GiB (Cosy resident)")
    print("starting crew.service → start-beast.sh (Unsloth Qwen3.8-27B as crew :8005, util≤0.9)")
    start_unit("crew")
    if not wait_http(f"{CREW_URL}/v1/models", timeout=900, label="beast crew :8005"):
        print("crew :8005 did not return /v1/models (Unsloth load failed)", file=sys.stderr)
        return 1
    if render_sleep_hold_active() or leaving_off:
        print("leaving render/off for beast — wake Ada/Crissa on Unsloth crew")
        wake_render_rest()
    write_state(
        {
            "schema": "krew_gpu_mode/v1",
            "mode": "beast",
            "recipe": "qwen3.8-27b-unsloth",
            "parked": ["ops", "comfy"],
            "park_how": ["ops:stop", "comfy:kill"],
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
        }
    )
    print("mode beast  crew=:8005 Unsloth Qwen3.8-27B  Cosy TTS + Audio8 STT  ops parked")
    return 0


def cmd_off(*, dry_run: bool = False) -> int:
    """Empty GPU — raw Ubuntu. Parks ops, crew, Cosy, Comfy. Ear + presence stay."""
    prev = read_mode()
    ops_up = http_ok(f"{OPS_URL}/v1/models")
    crew_up = http_ok(f"{CREW_URL}/v1/models")
    cosy_up = http_ok(f"{COSY_URL}/health")
    comfy = comfy_up()
    already = (
        prev == "off"
        and not comfy
        and not ops_up
        and not crew_up
        and not cosy_up
    )
    print(
        f"off  prev={prev} comfy={'up' if comfy else 'down'} "
        f"ops={'up' if ops_up else 'down'} crew={'up' if crew_up else 'down'} "
        f"cosy={'up' if cosy_up else 'down'}"
    )
    if dry_run:
        return 0
    if already:
        hold_off_park()
        write_flag("off")
        print("already off — GPU empty; Audio8 + presence stay")
        return 0
    if prev == "render" or render_sleep_hold_active():
        pin_kiosk_wall()
    if not stop_comfy():
        print("Comfy still up after off — stop it by hand", file=sys.stderr)
        return 1
    if beast_park_active():
        release_beast_park()
    release_crew_hold()
    hold_off_park()
    write_flag("off")
    print("All OS Off — SIGKILL Comfy, park ops + crew + Cosy")
    for unit in ("ops", "crew"):
        print(f"park {unit}:{park_unit(unit)}")
    # park_unit's `systemctl --user` was always the right scope; what Off
    # lacked was a wait for the driver to release, so the stop returned while
    # the VRAM was still held. park_cosy() adds that wait.
    print(f"park turbo-voice:{park_cosy()}")
    subprocess.run(
        ["docker", "rm", "-f", "crew", "muse-glimmer"],
        capture_output=True,
        timeout=60,
    )
    sleep_off_rest()
    got = wait_vram(80.0, timeout=120)
    write_state(
        {
            "schema": "krew_gpu_mode/v1",
            "mode": "off",
            "recipe": None,
            "parked": ["ops", "crew", "cosy", "comfy"],
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
        }
    )
    print(f"mode off  GPU empty (free={got if got is not None else '?'} GiB)  ear+presence CPU")
    print("not a host poweroff — krew-mode normal brings brains back")
    return 0


def units_to_wake(state: Dict[str, Any], *, was_beast: bool) -> List[str]:
    """Which occupancy brains systemd should start.

    Empty parked[] is a flag-only flip. Do not treat falsy [] as ['crew'] —
    that bounced crew on every flag-only click (2026-08-20).
    Missing `parked` key (legacy state) still wakes crew.
    Leaving Beast always needs crew (dual-27B pin, not leftover-fit);
    ops is started in that branch first.
    """
    if was_beast:
        return ["crew"]
    parked = state.get("parked")
    if isinstance(parked, list):
        return [u for u in ("ops", "crew") if u in parked]
    return ["crew"]


def cmd_restore(mode: str, *, dry_run: bool = False) -> int:
    """Stop Comfy, wake parked brains. standard/normal = dual Unsloth 27B.

    Leaving a heavy-render window (the User 09-29: "crew ALWAYS comes back, even on a crash or
    timeout"): the heavy-render crew hold is released and crew is put on the wake list before
    the ordinary restore, and the dispatch pause and the runner's state are removed AFTER it
    WHATEVER it returned - a crew that failed to come back is the keeper's and the ladder's,
    never a board paused forever."""
    if mode in ("normal", "standard") and not dry_run:
        _baseline("end", "render")
    heavy = mode in ("normal", "standard") and bool(heavy_markers())
    if heavy and not dry_run:
        print("leaving heavy-render (" + ", ".join(heavy_markers()) + ")")
        freed = release_card(HEAVY_CARD)
        if freed:
            print("heavy-render hold released: " + ", ".join(freed))
        st = read_state()
        parked = list(st.get("parked") or [])
        if "crew" not in parked:
            parked.append("crew")
            write_state({**st, "parked": parked})
    try:
        return _cmd_restore(mode, dry_run=dry_run)
    finally:
        if heavy and not dry_run:
            try:
                apply_dispatch_pause(False)
            except Exception as e:  # noqa: BLE001 - never let the cleanup mask the restore
                print(f"dispatch pause NOT removed ({type(e).__name__}: {e}) - remove the marked "
                      f"line from {HOUSE / 'config.yaml'} by hand", file=sys.stderr)
            HEAVY_STATE.unlink(missing_ok=True)


def _cmd_restore(mode: str, *, dry_run: bool = False) -> int:
    prev = read_mode()
    was_beast = beast_park_active()
    leaving_off = prev == "off" or off_park_active()
    leaving_render = prev == "render" and mode != "render"
    need_wake_sleepers = render_sleep_hold_active()
    if mode in ("normal", "standard"):
        # The sanctioned way back returns everything a dead card still pins.
        # 2026-09-12: three wedges where the flag read normal, Comfy was up or
        # down, and a blocked render card's stamp kept ops and Crissa's gateway
        # parked; `krew-mode normal` walked past it. A card that is really
        # running keeps its hold (see hold_card_live).
        freed = release_stale_card_holds(by="normal", dry_run=dry_run)
    else:
        freed = []
    state = read_state()
    wake = units_to_wake(state, was_beast=was_beast)
    if mode in ("normal", "standard"):
        # 2026-09-13: state.parked[] is not the SoT — a worker wrote its
        # parked[] to a sandboxed HOME while the hold in /tmp named ops. Wake
        # what the released hold named, and ops when the silicon says it is
        # down under a normal flag (same gates as the sweep's way back).
        if OPS_UNIT in freed and "ops" not in wake:
            print("released hold named ops — waking it")
            wake = list(wake) + ["ops"]
        if not leaving_render and not was_beast:
            for unit in way_back_units(mode=prev, ignore_pending=True, comfy=False):
                short = unit.replace(".service", "")
                if short == "ops" and "ops" not in wake:
                    print("flag normal but ops :8000 is down — waking it (silicon, not the flag)")
                    wake = list(wake) + ["ops"]
    print(f"{mode}  SIGKILL Comfy, thaw={thaw_after_comfy()}, wake {wake or 'none (flag only)'}")
    if dry_run:
        return 0
    if not stop_comfy():
        print(f"Comfy still up after {mode} — stop it by hand", file=sys.stderr)
        if need_wake_sleepers or "hermes-crissa-gateway.service" in freed:
            # Her gateway needs no VRAM: give her back before giving up.
            print("Comfy lingers — waking the slept gateways anyway")
            wake_render_rest()
            transferring_to_crissa()
        return 1
    if COMFY_SETTLE_SEC > 0:
        time.sleep(COMFY_SETTLE_SEC)
    if leaving_off:
        print("leaving All OS Off — Cosy then ops then crew")
        release_off_park()
        if not ensure_cosy_up("leaving off"):
            print("cosy :7789 /health did not return 200 — ops would OOM it", file=sys.stderr)
            return 1
        if "ops" not in wake:
            wake = ["ops"] + [u for u in wake if u != "ops"]
        if "crew" not in wake:
            wake = list(wake) + ["crew"]
    if leaving_render or need_wake_sleepers:
        pin_kiosk_wall()
    write_ops_recipe("daily")
    if leaving_render and not was_beast:
        write_flag(mode, force_restore=True)
        if "ops" not in wake:
            print("leaving render — thaw ops composer :8000")
            wake = list(wake) + ["ops"]
        if "crew" not in wake and not http_ok(f"{CREW_URL}/v1/models"):
            print("leaving render — crew was down; thaw :8005")
            wake = list(wake) + ["crew"]
    if was_beast:
        print("leaving beast — stop leftover-fit Unsloth on :8005, keep Cosy, then dual 27B")
        stop_unit("crew")
        subprocess.run(["docker", "rm", "-f", "crew", "muse-glimmer"],
                       capture_output=True, timeout=60)
        release_beast_park()
        # Flag only until ops is up — start-ops.sh refuses while the file
        # still says beast. Restore pins as soon as ops answers; a later
        # Crew wait failure must not leave Crissa on parked crew.
        write_flag(mode)
        # Cosy first, then ops, then crew. Render may now have parked her
        # (COSY_RENDER_PARK), so this is the graceful-return leg.
        if not ensure_cosy_up(f"leaving render for {mode}"):
            print("cosy :7789 /health did not return 200 — ops would OOM it", file=sys.stderr)
            return 1
        start_unit("ops")
        if not wait_http(f"{OPS_URL}/v1/models", timeout=600, label="ops :8000"):
            print("ops :8000 did not return /v1/models", file=sys.stderr)
            return 1
        apply_ops_occupancy(mode, restart=True)
        apply_turbo_krew_occupancy(mode)
        wake = ["crew"]
    if wake:
        # Full EngineCore load ~41 GiB. L1 wake already holds residual on the
        # card; 22 GiB free is enough for the weight copy.
        need = 22.0 if crew_is_sleeping() else 40.0
        got = wait_vram(need, timeout=90, extend=90)
        if got is not None:
            print(f"free after Comfy kill {got:.1f} GiB")
        for unit in wake:
            thaw_unit(unit)
    if "ops" in wake:
        if not wait_http(f"{OPS_URL}/v1/models", timeout=600, label="ops :8000"):
            print("ops :8000 did not return /v1/models", file=sys.stderr)
            if leaving_render:
                write_mode(mode)
                release_occupancy_hold()
                write_state(
                    {
                        "schema": "krew_gpu_mode/v1",
                        "mode": mode,
                        "recipe": None,
                        "parked": [],
                        "ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
                    }
                )
            return 1
        apply_turbo_krew_occupancy(mode)
    if "crew" in wake:
        if not wait_http(f"{CREW_URL}/v1/models", timeout=900, label="crew :8005"):
            print("crew :8005 did not return /v1/models", file=sys.stderr)
            maybe_wake_sleepers_after_crew_fail(
                leaving_render=leaving_render,
                need_wake_sleepers=need_wake_sleepers,
            )
            # Flag and hold must not stay Render even if crew is still mute.
            write_mode(mode)
            release_occupancy_hold()
            write_state(
                {
                    "schema": "krew_gpu_mode/v1",
                    "mode": mode,
                    "recipe": None,
                    "parked": [],
                    "ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
                }
            )
            return 1
    write_mode(mode)
    if leaving_render or need_wake_sleepers:
        # Key off the hold, not prev — write_flag already left render.
        print("leaving render — wake Ada/Crissa")
        wake_render_rest()
    if leaving_render and mode in ("normal", "standard"):
        transferring_to_crissa()
    release_occupancy_hold()
    write_state(
        {
            "schema": "krew_gpu_mode/v1",
            "mode": mode,
            "recipe": None,
            "parked": [],
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
        }
    )
    probes = {
        "ops": http_ok(f"{OPS_URL}/v1/models"),
        "crew": http_ok(f"{CREW_URL}/v1/models"),
        "presence": http_ok(f"{PRESENCE_URL}/v1/presence"),
        "audio8": http_ok(f"{ASR_URL}/health"),
        "comfy": comfy_up(),
    }
    for name, ok in probes.items():
        print(f"probe {name:9} {'ok' if ok else 'DOWN'}")
    if probes["comfy"]:
        print(f"Comfy still up after {mode} — stop it by hand", file=sys.stderr)
        return 1
    if not (probes["presence"] and probes["audio8"]):
        return 1
    print(f"mode {mode}")
    return 0


# ---------------------------------------------------------------------------
# THE WAY BACK, SWEPT (the owner 2026-09-11: "we have not come back from render
# successfully ever"). Twice today a card parked ops through the hold and
# never gave it back: t_2281a9d3 finished at 02:43 and its hold outlived it;
# t_5b423dc9 parked ops at 08:46, went BLOCKED at 10:10 (four iteration
# budgets) and the hold stayed — :8000 down 08:46-10:35 both times until a
# human deleted the line. The completion hook (krew-gpu-hold) only fires on
# a kanban_complete through the gateway tool, and never on blocked, gave-up,
# archived or CLI-completed cards. This sweep reads the card's status off
# the board itself and releases the hold when the card is no longer live,
# then starts what the hold had parked. Unstamped holds are never touched
# (the 2026-08-10 rail). Timer: krew-hold-sweep.timer, every 2 minutes.
HOLD_LIVE_STATUSES = ("running", "ready", "todo", "triage", "review", "in_progress", "claimed")
KANBAN_BOARDS = HOUSE / "kanban" / "boards"


def card_status(card: str) -> Optional[str]:
    """The card's status on any board, None when no board knows it."""
    import sqlite3
    for db in sorted(KANBAN_BOARDS.glob("*/kanban.db")):
        try:
            con = sqlite3.connect("file:%s?mode=ro" % db, uri=True)
            row = con.execute("select status from tasks where id=?", (card,)).fetchone()
            con.close()
        except sqlite3.Error:
            continue
        if row:
            return str(row[0] or "")
    return None


def _hold_log(event: dict) -> None:
    try:
        event = dict(event)
        event.setdefault("ts", time.strftime("%Y-%m-%dT%H:%M:%S"))
        with (HOUSE / "krew-gpu-hold.jsonl").open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(event, ensure_ascii=False) + "\n")
    except OSError:
        pass


def _comfy_idle_or_stop() -> bool:
    """A render in flight for a card that is gone is a render nobody will
    collect; stop it so ops has the VRAM back (the owner 2026-09-11: "pull those")."""
    import urllib.request
    try:
        q = json.loads(urllib.request.urlopen("http://127.0.0.1:8188/queue", timeout=4).read())
    except Exception:
        return True
    if not q.get("queue_running") and not q.get("queue_pending"):
        return True
    try:
        urllib.request.urlopen(urllib.request.Request("http://127.0.0.1:8188/interrupt", data=b"", method="POST"), timeout=4)
        urllib.request.urlopen(urllib.request.Request("http://127.0.0.1:8188/queue", data=b'{"clear":true}',
                                                      headers={"Content-Type": "application/json"}, method="POST"), timeout=4)
        _hold_log({"event": "comfy_interrupted", "by": "hold-sweep"})
    except Exception as exc:
        _hold_log({"event": "comfy_interrupt_failed", "error": repr(exc)[:120]})
    return False


def card_worker_pid(card: str) -> Optional[int]:
    """The card's worker pid on any board (None when no board knows it)."""
    import sqlite3
    for db in sorted(KANBAN_BOARDS.glob("*/kanban.db")):
        try:
            con = sqlite3.connect("file:%s?mode=ro" % db, uri=True)
            row = con.execute("select worker_pid from tasks where id=?", (card,)).fetchone()
            con.close()
        except sqlite3.Error:
            continue
        if row is not None:
            try:
                return int(row[0]) if row[0] else None
            except (TypeError, ValueError):
                return None
    return None


def pid_alive(pid: Optional[int]) -> bool:
    if not pid:
        return False
    try:
        os.kill(int(pid), 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except (TypeError, ValueError, OSError):
        return False


HOLD_RUNNING_STATUSES = ("running", "in_progress", "claimed")


def hold_card_live(card: str, *, pending: Optional[set] = None, mode: Optional[str] = None,
                   comfy: Optional[bool] = None) -> tuple[bool, str]:
    """Does this card still earn its hold? (live, reason).

    the owner 2026-09-12 (third wedge of the day): only a RUNNING card with a live
    worker pid holds. A blocked / archived / done / ready card releases — it
    re-takes the hold the moment it submits again. A render still pending on
    Comfy keeps the hold only while the box is in Render or Comfy is actually
    serving; "render-pending" with the flag at normal and Comfy down is a
    jobs-file ghost, and it pinned ops for hours today.
    """
    # `pending` = cards with a render ON COMFY (pending + prompt_id) or a
    # fresh `preparing` row — not bare jobs-file membership (2026-09-13: five
    # `preparing` ghosts with no prompt_id pinned ops + Crissa for four hours).
    st = card_status(card)
    pending = _render_pending_cards() if pending is None else pending
    mode = (read_mode() if mode is None else mode) or ""
    if st in HOLD_RUNNING_STATUSES:
        pid = card_worker_pid(card)
        if pid_alive(pid):
            return True, f"{st} worker {pid} alive"
        if card in pending and (mode == "render" or (comfy_up() if comfy is None else comfy)):
            return True, f"{st}+render-pending (Comfy serving)"
        return False, f"{st} but worker {pid or '-'} gone"
    if card in pending and (mode == "render" or (comfy_up() if comfy is None else comfy)):
        return True, f"{st}+render-pending (Comfy serving)"
    if st in (None, "", "unknown"):
        # UNKNOWN KEEPS (2026-09-14, Grok): 12:48:02 released "init-wizard" as unknown and started ops mid-Render
        return True, "status unknown — keep"
    return False, f"{st}"


def _start_freed(freed: List[str], *, by: str) -> None:
    """What the last owner parked comes back, unless a human hold still names it."""
    still = set(_hold_list())
    rendering = read_mode() == "render"
    for unit in (OPS_UNIT, CREW_UNIT, "hermes-crissa-gateway.service"):
        if unit in freed and unit not in still and rendering and unit in (OPS_UNIT, "hermes-crissa-gateway.service"):
            # NOT IN RENDER (2026-09-14, Grok): the flag says render; Standard's brain and Crissa stay down
            _hold_log({"event": "start_skipped", "unit": unit, "why": "flag render", "by": by})
            print("%s: %s freed but the flag says render — not started" % (by, unit))
            continue
        if unit in freed and unit not in still:
            if unit == OPS_UNIT:
                _comfy_idle_or_stop()
            active = _systemctl_user(["is-active", unit]).stdout.strip()
            if active != "active":
                r = _systemctl_user(["start", unit])
                _hold_log({"event": "started", "unit": unit, "rc": r.returncode, "err": (r.stderr or "")[:120], "by": by})
                print("%s: start %s rc=%d" % (by, unit, r.returncode))


def occupancy_hold_live(*, pending: Optional[set] = None, mode: Optional[str] = None,
                        comfy: Optional[bool] = None) -> tuple[bool, str]:
    """Does the CLI's own occupancy hold still earn itself? (live, why).

    Nothing ever completes "occupancy" — it is not a card — so `card_status`
    reads it as unknown and the UNKNOWN-KEEPS rail would pin it forever. Its
    real owner is the Render: the flag, a take still on Comfy, or Comfy serving.
    """
    mode = (read_mode() if mode is None else mode) or ""
    if mode == "render":
        return True, "flag render"
    pending = _render_pending_cards() if pending is None else pending
    if pending:
        return True, "render pending (%s)" % ",".join(sorted(str(c) for c in pending)[:3])
    if (comfy_up() if comfy is None else comfy):
        return True, "Comfy serving"
    return False, "flag %s, no render pending, Comfy idle" % (mode or "?")


def flag_home_due(*, pending: Optional[set] = None, comfy: Optional[bool] = None) -> tuple[bool, str]:
    """Flag says render and nothing is rendering: the restore never ran. (due, why).

    Every gate the way back asks, asked again here — a render on Comfy, a mode
    switch in flight, a Beast/Off park or any LIVE card hold all mean the flag is
    honest and this must not fire.
    """
    mode = read_mode() or ""
    if not SWEEP_FLAG_HOME:
        return False, "KREW_SWEEP_FLAG_HOME=0"
    if mode == "heavy-render":
        # Crew ALWAYS comes back (the User 09-29): a heavy window is honest only while
        # its runner is alive and inside its deadline. A crashed / killed / hung runner,
        # or a reboot mid-window, sends the house home - that is the sweep's net.
        if read_pending():
            return False, "mode switch in flight"
        alive, why = heavy_runner_alive()
        return (not alive), why
    if mode != "render":
        return False, "flag %s" % (mode or "?")
    if read_pending():
        return False, "mode switch in flight"
    if beast_park_active() or off_park_active():
        return False, "beast/off park"
    p = _render_pending_cards() if pending is None else pending
    if p:
        return False, "render pending (%s)" % ",".join(sorted(str(c) for c in p)[:3])
    # BUSY, not up — see comfy_busy(). The `comfy` argument the sweep passes is
    # liveness, and liveness is what latched the flag for three hours on 09-21,
    # so this gate ignores it and asks the queue itself.
    if comfy_busy() if FLAG_HOME_COMFY_BUSY else (comfy_up() if comfy is None else comfy):
        return False, "Comfy rendering"
    live = [c for c in _hold_cards() if c and c != OCCUPANCY_CARD
            and hold_card_live(c, pending=p, mode=mode, comfy=comfy)[0]]
    if live:
        return False, "card hold live (%s)" % ",".join(live[:3])
    return True, "no render pending, Comfy idle, no live card hold"


def release_stale_card_holds(*, by: str, dry_run: bool = False, pending: Optional[set] = None,
                             comfy: Optional[bool] = None, hysteresis: bool = False) -> List[str]:
    """Release every card hold whose card no longer earns it; start what it
    parked. The occupancy card and human holds are never touched.
    hysteresis=True (hold-sweep only): two consecutive not-live ticks before
    release. krew-mode normal releases on the first not-live look."""
    pending = _render_pending_cards(dry_run=dry_run) if pending is None else pending
    mode = read_mode()
    freed: List[str] = []
    hyst_path = HOUSE / "hold-sweep-hysteresis.json"
    not_live: dict = {}
    if hysteresis:
        try:
            hyst = json.loads(hyst_path.read_text())
            if isinstance(hyst.get("not_live"), dict):
                not_live = hyst["not_live"]
        except (OSError, ValueError):
            not_live = {}
    for cid in [c for c in _hold_cards() if c and (c != OCCUPANCY_CARD or SWEEP_OCCUPANCY)]:
        if cid == OCCUPANCY_CARD:
            live, why = occupancy_hold_live(pending=pending, mode=mode, comfy=comfy)
        else:
            live, why = hold_card_live(cid, pending=pending, mode=mode, comfy=comfy)
        if live:
            not_live.pop(cid, None)
            print("%s: %s %s -> keep" % (by, cid, why))
            continue
        if hysteresis:
            ticks = int(not_live.get(cid, 0)) + 1
            not_live[cid] = ticks
            if ticks < HYSTERESIS_TICKS:
                print("%s: %s %s -> keep (hysteresis %d/%d)" % (by, cid, why, ticks, HYSTERESIS_TICKS))
                continue
            print("%s: %s %s -> release (hysteresis %d)" % (by, cid, why, ticks))
        else:
            print("%s: %s %s -> release" % (by, cid, why))
        if dry_run:
            continue
        got = release_card(cid)
        not_live.pop(cid, None)
        _hold_log({"event": "released", "card": cid, "status": why, "units": got, "by": by})
        freed.extend(got)
    if hysteresis and not dry_run:
        try:
            hyst_path.write_text(json.dumps({"not_live": not_live}, indent=1) + "\n")
        except OSError as e:
            # A silent failure here is a permanent latch with no symptom: the counter reads
            # back 0 every tick, never reaches HYSTERESIS_TICKS, and NO hold is ever
            # released. Exactly the shape a full disk or a read-only home produces, which
            # is the same pressure the sweep exists to relieve. Say it out loud.
            print(f"hold-sweep: CANNOT WRITE the hysteresis counter ({type(e).__name__}: {e}) "
                  f"-> no hold can be released until this is fixed: {hyst_path}")
            _hold_log({"event": "counter_write_failed", "file": str(hyst_path),
                       "err": f"{type(e).__name__}: {e}", "by": by})
    if freed and not dry_run:
        _start_freed(freed, by=by)
    return freed


# A `preparing` row is written BEFORE the park on purpose (79a2bbe6: the sweep
# once released the hold eleven seconds before the row existed). It is live
# for this long from `submitted`; after that a row with no prompt_id is a
# ghost — the submit was killed before POST /prompt (2026-09-13: the worker's
# terminal timeout killed render-submit mid-park five times; the rows stayed
# `preparing` and the sweep honoured them for four hours).
RENDER_PREPARING_TTL_SEC = float(os.environ.get("KREW_RENDER_PREPARING_TTL_SEC", "900"))
PREPARING_STALE_SEC = float(os.environ.get("KREW_RENDER_PREPARING_STALE_SEC", "90"))
HYSTERESIS_TICKS = int(os.environ.get("KREW_SWEEP_HYSTERESIS_TICKS", "2"))
# Kill switches for the two sweep actions landed 2026-09-13 (rollback without
# a code revert): KREW_SWEEP_COMFY_LEAK=0 keeps an idle Comfy alone,
# KREW_SWEEP_WAY_BACK=0 stops the sweep starting ops/Crissa on its own.
SWEEP_COMFY_LEAK = os.environ.get("KREW_SWEEP_COMFY_LEAK", "1").strip().lower() not in ("0", "false", "no", "off")
SWEEP_WAY_BACK = os.environ.get("KREW_SWEEP_WAY_BACK", "1").strip().lower() not in ("0", "false", "no", "off")
# THE OCCUPANCY STAMP IS SWEEPABLE (2026-09-21). `occupancy_card()` writes the
# literal "occupancy" whenever HERMES_KANBAN_TASK is unset — any Render entered
# by hand rather than by a kanban worker. Both sweep gates skipped it BY NAME, so
# that hold could only ever be cleared by an explicit `krew-mode normal`: on
# 2026-09-20 it survived 58 no-op ticks with the flag already back at `normal`,
# ops and Crissa down the whole time. It is not a card and not a human — its only
# owner is the Render itself. Kill KREW_SWEEP_OCCUPANCY=0 for the old skip.
SWEEP_OCCUPANCY = os.environ.get("KREW_SWEEP_OCCUPANCY", "1").strip().lower() not in ("0", "false", "no", "off")
# THE FLAG'S WAY HOME (2026-09-21). `write_mode(normal)` lives only in the restore
# path, and only render-collect ever reached it, so a Render that ended any way
# but a clean collect latched the flag at `render` for good — and the 2026-09-14
# guard in `_start_freed` ("NOT IN RENDER") then kept ops and Crissa down forever,
# because a freed unit is never started while the flag reads render. That guard is
# right; it just had no counterpart to bring the flag home. This one launches the
# real restore (same detached `krew-mode normal` render-collect uses), never a
# bare flag write, and only after every render gate is clear for two ticks.
# Kill KREW_SWEEP_FLAG_HOME=0.
SWEEP_FLAG_HOME = os.environ.get("KREW_SWEEP_FLAG_HOME", "1").strip().lower() not in ("0", "false", "no", "off")
FLAG_HOME_TICKS = int(os.environ.get("KREW_SWEEP_FLAG_HOME_TICKS", "2"))


def _job_age_s(submitted: Optional[str], now: Optional[float] = None) -> Optional[float]:
    if not submitted:
        return None
    try:
        t = time.mktime(time.strptime(str(submitted)[:19], "%Y-%m-%dT%H:%M:%S"))
    except (ValueError, OverflowError):
        return None
    return (now if now is not None else time.time()) - t


def _pid_starttime(pid: int) -> Optional[str]:
    try:
        st = Path("/proc/%d/stat" % int(pid)).read_text()
        rparen = st.rfind(")")
        return st[rparen + 2 :].split()[19]
    except (OSError, IndexError, ValueError, TypeError):
        return None


def _preparing_live(j: dict, now: Optional[float] = None) -> bool:
    """Live park vs ghost. Pid+starttime wins; 900 s is the age backstop for
    rows that never recorded a pid (pre-09-15 jobs)."""
    now = time.time() if now is None else now
    age = _job_age_s(j.get("submitted"), now)
    pid = j.get("pid")
    recorded = j.get("pid_starttime")
    if pid:
        live_st = _pid_starttime(int(pid))
        if live_st is not None and recorded and str(live_st) == str(recorded):
            return True  # submit still running, even at 500 s
        alive_at = j.get("alive_at")
        try:
            stale = (now - float(alive_at)) if alive_at is not None else 1e9
        except (TypeError, ValueError):
            stale = 1e9
        if stale <= PREPARING_STALE_SEC and live_st is not None:
            return True
        return False  # pid gone or reused, or heartbeat > 90 s
    # No pid on the row (old jobs): age backstop only. 120/480 forbidden —
    # park wall 420 + 360 s VRAM poll ≈ 780 s.
    if age is None or age < RENDER_PREPARING_TTL_SEC:
        return True
    return False


# A card in one of these will never be collected again, so a render row still marked
# `pending` against it is a ghost. `cancelled` is included for boards that use it; an
# UNKNOWN status (card_status -> None) is deliberately absent — unknown keeps the row.
TERMINAL_CARD_STATES = ("done", "archived", "cancelled")
# How old a `pending` row must be before a terminal card retires it. Generous on purpose:
# longer than any real render, so the only rows this reaches are ones no collect will ever
# resolve. 6 h against the 2026-09-22 latch, which was 3 days old.
PENDING_GHOST_MIN_AGE_S = float(os.environ.get("KREW_PENDING_GHOST_MIN_AGE_S", "21600") or 21600)


def _render_pending_cards(*, dry_run: bool = False) -> set:
    """Cards with a render ON COMFY (status pending + prompt_id) or a live
    `preparing` row. Dead-pid / stale / older-than-TTL preparing rows with no
    prompt_id are ghosts: marked `failed` so no sweep honours them again."""
    path = HOUSE / "render-jobs.json"
    try:
        jobs = json.loads(path.read_text())
    except (OSError, ValueError):
        return set()
    now = time.time()
    live: set = set()
    changed = False
    for j in jobs:
        if not isinstance(j, dict):
            continue
        card = str(j.get("card"))
        st = j.get("status")
        if st == "pending" and j.get("prompt_id"):
            # A render pending for a card nobody will ever collect is not pending. The
            # `preparing` branch below has had a ghost check since 09-13; this one trusted
            # its row FOREVER, and one row is enough to pin the whole house in Render:
            # measured 2026-09-22, card t_6e948919 was ARCHIVED on 09-19 and its single
            # pending row (prompt_id eb5f4ec3…, long gone from Comfy's history across many
            # restarts) made flag_home_due return "render pending (t_6e948919)" on every
            # tick. ops and Crissa's gateway were down, Ada was capped at the render 1/1 and
            # the board ran one card at a time. Nothing on the box would ever have cleared it.
            #
            # `card_status` returning None means NO BOARD KNOWS THE CARD — unreadable or
            # gone — and that must KEEP the row (the 2026-09-14 rail: unknown is not a
            # licence to end someone's render). Only a card that is explicitly terminal
            # retires its row.
            # AND old enough that no real render could still be behind it. A card can be
            # terminal while its render is genuinely on Comfy — krew-board-carry re-mints an
            # open card under a new id and archives the old one, and the take keeps rendering
            # (tests/test_krew_mode.py::test_carried_archived_card_with_render_on_comfy_keeps_hold).
            # Retiring on "terminal" ALONE broke that, which the test caught. A real render is
            # minutes to hours old; the row that latched the house on 2026-09-22 was THREE DAYS
            # old, across many Comfy restarts. Age is the honest discriminator, and unlike a
            # Comfy probe it needs no network call in a 2-minute sweep.
            age = _job_age_s(j.get("submitted"), now)
            cst = (card_status(card) or "").strip().lower()
            if cst in TERMINAL_CARD_STATES and (age or 0) > PENDING_GHOST_MIN_AGE_S:
                print("hold-sweep: %s take %s pending ghost (card is %s, %.0f h old) -> marked failed%s"
                      % (card, j.get("take"), cst, (age or 0) / 3600.0,
                         " (dry run)" if dry_run else ""))
                if not dry_run:
                    j["status"] = "failed"
                    j["error"] = ("ghost: pending on a %s card; no collect will ever resolve "
                                  "prompt_id %s. Marked failed by hold-sweep %s"
                                  % (cst, j.get("prompt_id"), time.strftime("%Y-%m-%dT%H:%M:%S")))
                    changed = True
                    _hold_log({"event": "pending_ghost_failed", "card": card, "card_status": cst,
                               "prompt_id": j.get("prompt_id"), "take": j.get("take"),
                               "by": "hold-sweep"})
                continue
            live.add(card)
        elif st == "preparing":
            if _preparing_live(j, now):
                live.add(card)
            else:
                age = _job_age_s(j.get("submitted"), now)
                print("hold-sweep: %s %s take %s preparing ghost (pid=%s age=%ss) -> marked failed%s"
                      % (card, j.get("name"), j.get("take"), j.get("pid"),
                         int(age or 0), " (dry run)" if dry_run else ""))
                if dry_run:
                    continue
                j["status"] = "failed"
                j["error"] = ("ghost: preparing with no live submit pid "
                              "(submit died before POST /prompt); marked failed by hold-sweep %s"
                              % time.strftime("%Y-%m-%dT%H:%M:%S"))
                changed = True
                _hold_log({"event": "ghost_failed", "card": card, "name": j.get("name"), "take": j.get("take"),
                           "age_min": int((age or 0) // 60), "pid": j.get("pid"), "by": "hold-sweep"})
    if changed:
        path.write_text(json.dumps(jobs, indent=1) + "\n")
    return live


def _comfy_queue_idle() -> Optional[bool]:
    """True when /queue has nothing running or pending; None when unreadable."""
    import urllib.request
    try:
        q = json.loads(urllib.request.urlopen("http://127.0.0.1:%d/queue" % _comfy_port(), timeout=4).read())
    except Exception:
        return None
    return not q.get("queue_running") and not q.get("queue_pending")


def sweep_comfy_leak(*, by: str, pending: set, mode: Optional[str] = None, dry_run: bool = False) -> bool:
    """Comfy up in Normal with nothing on it and no render brief is a LEAK
    (docs/RENDER-OCCUPANCY.md, Liveness): stop it. Returns True when Comfy
    is (now) down. Never while the flag is render or a switch is in flight."""
    mode = (read_mode() if mode is None else mode) or ""
    if not comfy_up():
        return True
    if not SWEEP_COMFY_LEAK or mode != "normal" or read_pending() or pending:
        return False
    if _comfy_queue_idle() is not True:
        return False
    print("%s: Comfy :8188 up in normal, queue empty, nothing pending -> leak, stopping" % by)
    if dry_run:
        return False
    if stop_comfy():
        _hold_log({"event": "comfy_leak_stopped", "by": by})
        return True
    _hold_log({"event": "comfy_leak_stop_failed", "by": by})
    return False


def _unit_active(unit: str) -> bool:
    r = _systemctl_user(["is-active", unit])
    return r.stdout.strip() in ("active", "activating", "reloading")


KEEPER_STATE = Path(os.environ.get("KEEPER_STATE", os.path.expanduser(os.environ.get("KREW_MEMORY_ROOT") or "~/.krew/memory") + "/keeper/state.json"))
KEEPER_RESTARTS_PER_DAY = int(os.environ.get("KEEPER_RESTARTS_PER_DAY", "3"))


def keeper_budget_spent(unit: str) -> bool:
    """The keeper announced "needs a human" for this unit today — respect it."""
    try:
        st = json.loads(KEEPER_STATE.read_text())
        day = time.strftime("%Y-%m-%d")
        return int(st.get("restarts", {}).get(day, {}).get(unit, 0)) >= KEEPER_RESTARTS_PER_DAY
    except (OSError, ValueError, TypeError):
        return False


def heavy_runner_alive(now: Optional[float] = None) -> tuple[bool, str]:
    """Is the heavy-render runner still in charge? (alive, why).

    Alive only when its state file names a live pid AND the deadline (+ grace) has not
    passed. A missing / unreadable state file, a dead pid or a blown deadline all mean
    nobody is holding crew down on purpose any more - crew must come back."""
    now = time.time() if now is None else now
    try:
        st = json.loads(HEAVY_STATE.read_text())
    except (OSError, ValueError):
        return False, "heavy: no runner state"
    pid = int(st.get("pid") or 0)
    try:
        deadline = float(st.get("deadline") or 0)
    except (TypeError, ValueError):
        deadline = 0.0
    if pid <= 0 or not Path("/proc/%d" % pid).exists():
        return False, "heavy: runner pid %d gone" % pid
    if deadline and now > deadline + HEAVY_GRACE_S:
        return False, "heavy: past the deadline by %ds" % int(now - deadline)
    return True, "heavy: runner %d alive" % pid


def restore_due() -> bool:
    """Is a `krew-mode normal` restore owed? The plugin (krew-gpu-hold) has
    called this since 2026-09-11; it did not exist, so the plugin fell back to
    flag-only. Owed when the flag still says render, the house state lists
    something parked, or a CARD-stamped hold still names a brain or Crissa's
    gateway. A flag at normal with ops down is NOT owed by itself (Beast,
    Off, a human hold and a spent keeper budget all look like that)."""
    if read_mode() == "render":
        return True
    if read_mode() == "heavy-render":  # owed exactly when nobody holds crew down on purpose
        return not heavy_runner_alive()[0]
    if read_state().get("parked"):
        return True
    if _hold_cards():
        named = set(_hold_list())
        if named & {OPS_UNIT, CREW_UNIT, "hermes-crissa-gateway.service"}:
            return True
    return False


def way_back_units(*, mode: Optional[str] = None, ignore_pending: bool = False,
                   comfy: Optional[bool] = None) -> list[str]:
    """Silicon disagrees with a `normal` flag: which units to start.

    Empty unless every gate passes: flag normal, no switch in flight, not a
    Beast/Off park, no hold at all (a card hold is a live owner, an unstamped
    hold is a human — the 2026-08-10 rail), Comfy down, and the keeper has not
    spent the unit's restart budget today.
    """
    mode = (read_mode() if mode is None else mode) or ""
    if not SWEEP_WAY_BACK or mode != "normal":
        return []
    if not ignore_pending and read_pending():
        return []
    if beast_park_active() or off_park_active():
        return []
    if _hold_list():
        return []
    if (comfy_up() if comfy is None else comfy):
        return []
    out: list[str] = []
    if not http_ok(f"{OPS_URL}/v1/models") and not _unit_active(OPS_UNIT):
        if keeper_budget_spent(OPS_UNIT):
            print("way back: ops down but the keeper's budget is spent today — leaving it to a human")
        else:
            out.append(OPS_UNIT)
    if not _unit_active("hermes-crissa-gateway.service") and not keeper_budget_spent("hermes-crissa-gateway.service"):
        out.append("hermes-crissa-gateway.service")
    return out


FLAG_HOME_STATE = HOUSE / "hold-sweep-flag-home.json"


def maybe_bring_flag_home(*, pending: Optional[set] = None, comfy: Optional[bool] = None) -> bool:
    """Launch `krew-mode normal` when the flag says render and nothing is.

    Two consecutive due ticks (4 minutes) before it fires, so a render that is
    just starting — submitted, not yet on Comfy — is never cut off at the knees.
    The counter resets the moment any gate says the flag is honest.
    """
    due, why = flag_home_due(pending=pending, comfy=comfy)
    mode_now = read_mode()
    # heavy-render: a dead runner is definitive (a pid does not come back) - one tick, not two
    need_ticks = 1 if mode_now == "heavy-render" else FLAG_HOME_TICKS
    try:
        ticks = int(json.loads(FLAG_HOME_STATE.read_text()).get("ticks", 0))
    except (OSError, ValueError, TypeError, AttributeError):
        ticks = 0
    if not due:
        if ticks:
            try:
                FLAG_HOME_STATE.unlink(missing_ok=True)
            except OSError:
                pass
        return False
    ticks += 1
    if ticks < need_ticks:
        print("hold-sweep: flag %s but %s -> way home in %d more tick(s)"
              % (mode_now, why, need_ticks - ticks))
        try:
            FLAG_HOME_STATE.write_text(json.dumps({"ticks": ticks, "why": why}) + "\n")
        except OSError as e:
            # Same shape as the hysteresis counter above and worse: ticks reads back 0 every
            # tick, so FLAG_HOME_TICKS is unreachable and the flag can NEVER come home. The
            # way back would be dead with no log line at all.
            print(f"hold-sweep: CANNOT WRITE the flag-home counter ({type(e).__name__}: {e}) "
                  f"-> the way home cannot count and the flag will stay render: {FLAG_HOME_STATE}")
            _hold_log({"event": "counter_write_failed", "file": str(FLAG_HOME_STATE),
                       "err": f"{type(e).__name__}: {e}", "by": "flag-home"})
        return False
    try:
        FLAG_HOME_STATE.unlink(missing_ok=True)
    except OSError:
        pass
    unit = "krew-mode-restore-sweep-%d" % int(time.time())
    hm = Path(__file__).resolve()
    print("hold-sweep: flag %s but %s -> launching the way home (%s)" % (mode_now, why, unit))
    r = subprocess.run(["systemd-run", "--user", "--collect", "--quiet", "--unit", unit,
                        "--description", "krew-mode normal: sweep found the flag latched at %s" % mode_now,
                        "python3", str(hm), "normal"], capture_output=True, text=True)
    _hold_log({"event": "flag_home_launched", "unit": unit, "rc": r.returncode,
               "err": (r.stderr or "")[:120], "by": "hold-sweep", "why": why})
    return r.returncode == 0


def cmd_heavy_enter(runner_pid: int, deadline: float, *, dry_run: bool = False) -> int:
    """`heavy-enter --runner-pid P --deadline EPOCH`: crew off the card, ops + Crissa up (Crissa's
    crew slots on ops), kanban spawns paused, flag heavy-render. Comfy is NOT started here
    (`heavy-comfy` does, per batch). Refused unless KREW_HEAVY_RENDER=1, never from a kanban
    worker, only from a clean normal house. Any failure after the first change rolls back
    through heavy-exit. Never restarts the host gateway."""
    why = ""
    if not heavy_enabled():
        why = "KREW_HEAVY_RENDER is not 1 - the heavy-render window is off"
    elif os.environ.get("HERMES_KANBAN_TASK"):
        why = "a kanban worker never enters heavy-render"
    elif read_mode() != "normal":
        why = f"the house is in {read_mode()}, not normal"
    elif read_pending() not in ("", "heavy-render"):  # main() marks OUR switch pending first
        why = "a mode switch is in flight (" + read_pending() + ")"
    elif _hold_list():
        why = "a GPU hold is present: " + ", ".join(_hold_list())
    elif _render_pending_cards(dry_run=True):
        why = "a render is pending on Comfy"
    elif heavy_markers():
        why = "a previous heavy-render window left traces (" + ", ".join(heavy_markers()) + ") - heavy-exit first"
    if why:
        print("heavy-render refused: " + why, file=sys.stderr)
        return 3
    print(f"heavy-render: stop crew, pause spawns, Crissa on ops; runner {runner_pid}, "
          f"deadline {time.strftime('%H:%M:%S', time.localtime(deadline))}")
    if dry_run:
        return 0
    HEAVY_STATE.parent.mkdir(parents=True, exist_ok=True)
    HEAVY_STATE.write_text(json.dumps({"pid": int(runner_pid), "deadline": float(deadline),
                                       "started": time.strftime("%Y-%m-%dT%H:%M:%S"),
                                       "card": HEAVY_CARD}) + "\n", encoding="utf-8")
    try:
        apply_dispatch_pause(True)
        hold_units(CREW_UNIT, card=HEAVY_CARD)  # the keeper, janitor and sweep never heal it
        write_state({"schema": "krew_gpu_mode/v1", "mode": "heavy-render", "recipe": None,
                     "parked": ["crew"], "park_how": ["crew:stop"],
                     "ts": time.strftime("%Y-%m-%dT%H:%M:%S")})
        stop_unit("crew")
        got = wait_vram(HEAVY_MIN_FREE_GIB, timeout=120.0)
        print(f"heavy-render: {got if got is not None else '?'} GiB free after crew stopped")
        write_mode("heavy-render")
    except Exception as e:  # noqa: BLE001
        print(f"heavy-render enter FAILED ({type(e).__name__}: {e}) - rolling back", file=sys.stderr)
        cmd_heavy_exit()
        return 1
    return 0


def cmd_heavy_comfy(*, highvram: bool) -> int:
    """`heavy-comfy [--highvram]`: (re)start Comfy for the next batch inside a heavy-render
    window, and re-assert the dispatch pause (the 20:15 config restore could have dropped it)."""
    if read_mode() != "heavy-render":
        print("heavy-comfy: not in heavy-render", file=sys.stderr)
        return 3
    apply_dispatch_pause(True)
    if not stop_comfy():
        print("heavy-comfy: the previous Comfy would not stop", file=sys.stderr)
        return 1
    pid = start_comfy(highvram=highvram)
    ok = wait_http(f"{COMFY_URL}/system_stats", timeout=300.0, label="comfy")
    print(f"heavy-comfy: pid {pid} {'--highvram' if highvram else 'normal VRAM'} "
          f"{'up' if ok else 'NOT up'}")
    return 0 if ok else 1


def cmd_heavy_exit(*, dry_run: bool = False) -> int:
    """`heavy-exit`: leave a heavy-render window - the runner's finally, its unit's ExecStopPost
    and the sweep all end here. Idempotent: with no heavy-render trace it does NOTHING (a
    `normal` on a normal house is exactly what the house forbids). Never gated: crew always
    comes back."""
    marks = heavy_markers()
    if not marks:
        print("heavy-exit: no heavy-render window here - nothing to do")
        return 0
    return cmd_restore("normal", dry_run=dry_run)


def cmd_release_card(card: str) -> int:
    """`release-card <card>`: drop one card's stamped hold (the render-collect
    door, t_6698facd). Prints the freed units, one per line, so a caller can
    take them; never starts anything — the caller starts what it freed."""
    freed = release_card(card)
    for unit in freed:
        print(unit)
    return 0


def cmd_hold_sweep(*, dry_run: bool = False) -> int:
    pending = _render_pending_cards(dry_run=dry_run)
    mode = read_mode()
    comfy_down = sweep_comfy_leak(by="hold-sweep", pending=pending, mode=mode, dry_run=dry_run)
    cards = [c for c in _hold_cards() if c and (c != OCCUPANCY_CARD or SWEEP_OCCUPANCY)]
    if cards:
        release_stale_card_holds(by="hold-sweep", dry_run=dry_run, pending=pending,
                                comfy=not comfy_down, hysteresis=True)
    else:
        print("hold-sweep: no card-stamped hold" + (" (file: %s)" % ",".join(_hold_list()) if CREW_HOLD.is_file() else ""))
    # THE WAY BACK, EVERY TWO MINUTES (2026-09-13): the plugin's restore only
    # fires on a gateway kanban_complete, and today's cards went blocked or
    # archived; the sweep is what actually runs. When the flag says normal
    # and the silicon says ops is down with nothing owning it, start it.
    for unit in way_back_units(mode=mode, comfy=not comfy_down):
        print("hold-sweep: flag normal, %s down, nothing holds it -> start (way back)" % unit)
        if dry_run:
            continue
        r = _systemctl_user(["start", unit])
        _hold_log({"event": "started", "unit": unit, "rc": r.returncode, "err": (r.stderr or "")[:120],
                   "by": "hold-sweep", "why": "way back: flag normal, silicon down"})
    # THE FLAG'S WAY HOME (2026-09-21). Everything above is the way back for the
    # SILICON; none of it can move the FLAG, and `_start_freed` refuses to start
    # ops or Crissa while the flag reads render (the 2026-09-14 guard). So a Render
    # that ended without a clean render-collect left the flag latched and those two
    # down for good. Launch the real restore, detached, exactly as render-collect
    # does — never a bare write_mode, so waking crew/ops keeps its own order.
    if not dry_run:
        maybe_bring_flag_home(pending=pending, comfy=not comfy_down)
    # ... and Ada dispatching at Render's (1, 1) after the flag went normal is
    # the same silicon-vs-flag gap: bounce her (once per start; see ada_caps_stale).
    # never under heavy-render either: that window pauses Ada's dispatch on purpose
    if mode not in ("render", "heavy-render") and not dry_run:  # a dry run touches nothing, not even `systemctl show`
        maybe_bounce_ada_for_caps(mode, by="hold-sweep")
    return 0


def own_cgroup_leaf() -> str:
    try:
        return Path("/proc/self/cgroup").read_text().strip().splitlines()[-1].rsplit("/", 1)[-1]
    except OSError:
        return ""


def leave_the_host_gateway(argv: list, *, leaf: Optional[str] = None, execvp=os.execvp) -> bool:
    """A mode switch must outlive the gateway it may restart.

    ONE host gateway serves every profile (KREW_GATEWAY_TOPOLOGY=host), and a crew turn's
    `krew_gpu_mode render` runs this script as a CHILD of that gateway. Entering Render restarts
    the dispatcher for its caps, and the dispatcher IS the host: systemd would kill this process
    with its parent in the middle of the switch and leave the flag or a hold half written.
    So when this process sits in the host gateway's cgroup it re-executes itself ONCE in a scope
    of its own and the switch runs to its end. Anywhere else (a timer, a terminal, a worker's own
    scope, and every run under the default `units`) it returns False and nothing changes.
    Kill: KREW_MODE_DETACH=0.
    """
    if os.environ.get("KREW_MODE_DETACH", "1").strip().lower() in ("0", "false", "no", "off"):
        return False
    if os.environ.get("KREW_MODE_DETACHED") == "1":
        return False
    topo = _gateway_topology()
    if topo is None:
        return False
    where = own_cgroup_leaf() if leaf is None else leaf
    if where != topo.HOST_UNIT:
        return False
    os.environ["KREW_MODE_DETACHED"] = "1"
    unit = f"krew-mode-switch-{os.getpid()}"
    execvp("systemd-run", ["systemd-run", "--user", "--scope", "--collect", "--quiet", "--unit", unit,
                           sys.executable, str(Path(__file__).resolve()), *argv])
    return True


def main(argv: Optional[Sequence[str]] = None) -> int:
    p = argparse.ArgumentParser(prog="krew-mode")
    p.add_argument("--dry-run", action="store_true")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status")
    r = sub.add_parser("render")
    r.add_argument(
        "recipe",
        nargs="?",
        default="turbo",
        choices=sorted(RECIPES),
    )
    sub.add_parser("normal")
    sub.add_parser("beast")
    sub.add_parser("off")
    sub.add_parser("hold-sweep")   # release holds whose cards are gone; start what they parked
    rc = sub.add_parser("release-card")   # release THIS card's stamped hold; print the freed units
    rc.add_argument("card", help="card id that owns the stamp")
    sub.add_parser("ada-caps")     # are the caps Ada runs the caps on disk? (exit 1 = stale)
    he = sub.add_parser("heavy-enter")   # H2: crew off, spawns paused, Crissa on ops (KREW_HEAVY_RENDER=1)
    he.add_argument("--runner-pid", type=int, required=True)
    he.add_argument("--deadline", type=float, required=True, help="epoch seconds")
    hc = sub.add_parser("heavy-comfy")   # H2: Comfy for the next batch
    hc.add_argument("--highvram", action="store_true")
    sub.add_parser("heavy-exit")         # H2: leave the window; never gated
    # Options after the subcommand (`render turbo --dry-run`) must parse too.
    argv_in = list(sys.argv[1:] if argv is None else argv)
    dry_anywhere = "--dry-run" in argv_in
    argv_in = [a for a in argv_in if a != "--dry-run"]
    args = p.parse_args(argv_in)
    if dry_anywhere:
        args.dry_run = True
    if args.cmd == "status":
        return cmd_status()
    if args.cmd == "release-card":
        return cmd_release_card(args.card)
    if args.cmd == "hold-sweep":
        return cmd_hold_sweep(dry_run=args.dry_run)
    if args.cmd == "ada-caps":
        stale, why = ada_caps_stale()
        print(("STALE: " if stale else "ok: ") + why)
        return 1 if stale else 0
    if args.cmd == "heavy-exit":
        # BEFORE the prod lock, the render hold and the worker gate: crew always comes back
        if args.dry_run:
            return cmd_heavy_exit(dry_run=True)
        leave_the_host_gateway(list(argv_in))
        with occupancy_pending("normal"):
            return cmd_heavy_exit()
    if prod_lock_blocks(args.cmd):
        print(
            f"prod lock — occupancy frozen at {read_mode()} "
            f"({PROD_LOCK_FILE}). Lift: first line off.",
            file=sys.stderr,
        )
        return 3
    if render_hold_blocks(args.cmd):
        print(render_hold_reason(), file=sys.stderr)
        return 3
    if args.cmd in WORKER_GATED_CMDS:
        why = worker_gpu_refusal(args.cmd)
        if why:
            print(why, file=sys.stderr)
            return 3
    if not args.dry_run:
        leave_the_host_gateway(list(argv_in))
    if args.dry_run:
        if args.cmd == "render":
            return cmd_render(args.recipe, dry_run=True)
        if args.cmd == "beast":
            return cmd_beast(dry_run=True)
        if args.cmd == "off":
            return cmd_off(dry_run=True)
        if args.cmd == "normal":
            return cmd_restore(args.cmd, dry_run=True)
        if args.cmd == "heavy-enter":
            return cmd_heavy_enter(args.runner_pid, args.deadline, dry_run=True)
        return 2
    # the in-flight marker names a MODE; the heavy verbs are a switch to heavy-render
    with occupancy_pending("heavy-render" if args.cmd in ("heavy-enter", "heavy-comfy") else args.cmd):
        if args.cmd == "render":
            return cmd_render(args.recipe, dry_run=False)
        if args.cmd == "beast":
            return cmd_beast(dry_run=False)
        if args.cmd == "off":
            return cmd_off(dry_run=False)
        if args.cmd == "normal":
            return cmd_restore(args.cmd, dry_run=False)
        if args.cmd == "heavy-enter":
            return cmd_heavy_enter(args.runner_pid, args.deadline)
        if args.cmd == "heavy-comfy":
            return cmd_heavy_comfy(highvram=args.highvram)
    return 2


if __name__ == "__main__":
    sys.exit(main())

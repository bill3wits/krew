# ONE pause line for every window that must stop new workers: heavy-render and the dual-park
# Render (both 27Bs parked). Removed on the way back to any mode that dispatches.
DISPATCH_PAUSE_MARK = "# krew-mode dispatch pause (heavy-render / dual-park Render; removed on the way back)"


def heavy_enabled() -> bool:
    return os.environ.get("KREW_HEAVY_RENDER", "0").strip().lower() in ("1", "on", "true", "yes")


class DispatchPauseRefused(RuntimeError):
    """The config already carries a dispatch_profiles line that is not ours."""


def set_dispatch_pause(text: str, on: bool) -> tuple[str, bool]:
    """Pause / resume kanban spawns through `kanban.dispatch_profiles: []` in the HOST config.

    hermes reads that key on every spawn decision (kanban_db_dispatch._dispatch_profile_
    allowlist, cached on the file's signature): present-and-empty claims NOTHING, absent is
    upstream behaviour. No restart, running workers untouched, Crissa's turns untouched - the
    lever that does not bounce the host (ESTOP would also stop her turns; caps are read once at
    boot and 0 is ignored). Line-preserving: on inserts one marked line under `kanban:`, off
    removes only marked lines. A dispatch_profiles line that is not ours is refused, never edited."""
    lines = text.splitlines(keepends=True)
    ours = [i for i, l in enumerate(lines) if DISPATCH_PAUSE_MARK in l]
    if not on:
        if not ours:
            return text, False
        return "".join(l for i, l in enumerate(lines) if i not in ours), True
    if ours:
        return text, False
    import re
    for l in lines:
        if re.match(r"^[ \t]+dispatch_profiles\s*:", l):
            raise DispatchPauseRefused("kanban.dispatch_profiles is already set by someone else: " + l.strip())
    for i, l in enumerate(lines):
        if re.match(r"^kanban:[ \t]*(#.*)?\n?$", l):
            lines.insert(i + 1, f"  dispatch_profiles: []  {DISPATCH_PAUSE_MARK}\n")
            return "".join(lines), True
    tail = "" if text.endswith("\n") or not text else "\n"
    return text + tail + f"kanban:\n  dispatch_profiles: []  {DISPATCH_PAUSE_MARK}\n", True


def apply_dispatch_pause(on: bool, path: Optional[Path] = None) -> str:
    """Write set_dispatch_pause to the host config atomically (mode kept)."""
    import tempfile
    cfg = path or (HOUSE / "config.yaml")
    if not cfg.is_file():
        return "missing"
    raw = cfg.read_text(encoding="utf-8")
    new, changed = set_dispatch_pause(raw, on)
    if not changed:
        return ("paused" if on else "running") + " (already)"
    fd, tmp = tempfile.mkstemp(dir=str(cfg.parent), prefix=f".{cfg.name}.")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(new)
    os.chmod(tmp, cfg.stat().st_mode & 0o777)
    os.replace(tmp, cfg)
    print("kanban dispatch " + ("PAUSED (dispatch_profiles: [])" if on else "resumed (pause line removed)"))
    return "paused" if on else "running"


def heavy_markers() -> list[str]:
    """Every trace a heavy-render window leaves; any one of them means heavy-exit has work."""
    out = []
    if read_mode() == "heavy-render":
        out.append("flag")
    if HEAVY_CARD in _hold_cards():
        out.append("crew hold")
    if HEAVY_STATE.is_file():
        out.append("runner state")
    try:
        if DISPATCH_PAUSE_MARK in (HOUSE / "config.yaml").read_text(encoding="utf-8"):
            out.append("dispatch pause")
    except OSError:
        pass
    return out

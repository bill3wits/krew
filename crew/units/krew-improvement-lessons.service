# krew: improvement lessons (run #1 of improvement-outcomes, before team research).
# No timer of its own: the window ticker (krew's off-hours scheduler) starts it as a window job and writes the
# day it serves to krew-day.env. Run it by hand any time.
[Unit]
Description=krew improvement lessons: the cooldown list and last verdicts for tonight's Scout and voters

[Service]
Type=oneshot
TimeoutStartSec=5min
EnvironmentFile=-%h/.krew/krew-day.env
ExecStart=/usr/bin/python3 %h/.krew/crew/scripts/krew-crew-run improvement-outcomes.py --lessons

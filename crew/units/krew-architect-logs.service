# krew: Steward's logs note: archive the inbox, collect logs, then `hermes -p steward cron run steward-logs`.
# No timer of its own: the window ticker (krew's off-hours scheduler) starts it as a window job and writes the
# day it serves to krew-day.env. Run it by hand any time.
[Unit]
Description=krew Steward logs + archive + M&S snapshot

[Service]
Type=oneshot
EnvironmentFile=-%h/.krew/krew-day.env
TimeoutStartSec=30min
Environment=KREW_T0_MODE=enforce
ExecStart=/usr/bin/python3 %h/.krew/crew/scripts/krew-crew-run steward-architect-run.sh logs

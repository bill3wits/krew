# krew: Scout's stack note: 2-3 pieces of the stack against the state of the art (`hermes -p scout cron run architect-stack`).
# No timer of its own: the window ticker (krew's off-hours scheduler) starts it as a window job and writes the
# day it serves to krew-day.env. Run it by hand any time.
[Unit]
Description=krew Scout stack-vs-SOTA note

[Service]
Type=oneshot
EnvironmentFile=-%h/.krew/krew-day.env
TimeoutStartSec=45min
Environment=HERMES_WRITE_SAFE_ROOT=%h/Desktop/krew-deliverables:%h/.krew/memory/ms
Environment=KREW_T0_MODE=enforce
ExecStart=/usr/bin/python3 %h/.krew/crew/scripts/krew-crew-run steward-architect-run.sh stack

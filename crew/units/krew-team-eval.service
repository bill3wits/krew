# krew: team eval: ada, bash, lila, steward and vera each score the research picks for their job (`hermes -p <role> cron run team-eval`), then the ranker aggregates.
# No timer of its own: the window ticker (krew's off-hours scheduler) starts it as a window job and writes the
# day it serves to krew-day.env. Run it by hand any time.
[Unit]
Description=krew team eval: each role scores tonight's research picks; the ranker aggregates

[Service]
Type=oneshot
EnvironmentFile=-%h/.krew/krew-day.env
TimeoutStartSec=5400
ExecStart=/usr/bin/python3 %h/.krew/crew/scripts/krew-crew-run team-eval-run.sh

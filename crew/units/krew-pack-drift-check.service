# krew: nightly pack/live drift check (a commit is not a deploy).
# No timer of its own: the window ticker (krew's off-hours scheduler) starts it as a window job and writes the
# day it serves to krew-day.env. Run it by hand any time.
[Unit]
Description=krew check that the committed packs match what is running

[Service]
Type=oneshot
TimeoutStartSec=10min
EnvironmentFile=-%h/.krew/krew-day.env
ExecStart=/usr/bin/python3 %h/.krew/crew/scripts/krew-crew-run pack-drift-check.sh

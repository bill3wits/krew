# Hindsight settings for krew-hindsight.service: copy to ~/.krew/hindsight/hindsight.env and fill in.
# The keys are the reference install's; its values (database password, model names, hosts) are not shipped.
HINDSIGHT_API_DATABASE_URL=postgresql://hindsight:CHANGE-ME@127.0.0.1:5432/hindsight
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_LOG_LEVEL=info
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-small-en-v1.5
HINDSIGHT_API_EMBEDDINGS_LOCAL_FORCE_CPU=true
HINDSIGHT_API_RERANKER_PROVIDER=local
# One OpenAI-compatible LLM for every step, or set the RETAIN_/REFLECT_/CONSOLIDATION_ variants to split them.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=your-model
HINDSIGHT_API_LLM_BASE_URL=http://127.0.0.1:8000/v1
HINDSIGHT_API_LLM_API_KEY=local
# HINDSIGHT_API_RETAIN_LLM_PROVIDER= / _MODEL= / _BASE_URL= / _API_KEY=
# HINDSIGHT_API_REFLECT_LLM_PROVIDER= / _MODEL= / _BASE_URL= / _API_KEY=
# HINDSIGHT_API_CONSOLIDATION_LLM_PROVIDER= / _MODEL= / _BASE_URL= / _API_KEY=
# HINDSIGHT_API_LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}   (and the per-step _EXTRA_BODY)
# HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=4096
# HINDSIGHT_API_REFLECT_LLM_TIMEOUT=600
# Boot without the LLM up; it degrades at runtime (retain logs 0 facts) instead of crash-looping.
HINDSIGHT_API_SKIP_LLM_VERIFICATION=1
# TIKTOKEN_CACHE_DIR=/home/<you>/.krew/hindsight/tiktoken-cache

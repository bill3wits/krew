+def test_provider_rests_captcha_engine_on_next_query(provider):
+    p, calls, replies = provider
+    replies["search"] = {"results": [{"title": "T", "url": "u", "content": "", "engines": ["bing"]}],
+                         "unresponsive_engines": [["duckduckgo", "CAPTCHA"]]}
+    replies["config"] = {"engines": [{"name": "bing", "enabled": True, "categories": ["general"]},
+                                     {"name": "duckduckgo", "enabled": True, "categories": ["general"]},
+                                     {"name": "flickr", "enabled": True, "categories": ["images"]}]}
+    p.search("first", 5)
+    p.search("second", 5)
+    search_calls = [c for c in calls if c[0].endswith("/search")]
+    assert "engines" not in search_calls[0][1]
+    assert search_calls[1][1]["engines"] == "bing"

--- /dev/null
+++ b/tests/plugins/web/test_searxng_guard.py
@@ -0,0 +1,181 @@
+"""Krew patch 220 (2026-10-06): SearXNG queries go out plain, paced, and push-back engines rest.
+
+Cause it fixes: bursts of operator queries from one home IP - DuckDuckGo/Startpage CAPTCHA, Brave 429,
+Wikipedia 400 on ``site:`` - left SearXNG on Bing alone.
+"""
+from __future__ import annotations
+
+import pytest
+
+from plugins.web.searxng import guard
+from plugins.web.searxng.provider import SearXNGWebSearchProvider
+
+
+@pytest.mark.parametrize("raw, plain", [
+    ("site:github.com hermes agent", "github hermes agent"),
+    ("site:en.wikipedia.org SearXNG", "wikipedia SearXNG"),
+    ("r/LocalLLaMA best local model", "LocalLLaMA reddit best local model"),
+    ('"voice assistant" latency', "voice assistant latency"),
+    ('intitle:"release notes" hermes', "release notes hermes"),
+    ("hermes OR zoey -pinterest -site:pinterest.com filetype:pdf", "hermes zoey"),
+    ("site:reddit.com/r/selfhosted searxng captcha", "reddit selfhosted searxng captcha"),
+    ("plain words stay put", "plain words stay put"),
+    ("Zoey zoey ZOEY voice", "Zoey voice"),
+])
+def test_plain_query_strips_operators(raw, plain):
+    assert guard.plain_query(raw) == plain
+
+
+def test_plain_query_caps_words():
+    assert len(guard.plain_query(" ".join(f"w{i}" for i in range(40))).split()) == guard.MAX_WORDS
+
+
+def test_pushback_counts_live_refusals_not_suspensions():
+    data = {"unresponsive_engines": [["brave", "Suspended: too many requests"], ["duckduckgo", "CAPTCHA"],
+                                     ["startpage", "Suspended: CAPTCHA"], ["qwant", "too many requests"],
+                                     ["wikipedia", "HTTP error"]]}
+    assert guard.pushback_engines(data) == ["duckduckgo", "qwant"]
+    assert guard.suspended_engines(data) == ["brave", "startpage"]
+
+
+class Clock:
+    def __init__(self, t: float = 1000.0):
+        self.t = t
+        self.slept: list[float] = []
+
+    def __call__(self) -> float:
+        return self.t
+
+    def sleep(self, s: float) -> None:
+        self.slept.append(s)
+        self.t += s
+
+
+@pytest.fixture
+def g(tmp_path):
+    c = Clock()
+    return guard.Guard(path=tmp_path / "state.json", clock=c, sleep=c.sleep), c
+
+
+def test_same_plain_query_is_served_from_cache(g):
+    gd, c = g
+    assert gd.before("hermes agent", 5) == ("go", [])
+    gd.after("hermes agent", 5, data={"results": []}, results=[{"title": "a"}])
+    c.t += 30
+    assert gd.before("hermes agent", 5) == ("cached", [{"title": "a"}])
+
+
+def test_outgoing_queries_are_spaced(g):
+    gd, c = g
+    assert gd.before("one", 5)[0] == "go"
+    assert gd.before("two", 5)[0] == "go"
+    assert c.slept and abs(c.slept[0] - guard.MIN_GAP) < 1e-6
+
+
+def test_budget_per_minute_fails_fast(g):
+    gd, c = g
+    for i in range(guard.PER_MIN):
+        assert gd.before(f"q{i}", 5)[0] == "go"
+    verdict, why = gd.before("one more", 5)
+    assert verdict == "wait_fail" and "budget" in why
+    c.t += 61
+    assert gd.before("one more", 5)[0] == "go"
+
+
+def test_engine_that_pushes_back_is_rested_then_returns(g):
+    gd, c = g
+    gd.before("a", 5)
+    gd.after("a", 5, data={"results": [{"engines": ["bing"]}], "unresponsive_engines": [["duckduckgo", "CAPTCHA"]]})
+    c.t += 5
+    assert gd.before("b", 5) == ("go", ["duckduckgo"])
+    c.t += guard.ENGINE_BASE_S + 1
+    assert gd.before("c", 5) == ("go", [])
+    # a second refusal rests it twice as long
+    gd.after("c", 5, data={"results": [], "unresponsive_engines": [["duckduckgo", "CAPTCHA"]]})
+    c.t += guard.ENGINE_BASE_S + 1
+    assert gd.before("d", 5) == ("go", ["duckduckgo"])
+    # answering again clears it
+    gd.after("d", 5, data={"results": [{"engines": ["duckduckgo"]}]})
+    c.t += 2
+    assert gd.before("e", 5) == ("go", [])
+
+
+def test_searxng_429_backs_everything_off(g):
+    gd, c = g
+    gd.before("a", 5)
+    gd.after("a", 5, status=429)
+    c.t += 1
+    verdict, why = gd.before("b", 5)
+    assert verdict == "go" and c.slept  # 5 s cooldown -> 4 s wait fits MAX_WAIT
+    gd.after("b", 5, status=429)          # second strike: 10 s
+    c.t += 1
+    verdict, why = gd.before("c", 5)
+    assert verdict == "wait_fail" and "backing off" in why
+
+
+def test_engines_param_leaves_benched_out():

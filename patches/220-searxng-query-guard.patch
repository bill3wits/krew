@@ -0,0 +1,266 @@
+"""SearXNG query hygiene + pacing (krew patch 220, 2026-10-06).
+
+Why: a self-hosted SearXNG runs from one home IP with its own limiter off. Agents fired bursts of
+operator queries (``site:github.com ...``, ``r/LocalLLaMA ...``, quoted phrases), so DuckDuckGo and
+Startpage answered with CAPTCHAs, Brave with 429s, and Wikipedia with 400s (it rejects ``site:``).
+SearXNG then ran on Bing alone. This module, used by the SearXNG provider before every request:
+
+* ``plain_query`` turns search operators into plain keywords (``site:github.com`` -> ``github``,
+  ``r/LocalLLaMA`` -> ``LocalLLaMA reddit``, quotes / ``OR`` / ``-term`` / ``intitle:`` dropped).
+* a machine-wide guard (one small JSON state file under ``$HERMES_HOME/cache``, flock'd, so the
+  gateway, hands children, cron and kanban workers share it):
+  - the same plain query inside ``CACHE_TTL`` is answered from the cache (no upstream call);
+  - outgoing queries are spaced ``MIN_GAP`` apart and capped at ``PER_MIN`` per rolling minute;
+  - an engine that answers CAPTCHA / too many requests / access denied is left out of the next
+    queries (SearXNG's ``engines=`` parameter) for 2, 4, 8 ... up to 60 minutes, so the upstream sees
+    nothing from this IP while it cools down;
+  - SearXNG itself answering 429/503 backs everything off 5, 10, 20 ... 60 s.
+  Over budget or cooling down, the call fails fast with a plain reason instead of hammering.
+
+Off switch: ``HERMES_SEARXNG_GUARD=0`` (old behaviour: the raw query, no pacing).
+"""
+
+from __future__ import annotations
+
+import contextlib
+import json
+import os
+import re
+import time
+from pathlib import Path
+from typing import Any, Callable, Dict, Iterator, List, Optional, Tuple
+
+MIN_GAP = float(os.environ.get("HERMES_SEARXNG_MIN_GAP", "1.5"))       # seconds between outgoing queries
+PER_MIN = int(os.environ.get("HERMES_SEARXNG_PER_MIN", "8"))           # outgoing queries per rolling minute
+MAX_WAIT = float(os.environ.get("HERMES_SEARXNG_MAX_WAIT", "4"))       # longest we sleep inside one call
+CACHE_TTL = float(os.environ.get("HERMES_SEARXNG_CACHE_TTL", "900"))   # same plain query -> cached answer
+CACHE_MAX = 64
+MAX_WORDS = 12
+ENGINE_BASE_S = 120.0
+ENGINE_MAX_S = 3600.0
+GLOBAL_BASE_S = 5.0
+GLOBAL_MAX_S = 60.0
+ENGINES_TTL = 3600.0
+
+PUSHBACK = re.compile(r"captcha|too many requests|access denied|forbidden|429|403|rate", re.I)
+
+_OPERATOR_KEYS = ("site", "inurl", "intitle", "allintitle", "allinurl", "intext", "allintext", "filetype",
+                  "ext", "related", "cache", "info", "link", "before", "after", "lang", "loc", "location")
+_TLD_NOISE = {"www", "com", "org", "net", "io", "dev", "co", "uk", "ai", "app", "edu", "gov", "en", "m"}
+
+
+def enabled() -> bool:
+    return os.environ.get("HERMES_SEARXNG_GUARD", "1").strip().lower() not in ("0", "false", "no", "off")
+
+
+def _site_word(value: str) -> str:
+    """``github.com`` -> ``github``; ``en.wikipedia.org/wiki`` -> ``wikipedia``; ``reddit.com/r/x`` -> ``reddit x``."""
+    v = re.sub(r"^https?://", "", value.strip().strip("\"'").lower())
+    host, _, path = v.partition("/")
+    labels = [x for x in host.split(".") if x and x not in _TLD_NOISE and x != "*"]
+    words = labels[-1:] if labels else []
+    m = re.match(r"r/([A-Za-z0-9_]+)", path)
+    if m:
+        words.append(m.group(1))
+    return " ".join(words)
+
+
+def plain_query(query: str) -> str:
+    """Search operators -> plain keywords, deduped, at most ``MAX_WORDS`` words."""
+    q = str(query or "")
+    out: List[str] = []
+
+    def keep(text: str) -> None:
+        for w in re.split(r"\s+", text):
+            w = w.strip("\"'()[]{}*+,;")
+            if w:
+                out.append(w)
+
+    for tok in re.findall(r'-?\w+:"[^"]*"|-?"[^"]*"|\S+', q):
+        neg = tok.startswith("-")
+        body = tok[1:] if neg else tok
+        key, sep, val = body.partition(":")
+        if sep and key.lower() in _OPERATOR_KEYS:
+            if neg:
+                continue                                   # -site:pinterest.com: an exclusion, drop it
+            if key.lower() == "site":
+                keep(_site_word(val))
+            elif key.lower() in ("intitle", "allintitle", "intext", "allintext", "inurl", "allinurl"):
+                keep(val.replace("_", " ").replace("-", " "))
+            continue                                       # filetype:/before:/lang:... carry no keyword
+        if neg and len(body) > 0:
+            continue                                       # -term exclusion
+        m = re.fullmatch(r"/?r/([A-Za-z0-9_]+)/?", body)
+        if m:
+            keep(m.group(1) + " reddit")
+            continue
+        if body.upper() in ("OR", "AND", "NOT", "|", "&&", "||"):
+            continue
+        keep(body)
+    seen, words = set(), []
+    for w in out:
+        k = w.lower()
+        if k in seen:
+            continue
+        seen.add(k)
+        words.append(w)
+    return " ".join(words[:MAX_WORDS])
+
+
+def pushback_engines(data: Dict[str, Any]) -> List[str]:
+    """Engines that pushed back THIS request (not the ones SearXNG already has suspended)."""
+    names = []
+    for row in data.get("unresponsive_engines") or []:
+        try:
+            name, reason = str(row[0]), str(row[1])
+        except (IndexError, TypeError):
+            continue
+        if reason.lower().startswith("suspended"):
+            continue
+        if PUSHBACK.search(reason):
+            names.append(name)
+    return names
+
+
+def suspended_engines(data: Dict[str, Any]) -> List[str]:
+    out = []
+    for row in data.get("unresponsive_engines") or []:
+        try:
+            if str(row[1]).lower().startswith("suspended"):
+                out.append(str(row[0]))
+        except (IndexError, TypeError):
+            continue
+    return out
+
+
+def _state_path() -> Path:
+    """One file for the whole install (the hermes ROOT, not a profile home): every profile shares the IP."""
+    override = os.environ.get("HERMES_SEARXNG_GUARD_STATE", "").strip()
+    if override:
+        return Path(override)
+    try:
+        from hermes_constants import get_default_hermes_root
+        root = Path(get_default_hermes_root())
+    except Exception:  # noqa: BLE001
+        root = Path.home() / ".hermes"
+    return root / "cache" / "searxng-guard.json"
+
+
+@contextlib.contextmanager
+def _locked_state(path: Optional[Path] = None) -> Iterator[Dict[str, Any]]:
+    """Read-modify-write of the shared state under an exclusive flock (best effort off POSIX)."""
+    path = path or _state_path()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(str(path) + ".lock", "a+") as lock:
+        try:
+            import fcntl
+            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
+        except Exception:  # noqa: BLE001
+            pass
+        try:
+            state = json.loads(path.read_text(encoding="utf-8"))
+            if not isinstance(state, dict):
+                state = {}
+        except Exception:  # noqa: BLE001
+            state = {}
+        yield state
+        tmp = path.with_suffix(".tmp")
+        tmp.write_text(json.dumps(state, ensure_ascii=False), encoding="utf-8")
+        os.replace(tmp, path)
+
+
+def _prune(state: Dict[str, Any], now: float) -> None:
+    state["sent"] = [t for t in state.get("sent", []) if now - t < 60.0]
+    cache = {k: v for k, v in (state.get("cache") or {}).items() if now - float(v.get("ts", 0)) < CACHE_TTL}
+    if len(cache) > CACHE_MAX:
+        cache = dict(sorted(cache.items(), key=lambda kv: kv[1].get("ts", 0))[-CACHE_MAX:])
+    state["cache"] = cache
+    state["engines"] = {k: v for k, v in (state.get("engines") or {}).items()
+                        if float(v.get("until", 0)) > now or int(v.get("strikes", 0)) > 0}
+
+
+class Guard:
+    """Plans one SearXNG request and records its outcome. ``clock`` / ``sleep`` are injectable for tests."""
+
+    def __init__(self, path: Optional[Path] = None, clock: Callable[[], float] = time.time,
+                 sleep: Callable[[float], None] = time.sleep):
+        self.path = path
+        self.clock = clock
+        self.sleep = sleep
+
+    def before(self, plain: str, limit: int) -> Tuple[str, Any]:
+        """('cached', results) | ('wait_fail', reason) | ('go', [engines to leave out])."""
+        key = plain.lower()
+        waited = 0.0
+        while True:
+            now = self.clock()
+            with _locked_state(self.path) as st:
+                _prune(st, now)
+                hit = st["cache"].get(key)
+                if hit and hit.get("results"):
+                    return "cached", hit["results"][:limit]
+                cool = float(st.get("cooldown_until", 0)) - now
+                if cool > 0 and cool > MAX_WAIT - waited:
+                    return "wait_fail", (f"SearXNG is backing off after its upstream engines rate-limited this "
+                                         f"IP; try again in about {int(cool) + 1} s, or use what you already have.")
+                if len(st["sent"]) >= PER_MIN:
+                    oldest = min(st["sent"])
+                    return "wait_fail", (f"Web-search budget ({PER_MIN} queries a minute) is used up; "
+                                         f"try again in about {int(60 - (now - oldest)) + 1} s, or work with the "
+                                         f"results you already have.")
+                gap = max(cool, float(st.get("last", 0)) + MIN_GAP - now)
+                if gap <= 0:
+                    st["last"] = now
+                    st["sent"].append(now)
+                    benched = sorted(k for k, v in st["engines"].items() if float(v.get("until", 0)) > now)
+                    return "go", benched
+            if gap > MAX_WAIT - waited:
+                return "wait_fail", f"Web search is pacing itself; try again in about {int(gap) + 1} s."
+            self.sleep(gap)
+            waited += gap
+
+    def after(self, plain: str, limit: int, *, data: Optional[Dict[str, Any]] = None,
+              status: Optional[int] = None, results: Optional[List[Dict[str, Any]]] = None) -> None:
+        now = self.clock()
+        with _locked_state(self.path) as st:
+            _prune(st, now)
+            if status in (429, 503):
+                strikes = int(st.get("global_strikes", 0)) + 1
+                st["global_strikes"] = strikes
+                st["cooldown_until"] = now + min(GLOBAL_MAX_S, GLOBAL_BASE_S * 2 ** (strikes - 1))
+                return
+            if data is None:
+                return
+            st["global_strikes"] = 0
+            answered = {e for r in data.get("results") or [] for e in (r.get("engines") or [])}
+            for name in pushback_engines(data):
+                rec = st["engines"].get(name) or {}
+                strikes = int(rec.get("strikes", 0)) + 1
+                st["engines"][name] = {"strikes": strikes,
+                                       "until": now + min(ENGINE_MAX_S, ENGINE_BASE_S * 2 ** (strikes - 1))}
+            for name in answered:
+                if name in st["engines"]:
+                    st["engines"][name] = {"strikes": 0, "until": 0}
+            if results:
+                st["cache"][plain.lower()] = {"ts": now, "limit": limit, "results": results}
+
+    # --- engine list for ``engines=`` ---------------------------------------------------------------
+    def general_engines(self, fetch: Callable[[], Optional[List[str]]]) -> Optional[List[str]]:
+        now = self.clock()
+        with _locked_state(self.path) as st:
+            rec = st.get("general_engines") or {}
+            if rec.get("names") and now - float(rec.get("ts", 0)) < ENGINES_TTL:
+                return list(rec["names"])
+        names = fetch()
+        if names:
+            with _locked_state(self.path) as st:
+                st["general_engines"] = {"ts": now, "names": names}
+        return names
+
+
+def engines_param(general: Optional[List[str]], benched: List[str]) -> Optional[str]:
+    """SearXNG ``engines=`` value leaving the benched engines out, or None (use SearXNG's defaults)."""
+    if not benched or not general:
+        return None
+    keep = [e for e in general if e not in set(benched)]
+    return ",".join(keep) if keep else None

+def test_provider_sends_plain_query_and_caches(provider):
+    p, calls, replies = provider
+    replies["search"] = {"results": [{"title": "T", "url": "https://x", "content": "c", "engines": ["bing"]}]}
+    out = p.search("site:github.com hermes agent", 5)
+    assert out["success"] and out["data"]["web"][0]["url"] == "https://x"
+    assert calls[0][1]["q"] == "github hermes agent"
+    assert p.search("site:github.com  hermes   agent", 5)["data"]["web"][0]["url"] == "https://x"
+    assert len(calls) == 1  # second ask came from the cache
+

+  // Krew patch 170 (2026-09-30): which board the switcher lands on after the board list
+  // loads. A stored board that is no longer listed (archived in the CLI) falls back to the server's
+  // CURRENT board - the one the server works on - instead of the "default" slug, which may be
+  // a board nobody works on. Returns {slug, persist} or null (keep what is shown).
+  function pickBoard(boards, board, storedBoard, current) {
+    const listed = function (slug) { return !!(boards || []).find(function (b) { return b.slug === slug; }); };
+    if (!storedBoard && !board && current) return { slug: current, persist: false };
+    if (board && board !== "default" && !listed(board)) {
+      return { slug: current && listed(current) ? current : "default", persist: true };
+    }
+    return null;
+  }
+
   function withBoard(url, board) {
     // Always append ?board=<slug> when we have one picked — including
     // "default". Omitting the param would fall through to the backend's
@@ -709,16 +722,14 @@

# why: The kanban dashboard falls back to the server's CURRENT board when the board a browser picked is no longer listed (archived), instead of the 'default' slug.
# tests: 
# upstream: candidate
# base: hermes-agent 35272ce28b29 (v0.21.4+canary.20260928T071354Z-19-g35272ce28b)

diff --git a/plugins/kanban/dashboard/dist/index.js b/plugins/kanban/dashboard/dist/index.js
index 658ae11c5b..b270b51096 100644
--- a/plugins/kanban/dashboard/dist/index.js
+++ b/plugins/kanban/dashboard/dist/index.js

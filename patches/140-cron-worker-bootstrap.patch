+++ b/cron/__init__.py
@@ -3,6 +3,16 @@ self-scheduled reminders, isolated sessions. The gateway daemon (``hermes gatewa
 the scheduler every 60 seconds; a file lock prevents duplicate execution across processes.
 """
 
+# The restart-safe external worker is launched as ``sys.executable -m cron.scheduler``: Python imports
+# this package ``__init__`` BEFORE ``cron/scheduler.py`` reaches its own ``import hermes_bootstrap``, and
+# the launcher's interpreter only gains Hermes's dependencies from that bootstrap. Without it the child
+# dies on ``ModuleNotFoundError: No module named 'ruamel'`` before it can acknowledge ownership, and every
+# gateway-managed cron job fails at dispatch. Idempotent in a process that already bootstrapped.
+try:
+    import hermes_bootstrap  # noqa: F401
+except ImportError:  # pragma: no cover - the package is importable without the repo root only in odd embeddings
+    pass
+

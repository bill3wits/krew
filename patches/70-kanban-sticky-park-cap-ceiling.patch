+def _resolve_decompose_wip_ceiling(load_config: Callable[[], Any]) -> Optional[int]:
+    """``kanban.decompose_wip_ceiling``: cards in flight on a board at or above which the
+    auto-decomposer stops minting children (krew patch 70, 2026-09-16). Unset / 0 / invalid
+    means no ceiling. Re-read every tick, like the toggle below.
+
+    Why: with three worker slots (~15 completions/h) one board carried 315 open cards and 218 of
+    a day's 479 new cards came from the decomposer. It resumes by itself once completions bring
+    the count back under the line.
+    """
+    try:
+        cfg = load_config()
+    except Exception:
+        return None
+    kcfg = cfg.get("kanban", {}) if isinstance(cfg, dict) else {}
+    try:
+        ceiling = int(kcfg.get("decompose_wip_ceiling", 0) or 0)
+    except (TypeError, ValueError):
+        return None
+    return ceiling if ceiling > 0 else None
+
+
+# Work IN FLIGHT: never the parks (blocked / scheduled), which do not compete for a slot.
+_OPEN_STATUSES = ("todo", "ready", "running", "review", "triage")
+
+
+def _count_open_cards(conn) -> int:
+    marks = ",".join("?" for _ in _OPEN_STATUSES)
+    row = conn.execute(f"SELECT COUNT(*) FROM tasks WHERE status IN ({marks})", _OPEN_STATUSES).fetchone()
+    return int(row[0] if row else 0)
+
+

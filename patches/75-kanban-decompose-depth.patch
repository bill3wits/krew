+# Krew patch 75 (2026-09-28): the decomposer splits ONE level.
+# A triage card born of the machinery itself is promoted whole (the single-task path's own write,
+# no LLM call), never split again: 09-26/27 the decomposer re-split its own children (56 and 84 a
+# day) and kanban-loop reframes fed it back, giving chains six deep. Every caller goes through
+# here: the gateway's auto-decompose tick, kanban-loop's pass, a hand's `kanban decompose`.
+# Kill KREW_DECOMPOSE_DEPTH=0.
+NO_FANOUT_CREATORS = frozenset({"auto-decomposer", "decomposer", "kanban-board-gate", "ms-trail"})
+
+
+def decompose_depth_blocks(created_by: Optional[str], title: Optional[str], body: Optional[str]) -> str:
+    """Why this triage card must not be split (it is promoted whole instead), or ''."""
+    if os.environ.get("KREW_DECOMPOSE_DEPTH", "1").strip().lower() in ("0", "off", "false", "no"):
+        return ""
+    by = str(created_by or "").strip().lower()
+    if by in NO_FANOUT_CREATORS:
+        return f"created by {by}"
+    if by == "kanban-loop" and str(title or "").strip().lower().startswith("reframe:"):
+        return "a kanban-loop reframe"
+    if "not for decomposition" in str(body or "").lower():
+        return "marked Not for decomposition"
+    return ""
+
+
+def promote_whole(task: kb.Task, why: str, author: str) -> DecomposeOutcome:
+    """Move a triage card to todo as it is (``specify_triage_task``), no LLM call."""
+    with kbc.connect_closing() as conn:
+        ok = kb.specify_triage_task(conn, task.id, author=author)
+    if not ok:
+        return DecomposeOutcome(task.id, False, "task moved out of triage before promotion")
+    return DecomposeOutcome(task.id, True, f"promoted whole, not split ({why})", fanout=False)
+

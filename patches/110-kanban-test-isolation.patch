diff --git a/tests/hermes_cli/test_kanban_sqlite_guard.py b/tests/hermes_cli/test_kanban_sqlite_guard.py
new file mode 100644
index 0000000000..23e974cc66
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_sqlite_guard.py
@@ -0,0 +1,56 @@
+"""The kanban write guard holds across a ``hermes_cli`` module purge.
+
+``test_kanban_per_profile_cap`` purges ``hermes_cli`` from ``sys.modules`` and
+re-imports it; the connect-level guard in conftest patches the module that was
+imported when the fixture ran, so the fresh module escaped it and fixture tasks
+landed in a live board. ``_kanban_sqlite_guard`` guards ``sqlite3.connect``
+itself. Nothing here opens a real board: the guard raises before sqlite runs.
+"""
+from __future__ import annotations
+
+import sqlite3
+import sys
+from pathlib import Path
+
+import pytest
+
+
+def _real_root() -> Path:
+    for mod in list(sys.modules.values()):
+        root = getattr(mod, "_REAL_KANBAN_ROOT", None)
+        if isinstance(root, Path) and hasattr(mod, "_kanban_sqlite_guard"):
+            return root
+    pytest.skip("conftest guard not loaded")
+
+
+def test_a_connection_under_the_real_kanban_root_is_refused():
+    root = _real_root()
+    for target in (root / "kanban" / "boards" / "some-board" / "kanban.db", root / "kanban.db"):
+        with pytest.raises(RuntimeError, match="kanban_sqlite_guard"):
+            sqlite3.connect(str(target))
+        with pytest.raises(RuntimeError, match="kanban_sqlite_guard"):
+            sqlite3.connect(target.as_uri() + "?mode=ro", uri=True)
+
+
+def test_temp_and_memory_databases_are_untouched(tmp_path):
+    sqlite3.connect(":memory:").close()
+    sqlite3.connect(str(tmp_path / "kanban.db")).close()
+    sqlite3.connect("file::memory:?cache=shared", uri=True).close()
+    sqlite3.connect(tmp_path / "other.db").close()
+
+
+def test_the_guard_survives_a_hermes_cli_purge(monkeypatch, tmp_path):
+    root = _real_root()
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    for mod in list(sys.modules):
+        if mod.startswith("hermes_cli") or mod.startswith("hermes_state") or mod == "hermes_constants":
+            monkeypatch.delitem(sys.modules, mod)
+    from hermes_cli import kanban_db_connect as fresh
+
+    # The re-imported module reaches sqlite through the same (guarded) sqlite3 module.
+    assert fresh.sqlite3.connect is sqlite3.connect
+    with pytest.raises(RuntimeError, match="kanban_sqlite_guard"):
+        fresh.sqlite3.connect(str(root / "kanban.db"))
+    # Its own connect() is refused too (by whichever guard fires first).
+    with pytest.raises((RuntimeError, AssertionError)):
+        fresh.connect(root / "kanban.db")

diff --git a/tests/conftest.py b/tests/conftest.py
index 3006008d8e..681ba52411 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -670,6 +670,63 @@ def _kanban_write_guard(_hermetic_environment, monkeypatch):
     monkeypatch.setattr(_kdbc, "connect", _guarded_connect)
 
 
+# ── Kanban write guard, below the module layer ──────────────────────────────
+# The guard above patches ``kanban_db_connect.connect`` on the module that is
+# imported when the fixture runs. A test that purges ``hermes_cli`` from
+# ``sys.modules`` and re-imports it (``test_kanban_per_profile_cap`` does, to
+# pick up a new HERMES_HOME) gets a fresh, UNGUARDED ``connect`` — observed
+# writing fixture tasks into a live board and dispatching real ones with the
+# fake spawn pid. ``sqlite3`` itself is never purged and every kanban opener
+# reads ``sqlite3.connect`` at call time, so guarding it holds across a purge.
+# Scope: paths under ``<real root>/kanban`` and ``<real root>/kanban.db`` only.
+_REAL_KANBAN_PATHS = tuple(
+    Path(os.path.normpath(str(p)))
+    for base in {_REAL_KANBAN_ROOT, Path(os.path.normpath(os.path.abspath(os.path.expanduser(str(_REAL_KANBAN_ROOT)))))}
+    for p in (base / "kanban", base / "kanban.db")
+)
+
+
+def _sqlite_target(database) -> Path | None:
+    """The filesystem path a ``sqlite3.connect`` argument names, else None."""
+    if isinstance(database, bytes):
+        database = database.decode(errors="replace")
+    database = os.fspath(database) if not isinstance(database, str) else database
+    if not database or database == ":memory:":
+        return None
+    if database.startswith("file:"):
+        from urllib.parse import unquote, urlsplit
+
+        parts = urlsplit(database)
+        raw = unquote(parts.path or parts.netloc)
+        if not raw or raw == ":memory:" or "mode=memory" in (parts.query or ""):
+            return None
+        database = raw
+    # Pure string normalisation: no filesystem call, so tests/home_io_guard.py (which
+    # counts even a resolve() under the real home as I/O) never sees the check itself.
+    return Path(os.path.normpath(os.path.abspath(os.path.expanduser(database))))
+
+
+@pytest.fixture(autouse=True)
+def _kanban_sqlite_guard(monkeypatch):
+    """Refuse any sqlite3 connection to the REAL kanban root, purge or not."""
+    _orig = sqlite3.connect
+
+    def _guarded(database, *args, **kwargs):
+        target = _sqlite_target(database)
+        if target is not None:
+            for real in _REAL_KANBAN_PATHS:
+                if target == real or real in target.parents:
+                    raise RuntimeError(
+                        f"kanban_sqlite_guard: a test opened {target}, which is "
+                        f"under the REAL kanban root ({_REAL_KANBAN_ROOT}). "
+                        f"Hermetic isolation has been bypassed (a module purge "
+                        f"escapes the connect-level guard) — refusing."
+                    )
+        return _orig(database, *args, **kwargs)
+
+    monkeypatch.setattr(sqlite3, "connect", _guarded)
+
+
